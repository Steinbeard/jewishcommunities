									visible = "[Or( And( EqualTo_string( GetVariableSystem.Get( 'kehillah_lib_selected_work' ), 'corpus_bavli' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_corpus_', Scope.GetFlagName ) ), '(CFixedPoint)1' ) ), And( EqualTo_string( GetVariableSystem.Get( 'kehillah_lib_selected_work' ), 'corpus_yerushalmi' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_corpus_', Scope.GetFlagName ) ), '(CFixedPoint)2' ) ) )]"
