# =====================================================================
# THE COMMUNITY LIBRARY PANEL -- what books a Kehillah's Beit Midrash
# holds, shown alongside the vanilla domicile window. ADDED 2026-09-15
# at user request ("add a way to view the books a community has in its
# domicile view"). Design and live-pass record: docs/spec/v13-domicile-
# library-panel.md. Registered in gui/scripted_widgets/kehillah_
# scripted_widgets.txt, the same additive hook as the map view.
#
# WHY A COMPANION PANEL AND NOT A TAB: the domicile window is vanilla's
# gui/window_domicile.gui, and this mod does not fork vanilla .gui files
# (docs/spec/gui-spike-community-list.md). So this is a fourth top-level
# scripted widget that simply appears whenever the domicile view is open
# on a Kehillah's quarter, parked directly under the domicile window
# (which is 1390 x 694, centred -- window_domicile.gui:9-10), and goes
# away with it. Same layer as that window ("middle", gui/shared/
# windows.gui) so the two draw together, above the HUD.
#
# WHICH DOMICILE: DomicileWindow.GetDomicile -- the window's own global
# accessor, the same one window_domicile.gui itself reads, and usable
# from any file (window_artifact_reforge.gui reads CharacterWindow.
# GetCharacter the same way). So this follows whatever quarter is being
# looked at: your own, or another community's opened from the roster's
# quarter button -- which is the point: "does the community I would
# travel to hold the work I lack" is answerable before setting out.
#
# WHAT IT READS: kehillah_lib_<work>_value on the community's title
# (held or not) and kehillah_read_<work>_value on the PLAYER (studied
# or not) -- common/script_values/kehillah_library_values.txt. Twelve
# fixed rows, not a datamodel: the corpus is a fixed list of twelve
# real works (kehillah_scripted_triggers.txt's header), and a
# variable_list of flags has no GUI-side item type worth iterating.
#
# STRUCTURE: a vbox inside a window, hboxes and vboxes nested freely --
# never a vbox/hbox as a direct child of a (flow)container (live passes
# 3 and 8 both crashed on exactly that).
# =====================================================================

@lib_col_width = 280
@lib_name_width = 230

window = {
	name = "kehillah_domicile_library"
	parentanchor = center
	widgetanchor = top|hcenter

	# Just under the domicile window's bottom edge (694 / 2 = 347).
	# Draggable from here.
	position = { 0 354 }
	size = { 900 220 }

	movable = yes
	resizable = no
	layer = middle
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	datacontext = "[DomicileWindow.GetDomicile.GetOwner]"
	datacontext = "[DomicileWindow.GetDomicile.GetOwner.GetPrimaryTitle]"

	visible = "[And( And( IsInGame, IsGameViewOpen( 'domicile' ) ), Character.GetGovernment.IsType( 'kehillah_government' ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	background = {
		using = Background_Area_Dark
		color = { 0.11 0.10 0.09 0.94 }
		margin = { 6 6 }
	}

	vbox = {
		margin = { 14 10 }
		spacing = 4

		### Header -- the community's name. The window-control close
		### button is hidden: this panel lives and dies with the domicile
		### view, it has no life of its own to close.
		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_LIB_HEADER"
			}
			blockoverride "button_close"
			{
				visible = no
			}
		}

		text_single = {
			parentanchor = hcenter
			text = "KEHILLAH_LIB_SUBHEADER"
			default_format = "#weak;italic"
		}

		### Three tracks, side by side.
		hbox = {
			layoutpolicy_horizontal = expanding
			margin_top = 4

