					visible = "[Not( GetVariableSystem.Exists( 'kehillah_lib_acquire_mode' ) )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = @lib_width
					text = "[Select_CString( GetScriptedGui( Concatenate( 'kehillah_lib_studied_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'KEHILLAH_LIB_TT_STUDIED' ), Localize( 'KEHILLAH_LIB_TT_UNSTUDIED' ) )]"
				}
				divider_light = { layoutpolicy_horizontal = expanding }
				text_single = { text = "KEHILLAH_LIB_ACTIONS_HEADING" default_format = "#high" }
				button_standard_list = {
					visible = "[And( Character.IsLocalPlayer, GetVariableSystem.Exists( 'kehillah_lib_acquire_mode' ) )]"
					size = { 482 38 }
					enabled = "[GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear( 'kehillah_lib_selected_work' )]"
					onclick = "[GetVariableSystem.Clear( 'kehillah_lib_acquire_mode' )]"
					text = "KEHILLAH_LIB_COMMISSION_ACTION"
					tooltip = "KEHILLAH_LIB_COMMISSION_TT"
					using = tooltip_se
					icon = {
						parentanchor = left|vcenter
						position = { 11 0 }
						size = { 26 26 }
						texture = "gfx/interface/icons/artifact/artifact_chronicle.dds"
						alwaystransparent = yes
					}
				}
				button_standard_list = {
					# 2026-11-08: the shelf's own library goes along as scope:library, and the
					# button shows on any library the player may study from, not only his own.
					visible = "[And( Not( GetVariableSystem.Exists( 'kehillah_lib_acquire_mode' ) ), Or( Character.IsLocalPlayer, GetScriptedGui( Concatenate( 'kehillah_lib_study_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'library', Title.MakeScope ).End ) ) )]"
					size = { 482 38 }
					enabled = "[GetScriptedGui( Concatenate( 'kehillah_lib_study_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'library', Title.MakeScope ).End )]"
					onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_study_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'library', Title.MakeScope ).End )]"
					text = "KEHILLAH_LIB_STUDY_ACTION"
					tooltip = "KEHILLAH_LIB_STUDY_TT"
					using = tooltip_se
					icon = {
						parentanchor = left|vcenter
						position = { 11 0 }
						size = { 26 26 }
						texture = "gfx/interface/icons/scheme_types/icon_scheme_study_scriptures.dds"
						alwaystransparent = yes
					}
				}
				hbox = {
					visible = "[Not( GetVariableSystem.Exists( 'kehillah_lib_acquire_mode' ) )]"
					layoutpolicy_horizontal = expanding
					spacing = 8
					button_standard_list = {
						visible = "[Character.IsLocalPlayer]"
						size = { 237 30 }
						enabled = "[GetScriptedGui( Concatenate( 'kehillah_lib_donate_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_donate_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						text = "KEHILLAH_LIB_DONATE_ACTION"
						tooltip = "KEHILLAH_LIB_DONATE_TT"
						using = tooltip_se
						icon = {
							parentanchor = left|vcenter
							position = { 5 0 }
							size = { 20 20 }
							texture = "gfx/interface/icons/character_interactions/gift_claim_interaction.dds"
							alwaystransparent = yes
						}
					}
					button_standard_list = {
						size = { 237 30 }
						text = "KEHILLAH_LIB_READERS_ACTION"
						tooltip = "KEHILLAH_LIB_READERS_TT"
						using = tooltip_se
						onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_readers_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						icon = {
							parentanchor = left|vcenter
							position = { 5 0 }
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/three_people.dds"
							alwaystransparent = yes
						}
					}
				}
				# V49: the other communities whose libraries hold this work, loaded
				# when the work was selected. Each row plans a Yeshiva Visit there.
				vbox = {
					visible = "[GetScriptedGui( Concatenate( 'kehillah_lib_holders_loaded_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					layoutpolicy_horizontal = expanding
					spacing = 3
					ignoreinvisible = yes
					text_single = {
						text = "KEHILLAH_LIB_HOLDERS_LABEL"
						default_format = "#high"
					}
					text_multi = {
						visible = "[Not( DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_lib_holders' ) ) )]"
						autoresize = yes
						max_width = @lib_width
						default_format = "#weak;italic"
						text = "KEHILLAH_LIB_HOLDERS_EMPTY"
					}
					scrollbox = {
						visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_lib_holders' ) )]"
						layoutpolicy_horizontal = expanding
						size = { @lib_width 170 }
						blockoverride "scrollbox_margins" { margin = { 0 2 } margin_right = 12 }
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2
								datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_lib_holders' )]"
								item = {
									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6
										portrait_head_small = { datacontext = "[Scope.Title.GetHolder]" }
										text_single = {
											text = "[Scope.Title.GetNameNoTooltip]"
											default_format = "#high"
											max_width = 220
										}
										expand = {}
										button_standard_list = {
											visible = "[Character.IsLocalPlayer]"
											size = { 150 30 }
											text = "KEHILLAH_LIB_JOURNEY_ACTION"
											tooltip = "KEHILLAH_LIB_JOURNEY_TT"
											using = tooltip_se
											enabled = "[GetScriptedGui( Concatenate( 'kehillah_lib_journey_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Scope.Title.MakeScope ).End )]"
											onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_journey_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Scope.Title.MakeScope ).End )]"
										}
									}
								}
							}
						}
					}
				}
				vbox = {
					visible = "[And( Not( GetVariableSystem.Exists( 'kehillah_lib_acquire_mode' ) ), GetScriptedGui( Concatenate( 'kehillah_lib_readers_loaded_', GetVariableSystem.Get( 'kehillah_lib_selected_work' ) ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					layoutpolicy_horizontal = expanding
					text_single = {
						text = "KEHILLAH_LIB_READERS_LABEL"
						default_format = "#high"
					}
					text_multi = {
						visible = "[Not( DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_lib_readers' ) ) )]"
						autoresize = yes
						max_width = @lib_width
						text = "KEHILLAH_LIB_READERS_EMPTY"
					}
					scrollbox = {
						visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_lib_readers' ) )]"
						layoutpolicy_horizontal = expanding
						size = { @lib_width 120 }
						blockoverride "scrollbox_content"
						{
							fixedgridbox = {
								datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_lib_readers' )]"
								addcolumn = 68
								addrow = 78
								flipdirection = yes
								datamodel_wrap = 7
								item = {
									portrait_head_small = { datacontext = "[Scope.Char]" }
								}
							}
						}
					}
				}
			}
		}

		### Absorbs spare height so the tab row stays pinned under the header
		### on both pages (the Yeshiva page had its own spacer; Books did not).
		expand = {}
	}
}
