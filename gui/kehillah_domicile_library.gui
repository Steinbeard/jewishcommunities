# =====================================================================
# THE COMMUNITY LIBRARY PANEL -- what books a Kehillah's Beit Midrash
# holds, shown alongside the vanilla domicile window. ADDED 2026-09-15
# at user request; REBUILT the same day as a DYNAMIC list ("I want
# dozens of books to be possible... additive instead of showing missing
# books too... subject in-line... a description for each book on
# hover"). Design and live-pass record: docs/spec/v13-domicile-library-
# panel.md. Registered in gui/scripted_widgets/kehillah_scripted_
# widgets.txt, the same additive hook as the map view.
#
# WHY A COMPANION PANEL AND NOT A TAB: the domicile window is vanilla's
# gui/window_domicile.gui, and this mod does not fork vanilla .gui files
# (docs/spec/gui-spike-community-list.md). So this is a fourth top-level
# scripted widget that appears whenever the domicile view is open,
# parked directly under the domicile window (1390 x 694, centred --
# window_domicile.gui:9-10), and goes away with it.
#
# WHICH DOMICILE: DomicileWindow.GetDomicile -- the accessor window_
# domicile.gui:2 itself reads. Whether it resolves from OUTSIDE that
# file is the one thing live pass 1 (2026-09-15, panel never appeared,
# no load error) could not settle, so this build is deliberately
# bisectable: the WINDOW shows on IsGameViewOpen alone, and what it
# shows inside tells you which link failed --
#   * nothing at all         -> IsGameViewOpen / layer / position;
#   * the "no library" line
#     with an EMPTY name     -> DomicileWindow.GetDomicile is null here;
#   * the "no library" line
#     with a name, on a
#     Kehillah quarter       -> the government IsType check;
#   * the list               -> everything works.
#
# THE LIST IS DYNAMIC. datamodel = the title's kehillah_library_works
# variable_list (Title.MakeScope.GetList -- the same call the map view
# uses for its roster mirror); each item is a Scope holding a flag, and
# Scope.GetFlagName gives the flag's name as a string (vanilla: chariot_
# race_widget_types.gui:105, Var('wager_team').GetFlagName). Every text
# and tooltip on the row is then Localize( Concatenate( 'prefix_',
# Scope.GetFlagName ) ) (vanilla: Localize( Concatenate(
# 'COA_DESIGNER_CATEGORY_', CString.GetString ) )). So ADDING A BOOK IS
# ZERO GUI WORK: one flag in script plus three loc lines --
#   kehillah_lib_name_<flag>, kehillah_lib_subject_<flag>,
#   kehillah_lib_tt_<flag>
# -- see localization/english/kehillah_library_panel_l_english.yml.
# Only what is HELD is listed (additive); nothing is said about works
# the community lacks.
#
# STUDIED BY YOU: a second, smaller dynamic list of the PLAYER's own
# kehillah_studied_works, as a line under the roster. GUI has no
# "is this item in that other list" call, so the two lists sit side by
# side rather than one being marked against the other.
#
# STRUCTURE: vbox inside window, hboxes and vboxes nested freely, text
# items inside the one flowcontainer -- never a vbox/hbox as a direct
# child of a (flow)container (live passes 3 and 8 both crashed on it).
# =====================================================================

@lib_width = 720
@lib_name_width = 330

window = {
	name = "kehillah_domicile_library"
	parentanchor = center
	widgetanchor = top|hcenter

	# Just under the domicile window's bottom edge (694 / 2 = 347).
	# Draggable from here.
	position = { 0 354 }
	size = { 760 200 }

	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	datacontext = "[DomicileWindow.GetDomicile.GetOwner]"
	datacontext = "[DomicileWindow.GetDomicile.GetOwner.GetPrimaryTitle]"

	visible = "[And( IsInGame, IsGameViewOpen( 'domicile' ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	background = {
		using = Background_Area_Dark
		color = { 0.11 0.10 0.09 0.94 }
		margin = { 6 6 }
	}

	vbox = {
		margin = { 14 10 }
		spacing = 4
		min_width = @lib_width

		### Header -- the community's name. The window-control close
		### button is hidden: this panel lives and dies with the domicile
		### view, it has no life of its own to close.
		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_LIB_HEADER"
			}
			blockoverride "button_close"
			{
				visible = no
			}
		}

		### Not a Kehillah's quarter (or the bisect case above).
		text_single = {
			visible = "[Not( Character.GetGovernment.IsType( 'kehillah_government' ) )]"
			text = "KEHILLAH_LIB_NOT_KEHILLAH"
			default_format = "#weak;italic"
			max_width = @lib_width
		}

		### A Kehillah's quarter: the library.
		vbox = {
			visible = "[Character.GetGovernment.IsType( 'kehillah_government' )]"
			layoutpolicy_horizontal = expanding
			spacing = 4

			text_single = {
				visible = "[DataModelHasItems( Title.MakeScope.GetList( 'kehillah_library_works' ) )]"
				text = "KEHILLAH_LIB_SUBHEADER"
				default_format = "#weak;italic"
				max_width = @lib_width
			}
			text_single = {
				visible = "[Not( DataModelHasItems( Title.MakeScope.GetList( 'kehillah_library_works' ) ) )]"
				text = "KEHILLAH_LIB_EMPTY"
				default_format = "#weak;italic"
				max_width = @lib_width
			}

			### The works held. One row per flag in the title's list.
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2
				margin_top = 4
				datamodel = "[Title.MakeScope.GetList( 'kehillah_library_works' )]"

				item = {
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "[Localize( Concatenate( 'kehillah_lib_tt_', Scope.GetFlagName ) )]"
						using = tooltip_se

						icon = {
							size = { 20 20 }
							texture = "gfx/interface/icons/domicile_building/domicile_building_library.dds"
							alwaystransparent = yes
						}
						text_single = {
							text = "[Localize( Concatenate( 'kehillah_lib_name_', Scope.GetFlagName ) )]"
							default_format = "#high"
							max_width = @lib_name_width
						}
						text_single = {
							text = "[Localize( Concatenate( 'kehillah_lib_subject_', Scope.GetFlagName ) )]"
							default_format = "#weak"
						}
						expand = {}
					}
				}
			}

			### What YOU have studied, wherever you studied it.
			hbox = {
				visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_studied_works' ) )]"
				layoutpolicy_horizontal = expanding
				margin_top = 8
				spacing = 6

				text_single = {
					text = "KEHILLAH_LIB_STUDIED_LABEL"
					default_format = "#weak"
					tooltip = "KEHILLAH_LIB_STUDIED_TT"
					using = tooltip_se
				}
				flowcontainer = {
					spacing = 10
					datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_studied_works' )]"

					item = {
						text_single = {
							text = "[Localize( Concatenate( 'kehillah_lib_name_', Scope.GetFlagName ) )]"
							default_format = "#high"
							tooltip = "[Localize( Concatenate( 'kehillah_lib_tt_', Scope.GetFlagName ) )]"
							using = tooltip_se
						}
					}
				}
				expand = {}
			}
		}
	}
}
