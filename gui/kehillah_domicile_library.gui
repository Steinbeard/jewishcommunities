				margin = { 6 0 }

				text_single = {
					parentanchor = hcenter
					text = "KEHILLAH_LIB_TRACK_PARSHANUT"
					default_format = "#high;bold"
					using = Font_Size_Medium
				}
				text_single = {
					parentanchor = hcenter
					text = "KEHILLAH_LIB_TRACK_PARSHANUT_SUB"
					default_format = "#weak;italic"
					using = Font_Size_Small
				}
				widget = { size = { 1 4 } }

				### targum_onkelos
				hbox = {
					layoutpolicy_horizontal = expanding
					ignoreinvisible = yes
					spacing = 4

					text_single = {
						visible = "[GreaterThan_CFixedPoint( Title.MakeScope.ScriptValue( 'kehillah_lib_targum_onkelos_value' ), '(CFixedPoint)0' )]"
						text = "kehillah_lib_name_targum_onkelos"
						default_format = "#high"
						max_width = @lib_name_width
						tooltip = "kehillah_lib_tt_targum_onkelos_held"
						using = tooltip_se
					}
					text_single = {
						visible = "[Not( GreaterThan_CFixedPoint( Title.MakeScope.ScriptValue( 'kehillah_lib_targum_onkelos_value' ), '(CFixedPoint)0' ) )]"
						text = "kehillah_lib_name_targum_onkelos"
						default_format = "#weak;italic"
						max_width = @lib_name_width
						tooltip = "kehillah_lib_tt_targum_onkelos_missing"
						using = tooltip_se
					}

					expand = {}

					text_single = {
						visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue( 'kehillah_read_targum_onkelos_value' ), '(CFixedPoint)0' )]"
						text = "KEHILLAH_LIB_READ_MARK"
						tooltip = "KEHILLAH_LIB_READ_TT"
						using = tooltip_se
					}
				}

				### mekhilta
				hbox = {
					layoutpolicy_horizontal = expanding
					ignoreinvisible = yes
					spacing = 4

					text_single = {
						visible = "[GreaterThan_CFixedPoint( Title.MakeScope.ScriptValue( 'kehillah_lib_mekhilta_value' ), '(CFixedPoint)0' )]"
