# A crisis is owned by one community title. This window deliberately omits
# vanilla situation phase dates and catalyst progress: the preacher/mob stories
# supply the real clock, and Community Safety supplies the forecast.
window = {
 name = "kehillah_crisis_situation_window"
 widgetid = "kehillah_crisis_situation_window"
 datacontext = "[SituationWindow.GetSituation]"
 datacontext = "[GetPlayer]"
 parentanchor = top|right
 layer = windows_layer
 movable = no
 allow_outside = yes
 using = Window_Size_MainTab

 state = {
  name = _show
  using = Animation_FadeIn_Quick
  using = Sound_WindowShow_Standard
  using = Window_Position_MainTab
 }
 state = {
  name = _hide
  using = Animation_FadeOut_Quick
  using = Sound_WindowHide_Standard
  using = Window_Position_MainTab_Hide
 }

 margin_widget = {
  size = { 100% 100% }
  margin = { 0 26 }
  margin_right = 13
  widget = {
   size = { 100% 100% }
   vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding

    header_pattern = {
     layoutpolicy_horizontal = expanding
     blockoverride "header_text" { text = "[Situation.GetNameNoTooltip]" }
     blockoverride "button_back" { onclick = "[OpenGameView('situations')]" }
     blockoverride "button_close" { onclick = "[SituationWindow.Close]" }
    }

    scrollbox = {
     layoutpolicy_horizontal = expanding
     layoutpolicy_vertical = expanding
     blockoverride "scrollbox_content" {
      vbox = {
       layoutpolicy_horizontal = expanding
       spacing = 12
       margin = { 14 12 }

       vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 8
        margin = { 14 14 }
        background = { using = Background_Area_Dark }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[Situation.GetTopCurrentPhase.GetType.GetName]" default_format = "#high;bold" }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[Situation.GetTopCurrentPhase.GetType.GetDesc]" }
       }

       vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 6
        margin = { 14 14 }
        background = { using = Background_Area_Dark }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_situation_people" default_format = "#high;bold" }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_situation_leader" visible = "[Situation.MakeScope.Var('kehillah_crisis_leader').IsSet]" }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_situation_sovereign" visible = "[Situation.MakeScope.Var('kehillah_crisis_sovereign').IsSet]" }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_situation_agitator" visible = "[Situation.MakeScope.Var('kehillah_crisis_agitator').IsSet]" }
       }

       vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 8
        margin = { 14 14 }
        background = { using = Background_Area_Dark }
        visible = "[And(ObjectsEqual(GetPlayer.GetPrimaryTitle, Situation.MakeScope.Var('kehillah_crisis_title').Title), GetScriptedGui('kehillah_crisis_warning_display').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_warning_header" default_format = "#high;bold" }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_warning_numbers" tooltip = "kehillah_crisis_warning_tt" using = tooltip_ws }
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisPending')]" }
       }

       vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 8
        margin = { 14 14 }
        background = { using = Background_Area_Dark }
        visible = "[And(ObjectsEqual(GetPlayer.GetPrimaryTitle, Situation.MakeScope.Var('kehillah_crisis_title').Title), GetScriptedGui('kehillah_crisis_warning_display').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_actions_header" default_format = "#high;bold" }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_watch"
         enabled = "[GetScriptedGui('kehillah_crisis_watch').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('kehillah_crisis_watch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         tooltip = "kehillah_crisis_action_watch_tt" using = tooltip_ws }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_supplies"
         enabled = "[GetScriptedGui('kehillah_crisis_supplies').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('kehillah_crisis_supplies').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         tooltip = "kehillah_crisis_action_supplies_tt" using = tooltip_ws }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_routes"
         enabled = "[GetScriptedGui('kehillah_crisis_routes').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('kehillah_crisis_routes').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         tooltip = "kehillah_crisis_action_routes_tt" using = tooltip_ws }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_advocacy"
         enabled = "[GetScriptedGui('kehillah_crisis_advocacy').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('kehillah_crisis_advocacy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         tooltip = "kehillah_crisis_action_advocacy_tt" using = tooltip_ws }
       }

       vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 8
        margin = { 14 14 }
        background = { using = Background_Area_Dark }
        visible = "[ObjectsEqual(GetPlayer.GetPrimaryTitle, Situation.MakeScope.Var('kehillah_crisis_title').Title)]"
        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_diplomacy_header" default_format = "#high;bold" }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_council"
         enabled = "[GetScriptedGui('kehillah_crisis_council').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('kehillah_crisis_council').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         tooltip = "kehillah_crisis_action_council_tt" using = tooltip_ws }
        button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_situation_to_military"
         onclick = "[OpenGameView('military')]" }
       }

       text_multi = {
        layoutpolicy_horizontal = expanding
        autoresize = yes
        max_width = 490
        visible = "[Not(ObjectsEqual(GetPlayer.GetPrimaryTitle, Situation.MakeScope.Var('kehillah_crisis_title').Title))]"
        text = "kehillah_crisis_situation_observer"
       }
      }
     }
    }
   }
  }
 }
}
