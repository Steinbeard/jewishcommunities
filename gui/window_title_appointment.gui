window = {
	name = "title_appointment"
	movable = no
	allow_outside = yes
	layer = middle

	using = Window_Size_Sidebar
	using = Window_Background_Sidebar

	state = {
		name = _show
		using = Animation_FadeIn_Standard
		using = Sound_WindowShow_Standard

		on_start = "[GetVariableSystem.Set( 'hide_bottom_left_HUD', 'true' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Standard
		using = Sound_WindowHide_Standard

		on_start = "[GetVariableSystem.Clear( 'hide_bottom_left_HUD' )]"
	}

	vbox = {
		# jewishcommunities: hidden for a Kehillah, which uses the variant below.
		visible = "[Not( SuccessionAppointmentWindow.GetTitle.GetHolder.GetGovernment.IsType( 'kehillah_government' ) )]"
		layoutpolicy_horizontal = expanding

		using = Window_Margins_Sidebar

		datacontext = "[SuccessionAppointmentWindow.GetTitle]"

		hbox_appointment_title_info = {
			layoutpolicy_horizontal = expanding
			margin_bottom = 10
			margin_left = 15
		}

		hbox_appointment_succession_law_info = {
			layoutpolicy_horizontal = expanding
		}

		# List of candidates that could be appointed to the title.
		vbox_character_list = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			datacontext = "[SuccessionAppointmentWindow.GetCandidateWindow]"
			datacontext = "[SuccessionAppointmentWindow.GetCandidateCharacterList]"

			blockoverride "skill_sort_buttons" {}

			blockoverride "container_implementation" {
				fixedgridbox = {
					name = "characters_grid"
					datamodel = "[CharacterSelectionList.GetList]"
					addcolumn = 560
					addrow = 125

					item = {
						widget_appointment_succession_candidate_item = {
							datacontext = "[CharacterListItem.GetCharacter]"
						}
					}
				}
			}
		}
	}

	# KEHILLAH (jewishcommunities, 2026-11-16): a Kehillah's appointment
	# succession is shown in the Designate Heir design language (vanilla
	# window_succession_designate_heir.gui): a patterned header, a one-line
	# status, the character-list entry rows with skills, and Close at the
	# foot. The engine data is unchanged - the same candidate list, rank,
	# score and score breakdown the vanilla panel above shows. The window
	# keeps the sidebar frame, because a window's size and position cannot
	# depend on the title being shown.
	vbox = {
		name = "kehillah_appointment"
		visible = "[SuccessionAppointmentWindow.GetTitle.GetHolder.GetGovernment.IsType( 'kehillah_government' )]"
		datacontext = "[SuccessionAppointmentWindow.GetTitle]"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		using = Window_Margins_Sidebar
		margin_left = 10
		spacing = 10

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_APPOINTMENT_HEADER"
			}

			blockoverride "button_close"
			{
				onclick = "[SuccessionAppointmentWindow.Close]"
			}
		}

		text_single = {
			visible = "[Title.MakeScope.Var( 'kehillah_var_endorsed_successor' ).IsSet]"
			max_width = 540
			text = "KEHILLAH_APPOINTMENT_ENDORSED_LINE"
		}

		text_single = {
			visible = "[Not( Title.MakeScope.Var( 'kehillah_var_endorsed_successor' ).IsSet )]"
			max_width = 540
			text = "KEHILLAH_APPOINTMENT_NONE_ENDORSED_LINE"
			default_format = "#weak"
		}

		text_single = {
			max_width = 540
			text = "KEHILLAH_APPOINTMENT_CHOOSE"
		}

		vbox_character_list = {
			name = "kehillah_candidate_list"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			datacontext = "[SuccessionAppointmentWindow.GetCandidateWindow]"
			datacontext = "[SuccessionAppointmentWindow.GetCandidateCharacterList]"

			blockoverride "skill_sort_buttons" {}

			blockoverride "container_implementation" {
				fixedgridbox = {
					name = "characters_grid"
					datamodel = "[CharacterSelectionList.GetList]"
					addcolumn = 550
					addrow = 112

					item = {
						kehillah_appointment_candidate_row = {
							datacontext = "[CharacterListItem.GetCharacter]"
						}
					}
				}
			}
		}

		text_single = {
			visible = "[SuccessionAppointmentWindow.HasMeritPoolData]"
			max_width = 540
			text = "[SuccessionAppointmentWindow.GetMeritPoolDescription]"
			default_format = "#weak"
		}

		hbox = {
			margin_bottom = 20

			button_standard = {
				name = "close_window_button"
				onclick = "[SuccessionAppointmentWindow.Close]"
				text = "CLOSE_LABEL"
			}
		}
	}

	## Separate candidate filtering window opened with the looking glass button.
	window_character_filter = {
		datacontext = "[SuccessionAppointmentWindow.GetCandidateWindow]"
		datacontext = "[SuccessionAppointmentWindow.GetCandidateCharacterList]"
		position = { 600 50 }

		blockoverride "addition_filter" {
			filter_item = {
				layoutpolicy_horizontal = expanding
				datacontext = "[CharacterSelectionList.GetFilter('range_filter')]"
			}

			vbox_filter_group = {
				layoutpolicy_horizontal = expanding

				datacontext = "[CharacterSelectionList.GetCategory('personal_filter_category')]"
				blockoverride "filters" {
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('ruler_filter')]"
					}

					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('adult_filter')]"
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('gender_filter')]"
					}

					divider = {
						layoutpolicy_horizontal = expanding
					}

					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('married_filter')]"
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('imprisoned_filter')]"
					}

					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('hook_filter')]"
					}
				}
			}

			vbox_filter_group = {
				layoutpolicy_horizontal = expanding
				datacontext = "[CharacterSelectionList.GetCategory('membership_filter_category')]"
				blockoverride "filters" {
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('religion_filter')]"
					}

					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('culture_filter')]"
					}

					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('dynasty_house_filter')]"
					}
				}
			}
		}
	}
}

types TitleAppointment
{
	## KEHILLAH candidate row (jewishcommunities, 2026-11-16).
	#
	# Vanilla widget_character_list_item's look - portrait, the character-list
	# entry button, name, age | relation, skills, then house, faith and
	# culture along the bottom - narrowed to fit the sidebar and carrying
	# the appointment rank banner, the candidate score with its breakdown,
	# the endorsement state and the Endorse as Successor interaction.
	type kehillah_appointment_candidate_row = widget {
		size = { 545 108 }
		allow_outside = yes

		divider = {
			parentanchor = bottom|hcenter
			size = { 100% 3 }
		}

		widget = {
			size = { 88 106 }
			allow_outside = yes

			portrait_head_small = {
				allow_outside = yes
				parentanchor = hcenter
				position = { 0 2 }
			}

			widget_succession_candidate_banner = {
				parentanchor = bottom|hcenter
				position = { 0 -3 }
			}
		}

		button_standard = {
			position = { 96 4 }
			size = { 445 98 }

			onclick = "[DefaultOnCharacterClick( Character.GetID )]"
			down = "[ObjectsEqual( Title.MakeScope.Var( 'kehillah_var_endorsed_successor' ).Char, Character.Self )]"

			texture = "gfx/interface/buttons/button_entry_characterlist.dds"
			framesize = { 252 80 }
			spriteType = Corneredtiled
			spriteborder = { 10 30 }

			# Arrow beside the portrait marks the endorsed candidate, as the
			# Designate Heir list marks the current designated heir.
			icon = {
				visible = "[ObjectsEqual( Title.MakeScope.Var( 'kehillah_var_endorsed_successor' ).Char, Character.Self )]"
				parentanchor = left|vcenter
				position = { -20 0 }
				size = { 20 20 }
				texture = "gfx/interface/buttons/button_entry_characterlist_arrow.dds"
			}

			# Top: name, age and relation; skills on the right.
			widget = {
				position = { 10 6 }
				size = { 425 48 }

				text_single = {
					position = { 0 0 }
					max_width = 255
					text = "[Character.GetUINameNoTooltip|U]"
					using = Font_Size_Medium
					alwaystransparent = yes
				}

				hbox = {
					position = { 0 24 }
					spacing = 4

					text_single = {
						text = "CHARACTER_AGE_VALUE"
						align = nobaseline
					}

					icon = {
						visible = "[Not( Character.IsDeadAndValid )]"
						size = { 23 23 }
						framesize = { 60 60 }
						frame = "[Character.GetHealthIconFrame]"
						texture = "gfx/interface/icons/character_status/icon_health.dds"
						tooltip = "[Character.GetHealthInfo]"
					}

					text_single = {
						visible = "[Character.HasRelationTo( GetPlayer )]"
						raw_text = "|  [Character.GetRelationToString( GetPlayer )]"
						tooltip = "EXTENDED_RELATIONS_TOOLTIP"
						default_format = "#low"
						max_width = 190
						align = nobaseline
					}
				}

				hbox = {
					parentanchor = top|right
					spacing = 0

					kehillah_appointment_skill = {
						blockoverride "skill_frame" { frame = 1 }
						blockoverride "skill_value" { text = "[Character.GetSkill( 'diplomacy' )]" }
						blockoverride "skill_tooltip" { tooltip = "KEHILLAH_APPOINTMENT_SKILL_DIPLOMACY" }
					}
					kehillah_appointment_skill = {
						blockoverride "skill_frame" { frame = 2 }
						blockoverride "skill_value" { text = "[Character.GetSkill( 'martial' )]" }
						blockoverride "skill_tooltip" { tooltip = "KEHILLAH_APPOINTMENT_SKILL_MARTIAL" }
					}
					kehillah_appointment_skill = {
						blockoverride "skill_frame" { frame = 3 }
						blockoverride "skill_value" { text = "[Character.GetSkill( 'stewardship' )]" }
						blockoverride "skill_tooltip" { tooltip = "KEHILLAH_APPOINTMENT_SKILL_STEWARDSHIP" }
					}
					kehillah_appointment_skill = {
						blockoverride "skill_frame" { frame = 4 }
						blockoverride "skill_value" { text = "[Character.GetSkill( 'intrigue' )]" }
						blockoverride "skill_tooltip" { tooltip = "KEHILLAH_APPOINTMENT_SKILL_INTRIGUE" }
					}
					kehillah_appointment_skill = {
						blockoverride "skill_frame" { frame = 5 }
						blockoverride "skill_value" { text = "[Character.GetSkill( 'learning' )]" }
						blockoverride "skill_tooltip" { tooltip = "KEHILLAH_APPOINTMENT_SKILL_LEARNING" }
					}
				}
			}

			# Bottom: house, faith, culture; endorsement, score, action.
			hbox = {
				parentanchor = bottom|left
				position = { 8 -4 }
				size = { 430 42 }
				spacing = 5

				widget = {
					size = { 35 40 }

					coa_house_tiny = {
						datacontext = "[Character.GetHouse]"
						parentanchor = center
					}
				}

				icon = {
					size = { 32 32 }
					datacontext = "[Character.GetRite]"
					tooltipwidget = { rite_tooltip = {} }
					texture = "[Rite.GetIcon]"
				}

				hbox = {
					datacontext = "[Character.GetCulture]"
					tooltipwidget = {
						culture_tooltip = {}
					}
					using = tooltip_se

					icon = {
						texture = "gfx/interface/icons/icon_culture.dds"
						size = { 28 28 }
					}

					text_single = {
						text = "CULTURE_LISTS_WINDOW"
						max_width = 80
						align = nobaseline
					}
				}

				expand = {}

				text_single = {
					visible = "[ObjectsEqual( Title.MakeScope.Var( 'kehillah_var_endorsed_successor' ).Char, Character.Self )]"
					text = "KEHILLAH_APPOINTMENT_ENDORSED_TAG"
					max_width = 130
					align = nobaseline
				}

				hbox = {
					spacing = 4

					icon_appointment_score = {}

					text_single = {
						text = "TITLE_APPOINTMENT_SCORE"
						align = nobaseline
						min_width = 22
					}

					tooltipwidget = {
						widget_value_breakdown_tooltip = {
							datacontext = "[SuccessionAppointmentWindow.GetSuccessionScoreBreakdown( Character.Self )]"

							blockoverride "header_text" {
								text = "TITLE_APPOINTMENT_SCORE_TT_HEADING"
							}
						}
					}

					using = tooltip_se
				}

				button_round = {
					name = "kehillah_endorse_successor"
					visible = "[Character.IsPlayerInteractionShown( 'kehillah_endorse_successor_interaction' )]"
					size = { 32 32 }

					onclick = "[Character.OpenPlayerInteraction( 'kehillah_endorse_successor_interaction' )]"
					enabled = "[Character.IsPlayerInteractionValid( 'kehillah_endorse_successor_interaction' )]"
					tooltip = "[Character.GetPlayerInteractionTooltip( 'kehillah_endorse_successor_interaction' )]"

					button_promote_candidate = {
						size = { 24 24 }
						parentanchor = center
						alwaystransparent = yes
					}
				}
			}
		}
	}

	## One skill value on vanilla's coloured skill background.
	type kehillah_appointment_skill = widget {
		size = { 32 25 }
		block "skill_tooltip" {}

		background = {
			texture = "gfx/interface/window_character/character_view_skills_bg.dds"
			framesize = { 70 26 }
			margin = { 5 0 }
			block "skill_frame" {}
		}

		text_single = {
			parentanchor = center
			margin_bottom = 4
			align = center
			block "skill_value" {}
		}
	}

	## Overview of the title that is to have a holder appointed.
	#
	type hbox_appointment_title_info = hbox {
		background = {
			using = Background_Header
		}

		background = {
			using = Background_Header_Pattern
		}

		coa_title_big_crown = {}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					margin_top = 20

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "[Title.GetHolder.GetTopLiege.GetPrimaryTitle.GetName|U]"
						default_format = "#weak"
						max_width = 350
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "TITLE_APPOINTMENT_HEADER"
						max_width = 350
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "TITLE_APPOINTMENT_CURRENT_HOLDER"
						max_width = 350
					}

					text_single = {
						visible = "[SuccessionAppointmentWindow.HasMeritPoolData]"
						layoutpolicy_horizontal = expanding

						text = "[SuccessionAppointmentWindow.GetMeritPoolDescription]"
					}
					
					hbox = {
						datacontext = "[Title.GetHolder.GetRite]"
						datacontext = "[Rite.GetFaith]"
						visible = "[And( Title.HasClericalRegion, Title.GetHolder.IsValid )]"
						layoutpolicy_horizontal = expanding
						spacing = 6
						margin_top = 10

						button_rite_icon = {
							size = { 50 50 }
							texture = "[Rite.GetIcon]"
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no

							text = "[Rite.GetNameNoTooltip]"
							align = nobaseline
							using = Font_Size_Medium
							using = Font_Type_Flavor
						}
					}

					expand = {}
				}

				vbox = {
					layoutpolicy_vertical = expanding

					buttons_window_control = {
						blockoverride "button_close"
						{
							onclick = "[SuccessionAppointmentWindow.Close]"
						}

						blockoverride "button_back"
						{
							visible = "[HasViewHistory]"
							onclick = "[OpenFromViewHistory]"
							tooltip = "[GetViewHistoryTooltip]"
						}

						blockoverride "button_me"
						{
							onclick = "[DefaultOnCharacterClick( GetPlayer.GetID )]"
						}
					}

					expand = {}
				}
			}
		}
	}


	## Genera information on how the heir for this title is picked.
	type hbox_appointment_succession_law_info = hbox {
		layoutpolicy_horizontal = expanding

		hbox = {
			layoutpolicy_horizontal = expanding
			datacontext = "[SuccessionAppointmentWindow.GetMeritPool]"

			### SUCCESSION LAW ###
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				text_label_left = {
					layoutpolicy_horizontal = expanding

					text = "TITLE_APPOINTMENT_LAW"
					max_width = 550
				}

				### MERIT REALM INFO ###
				text_single = {
					visible = "[SuccessionAppointmentWindow.HasMeritPoolData]"
					max_width = 550

					layoutpolicy_horizontal = expanding

					text = "TITLE_APPOINTMENT_MERIT_CANDIDATE_DESC"
					align = nobaseline
				}

				text_single = {
					visible = "[SuccessionAppointmentWindow.HasMeritPoolData]"
					max_width = 550

					layoutpolicy_horizontal = expanding

					text = "TITLE_APPOINTMENT_MERIT_CANDIDATE_RANK"
					align = nobaseline
				}
			}
		}

		expand = {}
	}


	## Normal size banner showing appointment rank
	#
	type widget_succession_candidate_banner = widget
	{
		size = { 85 32 }

		background = {
			texture = "gfx/interface/window_theme_administration/rating_banner.dds"
		}

		tooltip = "TITLE_APPOINTMENT_RANK_TOOLTIP"

		text_single = {
			parentanchor = center
			position = { 0 -1 }
			max_width = 250

			block "banner_text"
			{
				text = "TITLE_APPOINTMENT_RANK"
			}
			default_format = "#light_background"
			using = Font_Size_Tiny
			align = nobaseline
		}
	}


	## Small banner showing appointment rank
	#
	# Used in Administrative Government window.
	#
	type widget_appointment_succession_candidate_banner_small = widget
	{
		size = { 60 24 }

		highlight_icon = {
			size = { 60 24 }

			block "background_texture"
			{
				texture = "gfx/interface/window_theme_administration/rating_banner.dds"
			}
		}

		text_single = {
			parentanchor = center
			position = { 0 -1 }
			max_width = 250

			block "default_format" {
				default_format = "#light_background"
			}
			using = Font_Size_Tiny
			align = nobaseline

			block "banner_text"
			{
				text = "TITLE_APPOINTMENT_RANK_SMALL"
			}
		}
	}

	type icon_appointment_score = icon
	{
		size = { 24 24 }

		icon = {
			visible = "[Title.GetHolder.GetGovernment.HasGovernmentFlag( 'government_is_theocracy' )]"
			size = { 24 24 }
			texture = "gfx/interface/icons/clerical_score.dds"
		}

		icon = {
			visible = "[Not( Title.GetHolder.GetGovernment.HasGovernmentFlag( 'government_is_theocracy' ) )]"
			size = { 24 24 }
			texture = "gfx/interface/icons/appointment_score.dds"
		}
	}

	## Info on a single candidate that could be appointed
	#
	# +---+ Person Name of Some Title  [§ -27%]
	# |^_^| (personal relation to player)  +--+
	# +---+                                |  |
	# [###] @ 45                           \__/
	#
	type widget_appointment_succession_candidate_item = widget {
		size = { 560 122 }

		allow_outside = yes

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			background = {
				visible = "[Not( SuccessionAppointmentWindow.IsTopCandidate( CharacterListItem.Self ) )]"

				using = Background_Frame
			}

			background = {
				visible = "[SuccessionAppointmentWindow.IsTopCandidate( CharacterListItem.Self )]"

				using = Background_Frame_Gold
			}

			hbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				vbox = {
					margin_left = 5
					allow_outside = yes

					widget = {
						size = { 85 122 }

						portrait_head_small = {
							allow_outside = yes
							parentanchor = hcenter
							position = { 0 2}
						}

						widget_succession_candidate_banner = {
							parentanchor = bottom|hcenter
							position = { 0 -3 }
						}
					}
				}

				vbox = {
					margin_right = 10
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding

					hbox = {
						margin = { 5 5 }
						layoutpolicy_horizontal = expanding

						background = {
							margin_right = 8
							margin_left = 6
							using = Background_Area_Dark
						}

						### NAME ###
						text_single = {
							max_width = 344
							layoutpolicy_horizontal = expanding

							text = "[Character.GetUINameNoTooltip|U]"
							align = nobaseline
							using = Font_Size_Medium
						}

						expand = {}

						### GOVERNOR EFFICIENCY ###
						hbox = {
							tooltip = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT"
							using = tooltip_ne

							visible = "[SuccessionAppointmentWindow.GetTitle.GetHolder.GetGovernment.HasMechanic( 'administrative' )]"

							icon = {
								name = "char_governor_efficiency_icon"
								size = { 32 32 }
								texture = "gfx/interface/icons/icon_skill_governor_efficiency.dds"
							}

							text_single = {
								name = "char_governor_efficiency_value"
								text = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE"
								align = nobaseline
							}
						}
					}

					hbox = {
						datacontext = "[Character.GetHouse]"
						layoutpolicy_horizontal = expanding

						margin_bottom = 5

						vbox = {
							layoutpolicy_vertical = expanding

							### RELATION TO YOU ###
							text_single = {
								layoutpolicy_horizontal = expanding

								text = "[Character.GetRelationToString( GetPlayer )]"
								align = nobaseline
								default_format = "#low"
								max_width = 390
								margin_left = 5

								tooltip = "[Character.GetRelationToString( GetPlayer )]"
							}

							expand = {}

							hbox = {
								datacontext = "[SuccessionAppointmentWindow.GetTitle]"
								layoutpolicy_horizontal = expanding
								spacing = 5
								
								hbox = {
									visible = "[Title.HasClericalRegion]"
									margin_left = 6
									spacing = 3
				
									button_rite_icon = {
										name = "rite_button"
										datacontext = "[Character.GetRite]"
										size = { 25 25 }
						
										onclick = "[OpenGameViewData( 'faith', Rite.Self )]"
									}
				
									expand = {
										margin = { 1 2 }
										divider_light = {
											layoutpolicy_vertical = expanding
										}
									}
								}

								### MERIT ###
								hbox_merit_with_label = {
									datacontext = "[AppointmentCandidateCharacterList.GetMeritItem( CharacterListItem.GetIndex )]"

									blockoverride "hbox_merit_with_label_background" {}
								}

								hbox = {
									spacing = 5

									icon_appointment_score = {}

									### CANDIDATE SCORE ###
									text_single = {
										text = "TITLE_APPOINTMENT_SCORE"
										align = nobaseline
										min_width = 22
									}

									tooltipwidget = {
										widget_value_breakdown_tooltip = {
											datacontext = "[SuccessionAppointmentWindow.GetSuccessionScoreBreakdown( Character.Self )]"

											blockoverride "header_text" {
												text = "TITLE_APPOINTMENT_SCORE_TT_HEADING"
											}
										}
									}

									using = tooltip_se
								}

								### INTERACTIONS ###
								# ordinary candidacy
								button_round = {
									name = "support_candidacy"
									visible = "[Character.IsPlayerInteractionShownAndCanPickTitle( 'influence_candidacy_interaction', Title.Self )]"
									size = { 32 32 }

									onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'influence_candidacy_interaction', Title.Self )]"
									enabled = "[Character.IsPlayerInteractionWithTargetTitleValid( 'influence_candidacy_interaction', Title.Self )]"
									tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'influence_candidacy_interaction', Title.Self )]"

									button_promote_candidate = {
										size = { 24 24 }
										parentanchor = center
										alwaystransparent = yes
									}
								}

								# clerical regions
								button_round = {
									name = "support_clerical"
									visible = "[And( Character.IsPlayerInteractionShownAndCanPickTitle( 'influence_clerical_candidacy_interaction', Title.Self ), Title.IsClericalRegion )]"
									size = { 32 32 }

									onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'influence_clerical_candidacy_interaction', Title.Self )]"
									enabled = "[Character.IsPlayerInteractionWithTargetTitleValid( 'influence_clerical_candidacy_interaction', Title.Self )]"
									tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'influence_clerical_candidacy_interaction', Title.Self )]"

									button_promote_candidate = {
										size = { 24 24 }
										parentanchor = center
										alwaystransparent = yes
									}
								}

								# bishoprics
								button_round = {
									name = "increase_theocratic_heir_candidacy"
									visible = "[And( Character.IsPlayerInteractionShownAndCanPickTitle( 'increase_theocratic_heir_candidacy', Title.Self ), Not( Title.IsClericalRegion ) )]"
									size = { 32 32 }

									onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'increase_theocratic_heir_candidacy', Title.Self )]"
									enabled = "[Character.IsPlayerInteractionWithTargetTitleValid( 'increase_theocratic_heir_candidacy', Title.Self )]"
									tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'increase_theocratic_heir_candidacy', Title.Self )]"

									button_icon = {
										size = { 24 24 }
										parentanchor = center
										alwaystransparent = yes
										texture = "gfx/interface/icons/flat_icons/clerical_score.dds"
									}
								}

								# celestial circuits
								button_round = {
									name = "influence_meritorious_career_interaction"
									visible = "[Character.IsPlayerInteractionShown( 'influence_meritorious_career_interaction' )]"
									size = { 32 32 }

									onclick = "[Character.OpenPlayerInteraction( 'influence_meritorious_career_interaction' )]"
									enabled = "[Character.IsPlayerInteractionValid( 'influence_meritorious_career_interaction' )]"
									tooltip = "[Character.GetPlayerInteractionTooltip( 'influence_meritorious_career_interaction')]"

									button_promote_candidate = {
										size = { 24 24 }
										parentanchor = center
										alwaystransparent = yes
									}
								}

								# heads of faith, hiding if it's disabled so it doesn't clutter the list
								button_round = {
									name = "influence_head_of_faith_candidacy_interaction"
									visible = "[And3( Character.IsPlayerInteractionShownAndCanPickTitle( 'influence_head_of_faith_candidacy_interaction', Title.Self ), Character.IsPlayerInteractionWithTargetTitleValid( 'influence_head_of_faith_candidacy_interaction', Title.Self ), GreaterThan_int32( Title.GetTierFrame, '(int32)3') )]"
									size = { 32 32 }

									onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'influence_head_of_faith_candidacy_interaction', Title.Self )]"
									enabled = "[Character.IsPlayerInteractionWithTargetTitleValid( 'influence_head_of_faith_candidacy_interaction', Title.Self )]"
									tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'influence_head_of_faith_candidacy_interaction', Title.Self )]"

									button_promote_candidate = {
										size = { 24 24 }
										parentanchor = center
										alwaystransparent = yes
									}
								}

								expand = {}
							}
						}

						expand = {}

						### House Coat of Arms
						vbox = {
							coa_house_small = {
								powerful_family_bonus = {
									parentanchor = bottom|right
									position = { 5 1 }

									blockoverride "family_bonus_size" {
										size = { 28 28 }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
