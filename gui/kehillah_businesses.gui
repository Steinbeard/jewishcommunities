		text_multi = { size = { 530 26 } autoresize = no text = "kehillah_businesses_terms" tooltip = "kehillah_businesses_commitment" using = Font_Size_Small }
		text_multi = { visible = "[Not(DataModelHasItems(Title.MakeScope.GetList('kehillah_businesses')))]" size = { 540 50 } text = "kehillah_businesses_none" }
		scrollbox = {
			size = { 540 390 }
			blockoverride "scrollbox_content" {
				vbox = {
					spacing = 8
					ignoreinvisible = yes
					kehillah_business_row_market = {
						visible = "[And(GetScriptedGui('kehillah_business_market_visible').IsShown(GuiScope.SetRoot(DomicileWindow.GetCharacter.MakeScope).End),Not(DomicileWindow.GetCharacter.GetCharacterEmployedAs('kehillah_business_market_position').IsValid))]"
