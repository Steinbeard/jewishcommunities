		spacing = 6
		text_multi = { size = { 530 34 } autoresize = no text = "kehillah_businesses_intro" using = Font_Size_Small }
		text_single = { text = "kehillah_businesses_summary" using = Font_Size_Medium tooltip = "kehillah_business_economy_tt" }
