					kehillah_business_row_dyers = {
						visible = "[And(GetScriptedGui('kehillah_business_dyers_visible').IsShown(GuiScope.SetRoot(DomicileWindow.GetCharacter.MakeScope).End),Not(DomicileWindow.GetCharacter.GetCharacterEmployedAs('kehillah_business_dyers_position').IsValid))]"
