# The danger-of-violence tooltip (2026-11-09). Vanilla's script-value
# breakdown (gui/shared/value_breakdown.gui) of kehillah_danger_value, with
# the band, the yearly chance and the quarterly roll above the terms. The
# terms and their labels live in common/script_values/kehillah_danger_values.txt
# (each add's desc), so the list cannot drift from the formula.
# Use inside a tooltipwidget where Title is the community's title:
#   kehillah_danger_breakdown_tooltip = {
#       datacontext = "[GuiScope.SetRoot( Title.GetHolder.MakeScope ).GetScriptValueBreakdown( 'kehillah_danger_value' )]"
#   }
types KehillahDangerBreakdown
{
	type kehillah_danger_breakdown_tooltip = widget_value_breakdown_list
	{
		blockoverride "background"
		{
			using = DefaultTooltipBackground
		}

		blockoverride "list"
		{
			margin_bottom = 17
		}

		blockoverride "header"
		{
			vbox = {
				layoutpolicy_horizontal = expanding
				margin_bottom = 4
				spacing = 4

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "KEHILLAH_DANGER_BD_HEADER"
					default_format = "#T"
				}
				text_multi = {
					layoutpolicy_horizontal = expanding
					max_width = 420
					autoresize = yes
					text = "KEHILLAH_DANGER_BD_CHANCE"
				}
				text_multi = {
					layoutpolicy_horizontal = expanding
					max_width = 420
					autoresize = yes
					text = "KEHILLAH_DANGER_BD_KINDS"
					default_format = "#weak"
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					margin_top = 6
					text = "KEHILLAH_DANGER_BD_SCORE"
				}
			}
		}
	}
}
