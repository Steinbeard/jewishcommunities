# The danger-of-violence tooltip (2026-11-09). The sub-values of vanilla's
# script-value breakdown of kehillah_danger_value, with the band, the yearly
# chance and the quarterly roll above the terms. The terms and their labels
# live in common/script_values/kehillah_danger_values.txt (each add's desc
# and KEHILLAH_DANGER_TERM_FORMAT), so the list cannot drift from the formula.
# 2026-11-10 (Daniel's screenshot): a standalone widget, not a
# widget_value_breakdown_list. Vanilla's list item adds its own value column,
# coloured positive-is-good, beside our formatted text; that item has no
# block to override, so each row here shows the formatted text only.
# Use inside a tooltipwidget where Title is the community's title:
#   kehillah_danger_breakdown_tooltip = {}
# or, where only the player is in context:
#   kehillah_danger_breakdown_tooltip = { datacontext = "[GetPlayer.GetPrimaryTitle]" }
# Every danger readout uses this one widget, so they stay in step.
types KehillahDangerBreakdown
{
	type kehillah_danger_breakdown_tooltip = widget
	{
		size = { 50 50 }
		alwaystransparent = no
		using = DefaultTooltipBackground

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 20 10 }
			margin_bottom = 17
			spacing = 4

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "KEHILLAH_DANGER_BD_HEADER"
				default_format = "#T"
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				max_width = 420
				autoresize = yes
				text = "KEHILLAH_DANGER_BD_CHANCE"
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				max_width = 420
				autoresize = yes
				text = "KEHILLAH_DANGER_BD_KINDS"
				default_format = "#weak"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				margin_top = 6
				text = "KEHILLAH_DANGER_BD_SCORE"
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				datacontext = "[GuiScope.SetRoot( Title.GetHolder.MakeScope ).GetScriptValueBreakdown( 'kehillah_danger_value' )]"

				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[ValueBreakdown.GetSubValues]"
					spacing = 2

					item = {
						text_single = {
							layoutpolicy_horizontal = expanding
							margin_left = 8
							text = "[ValueBreakdown.GetName]"
							max_width = 400
						}
					}
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				margin_top = 4
				max_width = 420
				autoresize = yes
				text = "KEHILLAH_DANGER_BD_FOOTER"
				default_format = "#weak"
			}
		}
	}
}
