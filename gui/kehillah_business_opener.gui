# Three-stage navigation: close the foreground Domain view, use vanilla's
# guarded Toggle for the domicile, then select a tab only once it is open.
# Never toggle an already-open Quarter or consume a request before it opens.
widget = {
	name = "kehillah_business_navigation_focus"
	size = { 0 0 }
	visible = "[And(And(And(IsInGame,GetPlayer.IsValid),Or(GetPlayer.MakeScope.Var('kehillah_business_open_request').IsSet,GetPlayer.MakeScope.Var('kehillah_business_households_request').IsSet)),IsGameViewOpen('my_realm'))]"
	visible_at_creation = no
	state = { name = _show on_start = "[CloseGameView('my_realm')]" }
}
widget = {
	name = "kehillah_business_navigation_ensure"
	size = { 0 0 }
	visible = "[And(And(And(IsInGame,GetPlayer.IsValid),Or(GetPlayer.MakeScope.Var('kehillah_business_open_request').IsSet,GetPlayer.MakeScope.Var('kehillah_business_households_request').IsSet)),And(Not(IsGameViewOpen('my_realm')),Not(IsGameViewOpen('domicile'))))]"
	visible_at_creation = no
	state = { name = _show on_start = "[ToggleGameViewData('domicile',GetPlayer.GetDomicile.Self)]" }
}
widget = {
	name = "kehillah_business_open_opener"
	size = { 0 0 }
	visible = "[And(And(And(IsInGame,GetPlayer.IsValid),GetPlayer.MakeScope.Var('kehillah_business_open_request').IsSet),And(Not(IsGameViewOpen('my_realm')),IsGameViewOpen('domicile')))]"
	visible_at_creation = no
	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear('kehillah_lib_panel_open')]"
		on_start = "[GetVariableSystem.Clear('show_building_panel')]"
		on_start = "[GetVariableSystem.Clear('bookmark_overview')]"
		on_start = "[GetVariableSystem.Clear('bookmark_patrons')]"
		on_start = "[GetVariableSystem.Clear('bookmark_followers')]"
		on_start = "[GetVariableSystem.Clear('bookmark_disciples')]"
		on_start = "[GetVariableSystem.Clear('bookmark_debtors')]"
		on_start = "[GetVariableSystem.Clear('bookmark_artifacts')]"
		on_start = "[GetScriptedGui('kehillah_economy_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetVariableSystem.Set('kehillah_households_panel_open','yes')]"
		on_start = "[GetVariableSystem.Set('kehillah_businesses_tab','yes')]"
		on_start = "[GetScriptedGui('kehillah_business_open_request_consume').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
}
widget = {
	name = "kehillah_business_households_opener"
	size = { 0 0 }
	visible = "[And(And(And(IsInGame,GetPlayer.IsValid),GetPlayer.MakeScope.Var('kehillah_business_households_request').IsSet),And(Not(IsGameViewOpen('my_realm')),IsGameViewOpen('domicile')))]"
	visible_at_creation = no
	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear('kehillah_lib_panel_open')]"
		on_start = "[GetVariableSystem.Clear('show_building_panel')]"
		on_start = "[GetVariableSystem.Clear('bookmark_overview')]"
		on_start = "[GetVariableSystem.Clear('bookmark_patrons')]"
		on_start = "[GetVariableSystem.Clear('bookmark_followers')]"
		on_start = "[GetVariableSystem.Clear('bookmark_disciples')]"
		on_start = "[GetVariableSystem.Clear('bookmark_debtors')]"
		on_start = "[GetVariableSystem.Clear('bookmark_artifacts')]"
		on_start = "[GetScriptedGui('kehillah_economy_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetVariableSystem.Set('kehillah_households_panel_open','yes')]"
		on_start = "[GetVariableSystem.Clear('kehillah_businesses_tab')]"
		on_start = "[GetScriptedGui('kehillah_business_open_request_consume').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
}
