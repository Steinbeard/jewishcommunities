					size = { 156 32 }
					text = "[Concatenate( Localize( 'kehillah_spark_upgrade_button' ), Select_CString( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)1' ), Concatenate( Localize( 'KEHILLAH_SPARK_COUNT_OPEN' ), Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_routes_met_value' ) ) ), Concatenate( '/', Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_routes_needed_value' ) ) ), Localize( 'KEHILLAH_SPARK_COUNT_CLOSE' ) ) ) ) ), Localize( 'KEHILLAH_SPARK_NOTHING' ) ) )]"
					enabled = "[GetScriptedGui( 'kehillah_spark_upgrade_talmudics' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'kehillah_spark_upgrade_talmudics' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					using = tooltip_es
					glow = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_ready_value' ), '(CFixedPoint)1' )]"
						glow_radius = 8
