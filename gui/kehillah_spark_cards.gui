##########################################################################
# SPARK CARDS for the Learning window (2026-11-24, Daniel: "a very clean and
# vanilla-like UI experience that cleanly communicates without overexplaining,
# using icons, colors and smart visual hierarchies").
# GENERATED by scripts/kehillah_writing_sparks.py -- edit the script, not this.
# One card per discipline, for the character the Learning window shows
# (var:kehillah_learning_view). Header: inspiration icon, discipline, the
# spark's name, three tier stars, and Write for the player. Below: the source
# book, then the next rung only -- the Insight's routes, or the Chiddush's
# open landmark paths -- as check/cross lines.
##########################################################################
types KehillahSparkCards
{
	### Parshanut
	type kehillah_spark_card_parshanut = vbox {
		layoutpolicy_horizontal = expanding
		margin = { 12 8 }
		spacing = 4
		background = {
			using = Background_Area
			alpha = 0.4
		}

		### Header: the spark, its discipline and its tier.
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			widget = {
				size = { 44 44 }
				icon = {
					visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet]"
					size = { 44 44 }
					texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
				}
				icon = {
					visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet )]"
					size = { 44 44 }
					texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
					alpha = 0.3
				}
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "kehillah_spark_disc_parshanut"
					default_format = "#light_background;weak"
					using = Text_Light_Background_Overrides
					align = left|nobaseline
				}
				text_single = {
					visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet]"
					layoutpolicy_horizontal = expanding
					text = "[Localize( Concatenate( 'kehillah_spark_title_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).GetFlagName ) )]"
					default_format = "#light_background;bold"
					using = Text_Light_Background_Overrides
					using = Font_Size_Medium
					align = left|nobaseline
					max_width = 330
				}
				text_single = {
					visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet )]"
					layoutpolicy_horizontal = expanding
					text = "kehillah_spark_empty_parshanut"
					default_format = "#light_background;weak"
					using = Text_Light_Background_Overrides
					align = left|nobaseline
					max_width = 330
				}
			}
			hbox = {
				visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet]"
				spacing = 2
				tooltip = "[Concatenate( Localize( 'kehillah_spark_tier_tt_prefix' ), GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.Custom( 'KehillahSparkTier_parshanut' ) )]"
				widget = {
					size = { 20 20 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
				widget = {
					size = { 20 20 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)2' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)2' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
				widget = {
					size = { 20 20 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
			}
			button_standard = {
				visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.IsLocalPlayer )]"
				size = { 110 32 }
				text = "kehillah_spark_write_button"
				enabled = "[GetScriptedGui( 'kehillah_spark_write' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui( 'kehillah_spark_write' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kehillah_spark_write_button_tt"
			}
		}

		### Where it came from.
		text_single = {
			visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).IsSet, Not( EqualTo_string( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).GetFlagName, 'none' ) ) )]"
			layoutpolicy_horizontal = expanding
			margin_left = 54
			text = "[Concatenate( Localize( 'kehillah_spark_from' ), Localize( Concatenate( 'kehillah_lib_name_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).GetFlagName ) ) )]"
			default_format = "#light_background;weak"
			using = Text_Light_Background_Overrides
			align = left|nobaseline
			max_width = 460
		}

		### Insight: any one route deepens it.
		vbox = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
			layoutpolicy_horizontal = expanding
			margin_left = 54
			margin_top = 4
			spacing = 2
			text_single = {
				layoutpolicy_horizontal = expanding
				text = "kehillah_spark_routes_header"
				default_format = "#light_background;weak"
				using = Text_Light_Background_Overrides
				align = left|nobaseline
			}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_apt_value' ), '(CFixedPoint)1' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_check.dds"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_apt_value' ), '(CFixedPoint)0' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_cross.dds"
							alpha = 0.55
						}
						text_single = {
							text = "[Concatenate( Localize( 'kehillah_spark_route_parshanut_apt' ), Concatenate( ' ', Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_writing_parshanut_aptitude_value' ) ) ), Concatenate( ' / ', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_apt_target_value' ) ) ) ) ) ) )]"
							default_format = "#light_background"
							using = Text_Light_Background_Overrides
							align = left|nobaseline
							max_width = 440
						}
						expand = {}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_works_value' ), '(CFixedPoint)1' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_check.dds"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_works_value' ), '(CFixedPoint)0' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_cross.dds"
							alpha = 0.55
						}
						text_single = {
							text = "[Localize( 'kehillah_spark_route_parshanut_works' )]"
							default_format = "#light_background"
							using = Text_Light_Background_Overrides
							align = left|nobaseline
							max_width = 440
						}
						expand = {}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_preached_value' ), '(CFixedPoint)1' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_check.dds"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_preached_value' ), '(CFixedPoint)0' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_cross.dds"
							alpha = 0.55
						}
						text_single = {
							text = "[Localize( 'kehillah_spark_route_parshanut_preached' )]"
							default_format = "#light_background"
							using = Text_Light_Background_Overrides
							align = left|nobaseline
							max_width = 440
						}
						expand = {}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_chavrusa_value' ), '(CFixedPoint)1' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_check.dds"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_route_parshanut_chavrusa_value' ), '(CFixedPoint)0' )]"
							size = { 18 18 }
							texture = "gfx/interface/icons/symbols/icon_cross.dds"
							alpha = 0.55
						}
						text_single = {
							text = "[Localize( 'kehillah_spark_route_parshanut_chavrusa' )]"
							default_format = "#light_background"
							using = Text_Light_Background_Overrides
							align = left|nobaseline
							max_width = 440
						}
						expand = {}
					}
		}

		### Chiddush and Great Work: the open landmark paths for this form.
		vbox = {
			visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)2' )]"
