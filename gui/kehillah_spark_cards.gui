	### Talmudics: a card in its own colour.
	type kehillah_spark_card_talmudics = widget {
		size = { 186 350 }

		### Drop shadow, offset down and right.
		widget = {
			position = { 5 6 }
			size = { 182 344 }
			alpha = 0.35
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.08 0.05 0.03 1 }
			}
		}

		### The card.
		widget = {
			size = { 182 344 }
			background = { using = Background_Area_Dark }
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.62 0.20 0.17 0.16 }
			}
			background = { using = Background_Frame }

			vbox = {
				size = { 100% 100% }
				margin_bottom = 10
				spacing = 6

				### Band: the discipline, in its colour.
				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 30 }
					background = {
						texture = "gfx/interface/colors/white.dds"
						color = { 0.62 0.20 0.17 0.9 }
					}
					text_single = {
						parentanchor = center
						text = "kehillah_spark_disc_talmudics"
						align = nobaseline
					}
					### Set the idea aside (asks first: kehillah_spark.0032).
					button_close = {
						visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.IsLocalPlayer )]"
						parentanchor = right|vcenter
						position = { -4 0 }
						size = { 22 22 }
						onclick = "[GetScriptedGui( 'kehillah_spark_discard_talmudics' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						tooltip = "kehillah_spark_discard_tt"
					}
				}

				widget = {
					size = { 64 64 }
					icon = {
						visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).IsSet]"
						size = { 64 64 }
						texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
					}
					icon = {
						visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).IsSet )]"
						size = { 64 64 }
						texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
						alpha = 0.18
					}
				}

				### A held spark: its name, tier and source.
				vbox = {
					visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).IsSet]"
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 166
						min_width = 166
						text = "[Localize( Concatenate( 'kehillah_spark_title_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).GetFlagName ) )]"
						using = Font_Size_Medium
						align = hcenter|nobaseline
					}
					hbox = {
						spacing = 2
						tooltip = "[Concatenate( Localize( 'kehillah_spark_tier_tt_prefix' ), GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.Custom( 'KehillahSparkTier_talmudics' ) )]"
				widget = {
					size = { 22 22 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)1' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)1' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
				widget = {
					size = { 22 22 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)2' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)2' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
