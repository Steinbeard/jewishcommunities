						align = left|nobaseline
					}
					### Insight: any one route.
					vbox = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
						layoutpolicy_horizontal = expanding
						spacing = 2
						text_single = {
