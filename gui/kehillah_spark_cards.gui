											visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_7' ) ), '(CFixedPoint)0' )]"
											size = { 18 18 }
											texture = "gfx/interface/icons/symbols/icon_cross.dds"
											alpha = 0.6
										}
										text_single = {
											text = "[Localize( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_7' ) )]"
											align = left|nobaseline
											max_width = 380
										}
										expand = {}
									}
									hbox = {
										visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_8' ) ), '(CFixedPoint)0' )]"
										layoutpolicy_horizontal = expanding
										spacing = 6
										icon = {
											visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_8' ) ), '(CFixedPoint)1' )]"
											size = { 18 18 }
											texture = "gfx/interface/icons/symbols/icon_check.dds"
										}
										icon = {
											visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_8' ) ), '(CFixedPoint)0' )]"
											size = { 18 18 }
											texture = "gfx/interface/icons/symbols/icon_cross.dds"
											alpha = 0.6
										}
										text_single = {
											text = "[Localize( Concatenate( Concatenate( 'kehillah_spark_nc_', Scope.GetFlagName ), '_8' ) )]"
											align = left|nobaseline
											max_width = 380
										}
										expand = {}
									}
									}
								}
							}
						}
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_hashkafa_ready_value' ), '(CFixedPoint)1' )]"
						layoutpolicy_horizontal = expanding
						text = "kehillah_spark_upgrade_tt_ready"
						align = left|nobaseline
					}
				}
			}
		}
				}
				### A Great Work's place in the action row, and a viewer's read-only tooltip.
				text_single = {
					visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_hashkafa_form' ).IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_hashkafa_tier_value' ), '(CFixedPoint)3' ) )]"
					text = "kehillah_spark_great_badge"
					align = nobaseline
				}
				button_standard = {
					visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_hashkafa_form' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.IsLocalPlayer )]"
					size = { 156 32 }
					text = "kehillah_spark_write_button"
					enabled = "[GetScriptedGui( 'kehillah_spark_write' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'kehillah_spark_write' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kehillah_spark_write_button_tt"
				}
			}
		}
	}
