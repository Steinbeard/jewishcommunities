					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)3' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)3' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
						### Great Work potential: bright for a historical landmark,
						### dimmer for an original work only, faint for none.
						widget = {
							visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_tier_value' ), '(CFixedPoint)3' )]"
							size = { 26 22 }
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_potential_value' ), '(CFixedPoint)2' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								tooltip = "kehillah_spark_potential_2"
							}
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_potential_value' ), '(CFixedPoint)1' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								alpha = 0.55
								tooltip = "kehillah_spark_potential_1"
							}
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_potential_value' ), '(CFixedPoint)0' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								alpha = 0.15
								tooltip = "kehillah_spark_potential_0"
							}
						}
					}
					text_single = {
						text = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.Custom( 'KehillahSparkTier_talmudics' )]"
						default_format = "#weak"
						align = nobaseline
					}
					text_multi = {
						visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_work' ).IsSet, Not( EqualTo_string( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_work' ).GetFlagName, 'none' ) ) )]"
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 166
						min_width = 166
						text = "[Concatenate( Localize( 'kehillah_spark_from' ), Localize( Concatenate( 'kehillah_lib_name_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_work' ).GetFlagName ) ) )]"
						default_format = "#weak"
						align = hcenter|nobaseline
					}
				}

				### An empty slot.
				vbox = {
					visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_talmudics_form' ).IsSet )]"
					layoutpolicy_horizontal = expanding
					spacing = 6
					text_single = {
						text = "kehillah_spark_empty_slot"
						using = Font_Size_Medium
						default_format = "#weak"
						align = nobaseline
					}
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 160
						min_width = 160
						text = "kehillah_spark_empty_talmudics"
						default_format = "#weak"
						align = hcenter|nobaseline
					}
				}

				expand = {}

				### Discovery and craft: kinds found in this discipline, commentaries mastered.
				text_single = {
					text = "[Concatenate( Localize( 'kehillah_spark_kinds_found' ), Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_known_value' ) ) ), Concatenate( ' / ', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_kinds_value' ) ) ) ) ) )]"
					tooltip = "kehillah_spark_known_tt_talmudics"
					default_format = "#weak"
					align = nobaseline
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_commentaries_value' ), '(CFixedPoint)0' )]"
					text = "[Concatenate( Localize( 'kehillah_spark_commentaries' ), IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_talmudics_commentaries_value' ) ) ) )]"
					tooltip = "kehillah_spark_craft_tt_talmudics"
					default_format = "#weak"
					align = nobaseline
