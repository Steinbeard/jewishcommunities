##########################################################################
# SPARK CARDS for the Learning window (2026-11-24, Daniel: "sparks like cards
# in three columns, with a shadow and 'empty slot' ... color code the three
# genres ... upgrading the spark should be an active choice that feels good").
# GENERATED by scripts/kehillah_writing_sparks.py -- edit the script, not this.
# One card per discipline, for the character the Learning window shows
# (var:kehillah_learning_view): a coloured band, the inspiration icon, the
# spark's name, tier stars and source; on the player's own cards an Upgrade
# button (its tooltip lists the next rung's requirements; it glows when they
# are met) and Write.
##########################################################################
types KehillahSparkCards
{
	### Parshanut: a card in its own colour.
	type kehillah_spark_card_parshanut = widget {
		size = { 186 350 }

		### Drop shadow, offset down and right.
		widget = {
			position = { 5 6 }
			size = { 182 344 }
			alpha = 0.35
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.08 0.05 0.03 1 }
			}
		}

		### The card.
		widget = {
			size = { 182 344 }
			background = { using = Background_Area_Dark }
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.22 0.40 0.66 0.16 }
			}
			background = { using = Background_Frame }

			vbox = {
				size = { 100% 100% }
				margin_bottom = 10
				spacing = 6

				### Band: the discipline, in its colour.
				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 30 }
					background = {
						texture = "gfx/interface/colors/white.dds"
						color = { 0.22 0.40 0.66 0.9 }
					}
					text_single = {
						parentanchor = center
						text = "kehillah_spark_disc_parshanut"
						align = nobaseline
					}
					### Set the idea aside (asks first: kehillah_spark.0031).
					button_close = {
						visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.IsLocalPlayer )]"
						parentanchor = right|vcenter
						position = { -4 0 }
						size = { 22 22 }
						onclick = "[GetScriptedGui( 'kehillah_spark_discard_parshanut' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						tooltip = "kehillah_spark_discard_tt"
					}
				}

				widget = {
					size = { 64 64 }
					icon = {
						visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet]"
						size = { 64 64 }
						texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
					}
					icon = {
						visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet )]"
						size = { 64 64 }
						texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
						alpha = 0.18
					}
				}

				### A held spark: its name, tier and source.
				vbox = {
					visible = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet]"
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 166
						min_width = 166
						text = "[Localize( Concatenate( 'kehillah_spark_title_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).GetFlagName ) )]"
						using = Font_Size_Medium
						align = hcenter|nobaseline
					}
					hbox = {
						spacing = 2
						tooltip = "[Concatenate( Localize( 'kehillah_spark_tier_tt_prefix' ), GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.Custom( 'KehillahSparkTier_parshanut' ) )]"
				widget = {
					size = { 22 22 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
				widget = {
					size = { 22 22 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)2' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)2' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
				widget = {
					size = { 22 22 }
					icon = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
					}
					icon = {
						visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' )]"
						size = { 22 22 }
						texture = "gfx/interface/icons/flat_icons/star.dds"
						alpha = 0.2
					}
				}
						### Great Work potential: bright for a historical landmark,
						### dimmer for an original work only, faint for none.
						widget = {
							visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' )]"
							size = { 26 22 }
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_potential_value' ), '(CFixedPoint)2' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								tooltip = "kehillah_spark_potential_2"
							}
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_potential_value' ), '(CFixedPoint)1' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								alpha = 0.55
								tooltip = "kehillah_spark_potential_1"
							}
							icon = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_potential_value' ), '(CFixedPoint)0' )]"
								size = { 22 22 }
								position = { 4 0 }
								texture = "gfx/interface/icons/artifact/artifact_book.dds"
								alpha = 0.15
								tooltip = "kehillah_spark_potential_0"
							}
						}
					}
					text_single = {
						text = "[GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.Custom( 'KehillahSparkTier_parshanut' )]"
						default_format = "#weak"
						align = nobaseline
					}
					text_multi = {
						visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).IsSet, Not( EqualTo_string( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).GetFlagName, 'none' ) ) )]"
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 166
						min_width = 166
						text = "[Concatenate( Localize( 'kehillah_spark_from' ), Localize( Concatenate( 'kehillah_lib_name_', GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_work' ).GetFlagName ) ) )]"
						default_format = "#weak"
						align = hcenter|nobaseline
					}
				}

				### An empty slot.
				vbox = {
					visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet )]"
					layoutpolicy_horizontal = expanding
					spacing = 6
					text_single = {
						text = "kehillah_spark_empty_slot"
						using = Font_Size_Medium
						default_format = "#weak"
						align = nobaseline
					}
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 160
						min_width = 160
						text = "kehillah_spark_empty_parshanut"
						default_format = "#weak"
						align = hcenter|nobaseline
					}
				}

				expand = {}

				### Discovery and craft: kinds found in this discipline, commentaries mastered.
				text_single = {
					text = "[Concatenate( Localize( 'kehillah_spark_kinds_found' ), Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_known_value' ) ) ), Concatenate( ' / ', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_kinds_value' ) ) ) ) ) )]"
					tooltip = "kehillah_spark_known_tt_parshanut"
					default_format = "#weak"
					align = nobaseline
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_commentaries_value' ), '(CFixedPoint)0' )]"
					text = "[Concatenate( Localize( 'kehillah_spark_commentaries' ), IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_commentaries_value' ) ) ) )]"
					tooltip = "kehillah_spark_craft_tt_parshanut"
					default_format = "#weak"
					align = nobaseline
				}

				### Actions, on the player's own cards.
				button_standard = {
					visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.Var( 'kehillah_spark_parshanut_form' ).IsSet, And( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.IsLocalPlayer, LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)3' ) ) )]"
					size = { 156 32 }
					text = "[Concatenate( Localize( 'kehillah_spark_upgrade_button' ), Select_CString( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_tier_value' ), '(CFixedPoint)1' ), Concatenate( Localize( 'KEHILLAH_SPARK_COUNT_OPEN' ), Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_routes_met_value' ) ) ), Concatenate( '/', Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_routes_needed_value' ) ) ), Localize( 'KEHILLAH_SPARK_COUNT_CLOSE' ) ) ) ) ), Localize( 'KEHILLAH_SPARK_NOTHING' ) ) )]"
					enabled = "[GetScriptedGui( 'kehillah_spark_upgrade_parshanut' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'kehillah_spark_upgrade_parshanut' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					using = tooltip_es
					glow = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_learning_view' ).Char.MakeScope.ScriptValue( 'kehillah_spark_parshanut_ready_value' ), '(CFixedPoint)1' )]"
						glow_radius = 8
						using = Glow_Standard
						using = Color_Bright_Yellow
					}
		tooltipwidget = {
			widget = {
				using = GeneralTooltipSetup
				using = DefaultTooltipBackground
				vbox = {
					margin = { 16 12 }
					spacing = 4
					min_width = 300
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "kehillah_spark_upgrade_tt_title"
