##########################################################################
# Jewish Communities -- realm view (2026-10-28; slimmed and shortened
# 2026-10-29).
#
# Design doc: docs/spec/2026-10-28-realm-jewish-communities-view.md
# (sections 11-13 for this layout).
#
# One top-level window, registered in gui/scripted_widgets/kehillah_
# scripted_widgets.txt. It is opened by the menorah chip in the character
# window (our gui/window_character.gui override), which runs the
# kehillah_realm_view_open scripted_gui -- building every list and
# variable read below onto the PLAYER -- and then sets the
# VariableSystem flag "kehillah_realm_view_open".
#
# THE LAYOUT: an audience, read top to bottom.
#   1. the ruler being petitioned, then the three facts about them
#      (settlement policy, their faith's teaching, their outlook), each a
#      button to where that fact lives;
#   2. the petitioners: a gallery of portrait cards, six to a row,
#      most endangered first -- place and danger only (the description
#      is on hover and in the detail card);
#   3. one detail card for the selected community: name, description and
#      danger with three small icon actions (Quarter, Charter, map), then
#      local lord and three one-line pillar bars beside the Charter terms;
#   4. realm news, collapsed to a counted header.
# A free-form "room" was rejected (a datamodel lays out only in rows or
# grids) and so were per-card accordions (each card would need its own
# open state). One detail card means there is always one place to look.
#
# Two modes: the realm view (a top liege's or a Kehillah leader's chip)
# and the lord's view (a vassal's chip: the lord's own lands, a line
# naming who sets the rules, and a link up). kehillah_rv_lord is the
# ruler in the header in both; in the realm view it IS the top liege.
#
# Live lessons (map ledger header, and this window's own passes):
#   - a layer on the top-level window; header_pattern for the close button;
#   - no hbox/vbox as a direct child of a container;
#   - max_width on every text in a fixed-width box;
#   - the window has no size: the root vbox sizes it
#     (set_parent_size_to_minimum), or its background draws at 0x0;
#   - every scrolling area has a FIXED height chosen by count: one capped
#     below its content left the window reserving the full height;
#   - text_label_center draws its own dark band; plain text_single for
#     labels, and layoutpolicy_horizontal = expanding on any label meant
#     to sit left (a bare text_single in a vbox is centred);
#   - 762 px wide and centred, it ran under the character window, which
#     draws above it: 600 px, right of centre;
#   - centred vertically and grown tall, its top went off-screen: it is
#     now anchored under the top bar and grows downward, and every part
#     is shorter (2026-10-29);
#   - the font has no "▸": the expand arrow is vanilla's button_expand
#     frame (window_character.gui's diplomacy header).
##########################################################################

@rv_width = 600
@rv_scroll_width = 614
@rv_fact_w = 182
@rv_fact_h = 62
@rv_card_w = 96
@rv_card_h = 146
@rv_cell_w = 100
@rv_cell_h = 150
@rv_col_w = 268

window = {
	name = "kehillah_realm_view_window"
	parentanchor = top|hcenter
	widgetanchor = top|hcenter
	position = { 160 72 }

	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( IsDefaultGUIMode, GetVariableSystem.Exists( 'kehillah_realm_view_open' ) ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	# Vanilla's popup frame (gui/window_artifact_reforge.gui:1-27).
	using = Window_Background
	using = Window_Decoration_Spike

	# THE ROOT (2026-10-29, final cause of the height problems): a
	# flowcontainer with resizeparent, as vanilla's outliner does
	# (gui/hud_outliner.gui). It sizes the window to its children's ACTUAL
	# sizes. The earlier vbox + set_parent_size_to_minimum used their size
	# HINTS, and a scrollarea's hint includes its whole content -- so a
	# capped or scrolled list (the gallery past two rows, the news feed)
	# still made the window as tall as the full list, leaving gaps or a
	# blank band. Each hbox/vbox section is wrapped in a plain widget that
	# it sizes, because a flowcontainer may not hold an hbox/vbox directly.
	flowcontainer = {
		direction = vertical
		resizeparent = yes
		ignoreinvisible = yes
		using = Window_Margins
		margin_bottom = 20
		spacing = 10


		header_pattern = {
			blockoverride "size" { size = { @rv_width 56 } }

			blockoverride "header_text"
			{
				text = "KEHILLAH_RV_HEADER"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'kehillah_realm_view_open' )]"
			}
		}

		### =============================================================
		### 1. THE RULER, then the three facts about them:
		###   policy   -> the Jewish Settlement Policy map mode (vanilla
		###               shows no other realm's laws, and the map compares
		###               every realm's at once)
		###   teaching -> the faith window
		###   outlook  -> the ruler's character window
		### =============================================================
		widget = {
			vbox = {
				set_parent_size_to_minimum = yes
				min_width = @rv_width
				max_width = @rv_width
				datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_lord' ).Char]"
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
				spacing = 8
				margin = { 16 12 }

				background = {
					using = Background_Area_Dark
					color = { 0.16 0.14 0.12 0.8 }
					margin = { 2 2 }
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

					portrait_head_small = {}

					vbox = {
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						spacing = 4

						text_single = {
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							max_width = 440
							text = "[Character.GetShortUINameNoTooltip]"
							default_format = "#high"
							using = Font_Size_Medium
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							autoresize = yes
							min_width = 440
							max_width = 440
							text = "[SelectLocalization( GetPlayer.MakeScope.Var( 'kehillah_rv_lord_mode' ).IsSet, 'KEHILLAH_RV_LORD_SUB', 'KEHILLAH_RV_RULER_SUB' )]"
							default_format = "#weak"
						}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6

					kehillah_rv_fact = {
						datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_realm' ).Title]"
						blockoverride "fact_click" {
							enabled = "[CanChangeMapMode]"
							onclick = "[GetScriptedGui( 'kehillah_realm_jewish_policy_map_paint' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[SetMapMode( 'kehillah_realm_jewish_policy_map' )]"
						}
						blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_POLICY_TOOLTIP" }
						blockoverride "fact_label" { text = "KEHILLAH_RV_POLICY_LABEL" }
						blockoverride "fact_value" { text = "[Title.Custom( 'KehillahJewishSettlementPolicy' )]" }
						blockoverride "fact_sub" { text = "KEHILLAH_RV_POLICY_SUB" }
					}

					kehillah_rv_fact = {
						blockoverride "fact_click" {
							onclick = "[OpenGameViewData( 'faith', Character.GetFaith.Self )]"
						}
						blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_TEACHING_TOOLTIP" }
						blockoverride "fact_label" { text = "KEHILLAH_RV_TEACHING_LABEL" }
						blockoverride "fact_value" { text = "[Character.Custom( 'KehillahRvTeaching' )]" }
						blockoverride "fact_sub" { text = "[Character.Custom( 'KehillahRvTeachingTone' )]" }
					}

					kehillah_rv_fact = {
						blockoverride "fact_click" {
							onclick = "[DefaultOnCharacterClick( Character.GetID )]"
						}
						blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_OUTLOOK_TOOLTIP" }
						blockoverride "fact_label" { text = "KEHILLAH_RV_OUTLOOK_LABEL" }
						blockoverride "fact_value" { text = "[Character.Custom( 'KehillahOutlookBand' )]" }
						blockoverride "fact_sub" { text = "[Character.Custom( 'KehillahRvStance' )]" }
					}
				}
			}
		}

		### =============================================================
		### 2. THE PETITIONERS, most endangered first (ordered script-
		### side). Fixed heights by count: one row up to six, two rows
		### (scrolling past twelve) above that.
		### =============================================================
		widget = {
			hbox = {
				set_parent_size_to_minimum = yes
				min_width = @rv_width
				max_width = @rv_width
				layoutpolicy_horizontal = expanding
				margin = { 8 0 }

				text_single = {
					align = left|nobaseline
					text = "KEHILLAH_RV_COMMUNITIES_HEADER"
					default_format = "#high;bold"
				}
				expand = {}
				text_single = {
					align = right|nobaseline
					max_width = 360
					text = "KEHILLAH_RV_GALLERY_HINT"
					default_format = "#weak;italic"
					using = Font_Size_Small
				}
			}
		}

		# The outliner's own scrollarea shape (gui/hud_outliner.gui), as the
		# map ledger uses it: sizes to its content up to two rows, then
		# scrolls. (A realm with more than twelve communities overflows the
		# cap and leaves a little slack below the gallery.)
		scrollarea = {
			autoresizescrollarea = yes
			scrollbarpolicy_horizontal = always_off
			size = { @rv_scroll_width 0 }
			maximumsize = { -1 300 }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				kehillah_rv_gallery = {}
			}
		}

		### =============================================================
		### 3. THE SELECTED COMMUNITY.
		### =============================================================
		widget = {
			vbox = {
				set_parent_size_to_minimum = yes
				min_width = @rv_width
				max_width = @rv_width
				datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).Title]"
				visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).IsSet]"
				layoutpolicy_horizontal = expanding
				spacing = 10
				margin = { 18 14 }

				background = {
					using = Background_Area_Dark
					color = { 0.16 0.14 0.12 0.8 }
					margin = { 2 2 }
				}

				# Who it is; how endangered; what can be done (three quiet icons).
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 1

						text_single = {
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							max_width = 360
							text = "[Title.GetNameNoTooltip]"
							default_format = "#high;bold"
							using = Font_Size_Medium
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							max_width = 360
							text = "KEHILLAH_RV_DETAIL_SUB"
							default_format = "#weak"
							tooltip = "KEHILLAH_BD_STANDING_TOOLTIP"
							using = tooltip_ws
						}
					}

					vbox = {
						spacing = 0
						tooltip = "KEHILLAH_BD_DANGER_TOOLTIP"
						using = tooltip_ws

						text_single = {
							layoutpolicy_horizontal = expanding
							align = right|nobaseline
							max_width = 100
							text = "KEHILLAH_RV_DANGER_LABEL"
							default_format = "#weak"
							using = Font_Size_Small
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							align = right|nobaseline
							max_width = 100
							text = "[Title.GetHolder.Custom( 'KehillahDangerBand' )]"
							using = Font_Size_Medium
						}
					}

					# The actions, as small round icons (vanilla's own form for
					# secondary actions, e.g. the Subjects list's contract and
					# release buttons in shared/lists.gui), not full-width buttons.
					hbox = {
						spacing = 4

						button_round = {
							size = { 34 34 }
							enabled = "[Title.HasDomicile]"
							onclick = "[GetVariableSystem.Clear( 'kehillah_lib_selected_work' )]"
							onclick = "[ToggleGameViewData( 'domicile', Title.GetHolder.GetDomicile )]"
							tooltip = "KEHILLAH_MAP_VIEW_QUARTER_TOOLTIP"
							using = tooltip_ws

							button_icon = {
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/flat_icons/estate.dds"
								alwaystransparent = yes
							}
						}

						# The Charter is a tributary contract (kehillah_host_charter_
						# groups.txt): the host opens it on the leader with the
						# suzerain interaction; the leader, on their own community,
						# with the subject interaction on the host. Anyone else gets
						# a disabled button whose tooltip still lists the terms.
						button_round = {
							visible = "[Not( Title.GetHolder.IsLocalPlayer )]"
							size = { 34 34 }
							enabled = "[Title.GetHolder.IsPlayerInteractionValid( 'suzerain_modify_tributary_contract_interaction' )]"
							onclick = "[Title.GetHolder.OpenPlayerInteraction( 'suzerain_modify_tributary_contract_interaction' )]"
							tooltip = "KEHILLAH_RV_ROW_CHARTER_TOOLTIP"
							using = tooltip_ws

							button_add_laws = {
								alwaystransparent = yes
								parentanchor = center
							}
						}
						button_round = {
							visible = "[Title.GetHolder.IsLocalPlayer]"
							size = { 34 34 }
							enabled = "[GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.IsPlayerInteractionValid( 'subject_modify_tributary_contract_interaction' )]"
							onclick = "[GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.OpenPlayerInteraction( 'subject_modify_tributary_contract_interaction' )]"
							tooltip = "KEHILLAH_RV_ROW_CHARTER_TOOLTIP_OWN"
							using = tooltip_ws

							button_add_laws = {
								alwaystransparent = yes
								parentanchor = center
							}
						}

						button_round = {
							size = { 34 34 }
							enabled = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.IsValid]"
							onclick = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.GetProvince.ZoomCameraTo]"
							tooltip = "KEHILLAH_MAP_VIEW_LOCATE_TOOLTIP"
							using = tooltip_ws

							button_icon = {
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/flat_icons/go_to_my_location.dds"
								alwaystransparent = yes
							}
						}
					}
				}

				divider_light = {
					layoutpolicy_horizontal = expanding
				}

				# Left: the local lord, then the three pillars as one-line bars
				# in the holding card's colours. Right: the Charter's terms.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					vbox = {
						min_width = @rv_col_w
						max_width = @rv_col_w
						spacing = 5

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							tooltip = "KEHILLAH_RV_ROW_LORD_TOOLTIP"
							using = tooltip_ws

							text_single = { align = left|nobaseline text = "KEHILLAH_RV_COL_LORD" default_format = "#weak" alwaystransparent = yes }
							text_single = { align = left|nobaseline max_width = 180 text = "KEHILLAH_RV_LORD_LINE" alwaystransparent = yes }
							expand = {}
						}

						# Prosperity on one line: name, the holding card's bar, tier.
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							tooltip = "KEHILLAH_BD_PROSPERITY_TOOLTIP"
							using = tooltip_ws
							text_single = { min_width = 76 max_width = 76 align = left|nobaseline text = "KEHILLAH_RV_PILLAR_PROSPERITY" fontcolor = { 0.537255 0.709804 0.584314 1 } alwaystransparent = yes }
							widget = {
								size = { 132 16 }
								alwaystransparent = yes
								background = {
									texture = "gfx/interface/progressbars/kehillah_prosperity.dds"
									spriteType = Corneredstretched
									spriteborder = { 2 2 }
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue]"
									visible = "[LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)150' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_red.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)150' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)400' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_orange.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)400' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)700' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_standard.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue]"
									visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)700' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_green.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
							}
							text_single = { min_width = 44 max_width = 44 align = right|nobaseline text = "[Title.Custom( 'KehillahProsperityBandName' )]" fontcolor = { 0.537255 0.709804 0.584314 1 } using = Font_Size_Small alwaystransparent = yes }
						}
						# Stability on one line: name, the holding card's bar, tier.
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							tooltip = "KEHILLAH_BD_STABILITY_TOOLTIP"
							using = tooltip_ws
							text_single = { min_width = 76 max_width = 76 align = left|nobaseline text = "KEHILLAH_RV_PILLAR_STABILITY" fontcolor = { 0.576471 0.666667 0.756863 1 } alwaystransparent = yes }
							widget = {
								size = { 132 16 }
								alwaystransparent = yes
								background = {
									texture = "gfx/interface/progressbars/kehillah_stability.dds"
									spriteType = Corneredstretched
									spriteborder = { 2 2 }
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue]"
									visible = "[LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)150' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_red.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)150' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)400' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_orange.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)400' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)700' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_standard.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue]"
									visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue, '(CFixedPoint)700' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_green.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
							}
							text_single = { min_width = 44 max_width = 44 align = right|nobaseline text = "[Title.Custom( 'KehillahStabilityBandName' )]" fontcolor = { 0.576471 0.666667 0.756863 1 } using = Font_Size_Small alwaystransparent = yes }
						}
						# Greatness on one line: name, the holding card's bar, tier.
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							tooltip = "KEHILLAH_BD_GREATNESS_TOOLTIP"
							using = tooltip_ws
							text_single = { min_width = 76 max_width = 76 align = left|nobaseline text = "KEHILLAH_RV_PILLAR_GREATNESS" fontcolor = { 0.843137 0.741176 0.525490 1 } alwaystransparent = yes }
							widget = {
								size = { 132 16 }
								alwaystransparent = yes
								background = {
									texture = "gfx/interface/progressbars/kehillah_greatness.dds"
									spriteType = Corneredstretched
									spriteborder = { 2 2 }
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue]"
									visible = "[LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)150' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_red.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)150' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)400' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_orange.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue]"
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)400' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)700' ) )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_standard.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
								progressbar_standard = {
									parentanchor = center
									size = { 128 12 }
									min = 0
									max = 1000
									value = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue]"
									visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue, '(CFixedPoint)700' )]"
									blockoverride "progress_textures" {
										progresstexture = "gfx/interface/progressbars/progress_green.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
									}
									alwaystransparent = yes
								}
							}
							text_single = { min_width = 44 max_width = 44 align = right|nobaseline text = "[Title.Custom( 'KehillahGreatnessBandName' )]" fontcolor = { 0.843137 0.741176 0.525490 1 } using = Font_Size_Small alwaystransparent = yes }
						}
						expand = {}
					}

					vbox = {
						min_width = @rv_col_w
						max_width = @rv_col_w
						spacing = 2

						text_single = { layoutpolicy_horizontal = expanding align = left|nobaseline max_width = @rv_col_w text = "KEHILLAH_RV_COL_CHARTER" default_format = "#weak" }
						text_multi = {
							layoutpolicy_horizontal = expanding
							autoresize = yes
							min_width = @rv_col_w
							max_width = @rv_col_w
							text = "KEHILLAH_DOMAIN_CHARTER_TERMS"
							using = Font_Size_Small
						}
						expand = {}
					}
				}
			}
		}

		### =============================================================
		### 4. REALM NEWS: a panel of FIXED height that scrolls inside
		### itself (2026-10-29). Both earlier forms -- a collapsible list,
		### then an auto-sizing one capped at 140 px -- made the window
		### reserve the whole list's height, leaving a blank band below it
		### once the feed filled (Daniel, with 15 entries). A fixed size
		### does not depend on its content, so the window cannot grow with
		### the feed. Fifteen fixed slots, each hidden unless the build
		### marked it to show (kehillah_rv_news_slot_effect: in range, and
		### in the lord's lands in the lord's view); each line is fixed
		### columns, eliding long text, with the event on hover.
		### =============================================================
		widget = {
			hbox = {
				set_parent_size_to_minimum = yes
				min_width = @rv_width
				max_width = @rv_width
				layoutpolicy_horizontal = expanding
				margin = { 8 0 }
				tooltip = "KEHILLAH_RV_NEWS_TOOLTIP"
				using = tooltip_ws

				text_single = {
					align = left|nobaseline
					text = "KEHILLAH_RV_NEWS_HEADER"
					default_format = "#high;bold"
				}
				expand = {}
			}
		}

		# size alone did not hold: in a layout the scrollarea grew to its
		# content (live, 15 entries, no scrollbar). Pinned three ways.
		scrollarea = {
			scrollbarpolicy_horizontal = always_off
			layoutpolicy_vertical = fixed
			size = { @rv_scroll_width 120 }
			minimumsize = { -1 120 }
			maximumsize = { -1 120 }

			background = {
				using = Background_Area_Dark
				color = { 0.12 0.11 0.10 0.6 }
				margin = { 2 2 }
			}

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_realm' ).Title]"
					set_parent_size_to_minimum = yes
					ignoreinvisible = yes
					min_width = @rv_width
					max_width = @rv_width
					margin_top = 4
					spacing = 2

					text_single = {
						visible = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_rv_news_count' ).GetValue, '(CFixedPoint)0' )]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						margin_left = 12
						max_width = 580
						text = "KEHILLAH_RV_NEWS_EMPTY"
						default_format = "#weak;italic"
					}

					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_1' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_1_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_1_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_1_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_1_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_2' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_2_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_2_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_2_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_2_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_3' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_3_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_3_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_3_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_3_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_4' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_4_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_4_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_4_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_4_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_5' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_5_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_5_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_5_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_5_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_6' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_6_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_6_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_6_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_6_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_7' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_7_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_7_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_7_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_7_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_8' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_8_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_8_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_8_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_8_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_9' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_9_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_9_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_9_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_9_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_10' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_10_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_10_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_10_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_10_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_11' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_11_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_11_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_11_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_11_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_12' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_12_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_12_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_12_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_12_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_13' ).IsSet]" }
						blockoverride "news_tooltip" { tooltip = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_13_kind' ).GetFlagName ) )]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_13_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_13_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_13_kind' ).GetFlagName ) )]" }
