				}
			}
		}

		### Up from the lord's view to the whole realm.
		button_standard = {
			visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_lord_mode' ).IsSet]"
			size = { @rv_width 28 }
			text = "KEHILLAH_RV_VIEW_REALM"
			onclick = "[GetScriptedGui( 'kehillah_realm_view_open' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.MakeScope ).End )]"
			tooltip = "KEHILLAH_RV_VIEW_REALM_TOOLTIP"
			using = tooltip_ws
		}
	}

}

types KehillahRealmView
{
	### One fact about the ruler: a button, so it shows vanilla's hover
	### frame (button_standard_hover with a box inside is vanilla's own
	### clickable-panel form, window_character.gui's titles toggle). Its
	### texts are alwaystransparent so the click reaches the button.
	type kehillah_rv_fact = button_standard_hover {
		size = { @rv_fact_w @rv_fact_h }
		using = tooltip_se

		block "fact_click" {}
		block "fact_tooltip" {}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 1
			margin = { 6 5 }

			text_single = {
				alwaystransparent = yes
				align = center|nobaseline
				max_width = 170
				default_format = "#weak"
				using = Font_Size_Small
				block "fact_label" { text = "" }
			}
			text_single = {
				alwaystransparent = yes
				align = center|nobaseline
				max_width = 170
				using = Font_Size_Medium
				block "fact_value" { text = "" }
			}
			text_single = {
				alwaystransparent = yes
				align = center|nobaseline
				max_width = 170
				default_format = "#weak"
				using = Font_Size_Small
				block "fact_sub" { text = "" }
			}
		}
	}

	### One pillar's bar in the holding card's form (window_county_view.gui's
	### community card): the pillar's coloured frame around a bar coloured
	### by band (red < 150, orange < 400, standard < 700, green). The
	### instance names the frame, the value and each band's visibility.
	### Full width of a kehillah_pillar_section (512 px).
	type kehillah_pillar_bar = widget {
		size = { 512 16 }
		alwaystransparent = yes

		background = {
			block "bar_frame" { texture = "gfx/interface/progressbars/kehillah_prosperity.dds" }
			spriteType = Corneredstretched
			spriteborder = { 2 2 }
		}
		progressbar_standard = {
			parentanchor = center
			size = { 508 12 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_red" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_red.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 508 12 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_orange" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_orange.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 508 12 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_standard" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_standard.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 508 12 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_green" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_green.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
	}

	### One pillar in My Realm's Domain overview for a Kehillah leader: a
	### header row (name; score and tier), the bar, and one line under it
	### (baseline and drift, and what the band does). The breakdown is the
	### whole row's tooltip. 512 px wide; datacontext: the community title.
	type kehillah_pillar_section = vbox {
		min_width = 512
		max_width = 512
		spacing = 4
		using = tooltip_se

		block "section_tooltip" {}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8

			text_single = {
				align = left|nobaseline
				max_width = 200
				using = Font_Size_Medium
				block "section_name" { text = "" }
			}
			expand = {}
			text_single = {
				align = right|nobaseline
				max_width = 300
				using = Font_Size_Medium
				block "section_stats" { text = "" }
			}
		}

		block "section_bar" {}

		text_single = {
			layoutpolicy_horizontal = expanding
			max_width = 512
			align = left|nobaseline
			using = Font_Size_Small
			block "section_note" { text = "" }
		}
	}

	### One resource in the Domain tab's Monthly Income, in the form of
	### vanilla's domicile overview (gui/window_domicile.gui, "Overview
	### Resources"): icon and the month's total, what the Quarter's
	### buildings give, and the pillar band that scales it.
	type kehillah_income_tile = vbox {
		min_width = 150
		max_width = 150
		spacing = 2
		using = tooltip_se
		block "tile_tooltip" {}

		hbox = {
			spacing = 6
			icon = {
				size = { 30 30 }
				block "tile_icon" { texture = "gfx/interface/icons/icon_gold.dds" }
			}
			text_single = {
				align = left|nobaseline
				max_width = 110
				using = Font_Size_Big
				block "tile_total" { text = "" }
			}
		}
		text_single = {
			align = center|nobaseline
			max_width = 150
			using = Font_Size_Small
			using = tooltip_se
			block "tile_quarter" { text = "" }
		}
		text_single = {
			align = center|nobaseline
			max_width = 150
			using = Font_Size_Small
			block "tile_pillar" { text = "" }
		}
	}

	### The gallery: a grid of petitioners, six to a row.
	type kehillah_rv_gallery = fixedgridbox {
		datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_rv_list' )]"
		addcolumn = @rv_cell_w
		addrow = @rv_cell_h
		datamodel_wrap = 6
		flipdirection = yes

		item = {
			kehillah_rv_card = {}
		}
	}

	### One petitioner. datacontext: the d_kehillah_* title from
	### kehillah_rv_list. Click selects it for the detail card; the
	### selected card stays pressed (down). The portrait is
	### alwaystransparent -- it propagates to the portrait's own button --
	### so a click anywhere on the card selects instead of opening the
	### leader. The description is on hover, not on the card.
	type kehillah_rv_card = widget {
		datacontext = "[Scope.Title]"
		size = { @rv_cell_w @rv_cell_h }

		button_standard_hover = {
			parentanchor = center
			size = { @rv_card_w @rv_card_h }
			down = "[ObjectsEqual( GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).Title, Title.Self )]"
			onclick = "[GetScriptedGui( 'kehillah_realm_view_select' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Title.MakeScope ).End )]"
			tooltip = "KEHILLAH_RV_CARD_TOOLTIP"
			using = tooltip_ws

			# Tense or worse: a red band across the foot of the card.
			widget = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_incident_yearly_chance_value' ), '(CFixedPoint)8' )]"
				parentanchor = bottom|hcenter
				position = { 0 -3 }
				size = { 84 3 }
				alwaystransparent = yes
				background = {
					using = Background_Area_Solid
					color = { 0.7 0.18 0.14 0.9 }
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 3 6 }
				spacing = 2

				widget = {
					size = { 85 90 }
					visible = "[Title.HasHolder]"
					datacontext = "[Title.GetHolder]"
					alwaystransparent = yes

					portrait_head_small = {
						alwaystransparent = yes
					}
				}

				text_single = {
					alwaystransparent = yes
					align = center|nobaseline
					max_width = 90
					text = "KEHILLAH_RV_CARD_NAME"
					default_format = "#high"
				}
				expand = {}
				text_single = {
					alwaystransparent = yes
					align = center|nobaseline
					max_width = 90
					text = "[Title.GetHolder.Custom( 'KehillahDangerBand' )]"
					using = Font_Size_Small
				}
			}
		}
	}

	### One news line: year, place, what happened. datacontext: the realm
	### title. Each instance names its slot through the blocks. Fixed
	### columns summing to the window's width; the text elides and the
	### event is on hover.
	type kehillah_rv_news_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 8
		margin = { 12 2 }
		using = tooltip_ws

		block "news_visible" { visible = no }
		block "news_tooltip" {}

		text_single = {
			min_width = 40
			max_width = 40
			align = left|nobaseline
			default_format = "#weak"
			block "news_year" { text = "" }
		}
		text_single = {
			min_width = 104
			max_width = 104
			align = left|nobaseline
			default_format = "#high"
			block "news_place" { text = "" }
		}
		text_single = {
			min_width = 404
			max_width = 404
			align = left|nobaseline
			block "news_text" { text = "" }
		}
	}
}
