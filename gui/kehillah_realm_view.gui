##########################################################################
# Jewish Communities -- realm view (2026-10-28).
#
# Design doc: docs/spec/2026-10-28-realm-jewish-communities-view.md
# (section 11 for this layout).
#
# One top-level window, registered in gui/scripted_widgets/kehillah_
# scripted_widgets.txt. It is opened by the menorah chip in the character
# window (our gui/window_character.gui override), which runs the
# kehillah_realm_view_open scripted_gui -- building every list and
# variable read below onto the PLAYER -- and then sets the
# VariableSystem flag "kehillah_realm_view_open".
#
# THE LAYOUT: an audience. Read top to bottom:
#   1. the ruler being petitioned, with the three facts about them
#      (settlement policy, their faith's teaching, their outlook);
#   2. the petitioners: a gallery of community leaders, most endangered
#      first, each card holding only name, description and danger;
#   3. one detail card for the community selected in the gallery
#      (everything else: local lord, pillars, Charter, actions);
#   4. realm news, collapsed to a header with its count.
# This replaced a ten-column table (Daniel, 2026-10-28: "more cluttered
# and confusing"). A free-form "room" was rejected because a datamodel
# lays out only in rows or grids; per-card accordions because each card
# would need its own open state and several open at once is the clutter
# again. One detail card means there is always one place to look.
#
# Two modes, one window. The realm view (a top liege's or a Kehillah
# leader's chip) and the lord's view (a vassal's chip): the lord's view
# is the same window over the lord's own lands, with a line naming who
# sets the rules and a link up to the realm view. kehillah_rv_lord is the
# ruler in the header in both: in the realm view it IS the top liege.
#
# Live lessons kept from the map ledger (gui/kehillah_community_map_
# view.gui header) and from this window's own first passes:
#   - a layer on the top-level window; header_pattern for the close button;
#   - no hbox/vbox as a direct child of a container;
#   - max_width on every text in a fixed-width box;
#   - the window has no size: the root vbox sizes it
#     (set_parent_size_to_minimum), or its background draws at 0x0;
#   - a scrollarea capped below its content's height leaves the window
#     reserving the full height as a gap (France, 8 tall rows): every
#     scrolling area here has a FIXED height instead, picked by count;
#   - text_label_center draws its own dark band; plain text_single for
#     labels.
##########################################################################

@rv_width = 762
@rv_scroll_width = 776
@rv_fact = 168
@rv_fact_height = 70
@rv_card_w = 120
@rv_card_h = 172
@rv_cell_w = 126
@rv_cell_h = 178
@rv_detail_col = 244

window = {
	name = "kehillah_realm_view_window"
	parentanchor = center
	widgetanchor = center
	position = { 0 -40 }

	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( IsDefaultGUIMode, GetVariableSystem.Exists( 'kehillah_realm_view_open' ) ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	# Vanilla's popup frame (gui/window_artifact_reforge.gui:1-27).
	using = Window_Background
	using = Window_Decoration_Spike

	vbox = {
		set_parent_size_to_minimum = yes
		using = Window_Margins
		margin_bottom = 24
		spacing = 10
		min_width = @rv_width

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_RV_HEADER"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'kehillah_realm_view_open' )]"
			}
		}

		### =============================================================
		### 1. THE RULER. Portrait (vanilla click opens them), name, one
		### line of summary, and three facts. Each fact is a button that
		### goes where that fact lives:
		###   policy   -> the player's laws tab, where the policy is shown
		###               among the laws (window_my_realm.gui)
		###   teaching -> the faith window
		###   outlook  -> the ruler's character window
		### =============================================================
		hbox = {
			datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_lord' ).Char]"
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 6 6 }

			background = {
				using = Background_Area_Dark
				color = { 0.16 0.14 0.12 0.8 }
				margin = { 2 2 }
			}

			portrait_head_small = {}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left
					max_width = 220
					text = "[Character.GetShortUINameNoTooltip]"
					default_format = "#high"
					using = Font_Size_Medium
				}
				text_multi = {
					visible = "[Not( GetPlayer.MakeScope.Var( 'kehillah_rv_lord_mode' ).IsSet )]"
					autoresize = yes
					min_width = 220
					max_width = 220
					text = "KEHILLAH_RV_RULER_SUB"
					default_format = "#weak"
				}
				text_multi = {
					visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_lord_mode' ).IsSet]"
					autoresize = yes
					min_width = 220
					max_width = 220
					text = "KEHILLAH_RV_LORD_SUB"
					default_format = "#weak"
				}
			}

			kehillah_rv_fact = {
				datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_realm' ).Title]"
				# Opens the player's own laws tab, where our window_my_realm.gui
				# override shows the Jewish settlement policy (the realm's
				# top liege's) among the laws -- so only for a landed player
				# inside this realm; vanilla has no window for another
				# realm's laws.
				blockoverride "fact_click" {
					enabled = "[And( GetPlayer.HasLandedTitles, ObjectsEqual( GetPlayer.GetTopLiege, GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char ) )]"
					onclick = "[ToggleGameViewData( 'my_realm', 'bookmark_laws' )]"
				}
				blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_POLICY_TOOLTIP" }
				blockoverride "fact_label" { text = "KEHILLAH_RV_POLICY_LABEL" }
				blockoverride "fact_value" { text = "[Title.Custom( 'KehillahJewishSettlementPolicy' )]" }
				blockoverride "fact_sub" { text = "KEHILLAH_RV_POLICY_SUB" }
			}

			kehillah_rv_fact = {
				blockoverride "fact_click" {
					onclick = "[OpenGameViewData( 'faith', Character.GetFaith.Self )]"
				}
				blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_TEACHING_TOOLTIP" }
				blockoverride "fact_label" { text = "KEHILLAH_RV_TEACHING_LABEL" }
				blockoverride "fact_value" { text = "[Character.Custom( 'KehillahRvTeaching' )]" }
				blockoverride "fact_sub" { text = "[Character.Custom( 'KehillahRvTeachingTone' )]" }
			}

			kehillah_rv_fact = {
				blockoverride "fact_click" {
					onclick = "[DefaultOnCharacterClick( Character.GetID )]"
				}
				blockoverride "fact_tooltip" { tooltip = "KEHILLAH_RV_OUTLOOK_TOOLTIP" }
				blockoverride "fact_label" { text = "KEHILLAH_RV_OUTLOOK_LABEL" }
				blockoverride "fact_value" { text = "[Character.Custom( 'KehillahOutlookBand' )]" }
				blockoverride "fact_sub" { text = "[Character.Custom( 'KehillahRvStance' )]" }
			}
		}

		### =============================================================
		### 2. THE PETITIONERS, most endangered first (ordered script-
		### side). Fixed-height areas picked by count: one row for up to
		### six, two rows (scrolling past twelve) above that.
		### =============================================================
		hbox = {
			layoutpolicy_horizontal = expanding

			text_single = {
				text = "KEHILLAH_RV_COMMUNITIES_HEADER"
				default_format = "#high;bold"
			}
			expand = {}
			text_single = {
				text = "KEHILLAH_RV_GALLERY_HINT"
				default_format = "#weak;italic"
				using = Font_Size_Small
			}
		}

		scrollarea = {
			visible = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_rv_count' ).GetValue, '(CFixedPoint)6' )]"
			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = always_off
			size = { @rv_scroll_width @rv_cell_h }

			scrollwidget = {
				kehillah_rv_gallery = {}
			}
		}

		scrollarea = {
			visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_rv_count' ).GetValue, '(CFixedPoint)6' )]"
			scrollbarpolicy_horizontal = always_off
			size = { @rv_scroll_width 356 }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				kehillah_rv_gallery = {}
			}
		}

		### =============================================================
		### 3. THE SELECTED COMMUNITY.
		### =============================================================
		vbox = {
			datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).Title]"
			visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).IsSet]"
			layoutpolicy_horizontal = expanding
			spacing = 8
			margin = { 12 10 }

			background = {
				using = Background_Area_Dark
				color = { 0.16 0.14 0.12 0.8 }
				margin = { 2 2 }
			}

			# Name, leader and place; its description; its danger.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				vbox = {
					spacing = 1

					text_single = {
						align = left
						max_width = 560
						text = "[Title.GetNameNoTooltip]"
						default_format = "#high;bold"
						using = Font_Size_Medium
					}
					text_single = {
						align = left
						max_width = 560
						text = "KEHILLAH_RV_DETAIL_SUB"
						default_format = "#weak"
					}
					text_single = {
						align = left
						max_width = 560
						text = "[Title.Custom( 'KehillahInspectorCommunityDescription' )]"
						default_format = "#high;italic"
						tooltip = "KEHILLAH_BD_STANDING_TOOLTIP"
						using = tooltip_ws
					}
				}

				expand = {}

				vbox = {
					spacing = 1
					tooltip = "KEHILLAH_BD_DANGER_TOOLTIP"
					using = tooltip_ws

					text_single = {
						align = right
						max_width = 150
						text = "KEHILLAH_RV_DANGER_LABEL"
						default_format = "#weak"
						using = Font_Size_Small
					}
					text_single = {
						align = right
						max_width = 150
						text = "[Title.GetHolder.Custom( 'KehillahDangerBand' )]"
						using = Font_Size_Medium
					}
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			# Three facts about it, side by side.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				vbox = {
					min_width = @rv_detail_col
					max_width = @rv_detail_col
					spacing = 2
					tooltip = "KEHILLAH_RV_ROW_LORD_TOOLTIP"
					using = tooltip_ws

					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_COL_LORD" default_format = "#weak" using = Font_Size_Small }
					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_ROW_LORD" }
					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_ROW_LORD_OUTLOOK" }
					expand = {}
				}

				vbox = {
					min_width = @rv_detail_col
					max_width = @rv_detail_col
					spacing = 2

					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_PILLARS_LABEL" default_format = "#weak" using = Font_Size_Small }
					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_PILLAR_PROSPERITY" tooltip = "KEHILLAH_BD_PROSPERITY_TOOLTIP" using = tooltip_ws }
					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_PILLAR_STABILITY" tooltip = "KEHILLAH_BD_STABILITY_TOOLTIP" using = tooltip_ws }
					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_PILLAR_GREATNESS" tooltip = "KEHILLAH_BD_GREATNESS_TOOLTIP" using = tooltip_ws }
					expand = {}
				}

				vbox = {
					min_width = @rv_detail_col
					max_width = @rv_detail_col
					spacing = 2

					text_single = { align = left max_width = @rv_detail_col text = "KEHILLAH_RV_COL_CHARTER" default_format = "#weak" using = Font_Size_Small }
					text_multi = {
						autoresize = yes
						min_width = @rv_detail_col
						max_width = @rv_detail_col
						text = "KEHILLAH_DOMAIN_CHARTER_TERMS"
						using = Font_Size_Small
					}
					expand = {}
				}
			}

			# What can be done about it.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				button_standard = {
					size = { 170 30 }
					text = "KEHILLAH_RV_BTN_LEADER"
					enabled = "[Title.HasHolder]"
					onclick = "[DefaultOnCharacterClick( Title.GetHolder.GetID )]"
				}

				button_standard = {
					size = { 170 30 }
					text = "KEHILLAH_RV_BTN_QUARTER"
					enabled = "[Title.HasDomicile]"
					onclick = "[GetVariableSystem.Clear( 'kehillah_lib_selected_work' )]"
					onclick = "[ToggleGameViewData( 'domicile', Title.GetHolder.GetDomicile )]"
					tooltip = "KEHILLAH_MAP_VIEW_QUARTER_TOOLTIP"
					using = tooltip_nw
				}

				# The Charter is a tributary contract (kehillah_host_charter_
				# groups.txt): the host opens it on the leader with the
				# suzerain interaction; the leader, on their own community,
				# with the subject interaction on the host. Anyone else gets a
				# disabled button whose tooltip still lists the terms.
				button_standard = {
					visible = "[Not( Title.GetHolder.IsLocalPlayer )]"
					size = { 170 30 }
					text = "KEHILLAH_RV_BTN_CHARTER"
					enabled = "[Title.GetHolder.IsPlayerInteractionValid( 'suzerain_modify_tributary_contract_interaction' )]"
					onclick = "[Title.GetHolder.OpenPlayerInteraction( 'suzerain_modify_tributary_contract_interaction' )]"
					tooltip = "KEHILLAH_RV_ROW_CHARTER_TOOLTIP"
					using = tooltip_nw
				}
				button_standard = {
					visible = "[Title.GetHolder.IsLocalPlayer]"
					size = { 170 30 }
					text = "KEHILLAH_RV_BTN_CHARTER"
					enabled = "[GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.IsPlayerInteractionValid( 'subject_modify_tributary_contract_interaction' )]"
					onclick = "[GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.OpenPlayerInteraction( 'subject_modify_tributary_contract_interaction' )]"
					tooltip = "KEHILLAH_RV_ROW_CHARTER_TOOLTIP_OWN"
					using = tooltip_nw
				}

				button_standard = {
					size = { 170 30 }
					text = "KEHILLAH_RV_BTN_MAP"
					enabled = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.IsValid]"
					onclick = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.GetProvince.ZoomCameraTo]"
					tooltip = "KEHILLAH_MAP_VIEW_LOCATE_TOOLTIP"
					using = tooltip_nw
				}

				expand = {}
			}
		}

		### =============================================================
		### 4. REALM NEWS, collapsed by default to its header and count.
		### Fifteen fixed slots, each hidden unless the build marked it
		### to show (kehillah_rv_news_slot_effect: in range, and in the
		### lord's lands in the lord's view).
		### =============================================================
		button_standard_hover = {
			layoutpolicy_horizontal = expanding
			size = { 0 30 }
			onclick = "[GetVariableSystem.Toggle( 'kehillah_rv_news_open' )]"
			tooltip = "KEHILLAH_RV_NEWS_TOOLTIP"
			using = tooltip_ws

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 8 0 }
				spacing = 6

				text_single = {
					alwaystransparent = yes
					text = "[SelectLocalization( GetVariableSystem.Exists( 'kehillah_rv_news_open' ), 'KEHILLAH_RV_NEWS_HEADER_OPEN', 'KEHILLAH_RV_NEWS_HEADER_CLOSED' )]"
					default_format = "#high;bold"
				}
				expand = {}
			}
		}

		text_single = {
			visible = "[And( GetVariableSystem.Exists( 'kehillah_rv_news_open' ), LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_rv_news_count' ).GetValue, '(CFixedPoint)0' ) )]"
			text = "KEHILLAH_RV_NEWS_EMPTY"
			default_format = "#weak;italic"
			max_width = @rv_width
		}

		scrollarea = {
			visible = "[And( GetVariableSystem.Exists( 'kehillah_rv_news_open' ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_rv_news_count' ).GetValue, '(CFixedPoint)0' ) )]"
			scrollbarpolicy_horizontal = always_off
			size = { @rv_scroll_width 160 }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_rv_realm' ).Title]"
					set_parent_size_to_minimum = yes
					min_width = @rv_width
					margin_right = 12
					spacing = 2

					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_1' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_1_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_1_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_1_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_2' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_2_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_2_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_2_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_3' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_3_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_3_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_3_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_4' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_4_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_4_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_4_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_5' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_5_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_5_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_5_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_6' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_6_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_6_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_6_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_7' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_7_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_7_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_7_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_8' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_8_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_8_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_8_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_9' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_9_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_9_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_9_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_10' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_10_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_10_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_10_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_11' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_11_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_11_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_11_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_12' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_12_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_12_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_12_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_13' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_13_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_13_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_13_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_14' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_14_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_14_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_14_kind' ).GetFlagName ) )]" }
					}
					kehillah_rv_news_row = {
						blockoverride "news_visible" { visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_news_15' ).IsSet]" }
						blockoverride "news_year" { text = "[Title.MakeScope.Var( 'kehillah_news_15_year' ).GetValue|0]" }
						blockoverride "news_place" { text = "[Title.MakeScope.Var( 'kehillah_news_15_county' ).Title.GetNameNoTierNoTooltip]" }
						blockoverride "news_text" { text = "[Localize( Concatenate( 'kehillah_news_kind_', Title.MakeScope.Var( 'kehillah_news_15_kind' ).GetFlagName ) )]" }
					}
				}
			}
		}

		### Up from the lord's view to the whole realm.
		button_standard = {
			visible = "[GetPlayer.MakeScope.Var( 'kehillah_rv_lord_mode' ).IsSet]"
			layoutpolicy_horizontal = expanding
			size = { 0 30 }
			text = "KEHILLAH_RV_VIEW_REALM"
			onclick = "[GetScriptedGui( 'kehillah_realm_view_open' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', GetPlayer.MakeScope.Var( 'kehillah_rv_top' ).Char.MakeScope ).End )]"
			tooltip = "KEHILLAH_RV_VIEW_REALM_TOOLTIP"
			using = tooltip_ws
		}
	}
}

types KehillahRealmView
{
	### One fact about the ruler: a button, so it shows vanilla's hover
	### frame (button_standard_hover with a box inside is vanilla's own
	### clickable-panel form, window_character.gui's titles toggle). Its
	### texts are alwaystransparent so the click reaches the button. The
	### height fits three lines (the first pass's 74 spilled at 1080p).
	type kehillah_rv_fact = button_standard_hover {
		size = { @rv_fact @rv_fact_height }
		using = tooltip_se

		block "fact_click" {}
		block "fact_tooltip" {}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 1
			margin = { 4 4 }

			text_single = {
				alwaystransparent = yes
				align = center
				max_width = @rv_fact
				default_format = "#weak"
				using = Font_Size_Small
				block "fact_label" { text = "" }
			}
			text_single = {
				alwaystransparent = yes
				align = center
				max_width = @rv_fact
				using = Font_Size_Medium
				block "fact_value" { text = "" }
			}
			text_single = {
				alwaystransparent = yes
				align = center
				max_width = @rv_fact
				default_format = "#weak"
				using = Font_Size_Small
				block "fact_sub" { text = "" }
			}
		}
	}

	### The gallery: a grid of petitioners, six to a row.
	type kehillah_rv_gallery = fixedgridbox {
		datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_rv_list' )]"
		addcolumn = @rv_cell_w
		addrow = @rv_cell_h
		datamodel_wrap = 6
		flipdirection = yes

		item = {
			kehillah_rv_card = {}
		}
	}

	### One petitioner. datacontext: the d_kehillah_* title from
	### kehillah_rv_list. Click selects it for the detail card; the
	### selected card stays pressed (down). The portrait is
	### alwaystransparent -- it propagates to the portrait's own button --
	### so a click anywhere on the card selects instead of opening the
	### leader (the detail card has "Open leader").
	type kehillah_rv_card = widget {
		datacontext = "[Scope.Title]"
		size = { @rv_cell_w @rv_cell_h }

		button_standard_hover = {
			parentanchor = center
			size = { @rv_card_w @rv_card_h }
			down = "[ObjectsEqual( GetPlayer.MakeScope.Var( 'kehillah_rv_selected' ).Title, Title.Self )]"
			onclick = "[GetScriptedGui( 'kehillah_realm_view_select' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Title.MakeScope ).End )]"
			tooltip = "KEHILLAH_RV_CARD_TOOLTIP"
			using = tooltip_ws

			# Tense or worse: a red band across the foot of the card.
			widget = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_incident_yearly_chance_value' ), '(CFixedPoint)8' )]"
				parentanchor = bottom|hcenter
				position = { 0 -3 }
				size = { 108 3 }
				alwaystransparent = yes
				background = {
					using = Background_Area_Solid
					color = { 0.7 0.18 0.14 0.9 }
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 4 6 }
				spacing = 2

				widget = {
					size = { 85 90 }
					visible = "[Title.HasHolder]"
					datacontext = "[Title.GetHolder]"
					alwaystransparent = yes

					portrait_head_small = {
						alwaystransparent = yes
					}
				}

				text_single = {
					alwaystransparent = yes
					align = center
					max_width = 112
					text = "KEHILLAH_RV_CARD_NAME"
					default_format = "#high"
				}
				text_multi = {
					alwaystransparent = yes
					autoresize = yes
					align = center
					min_width = 112
					max_width = 112
					max_height = 34
					text = "[Title.Custom( 'KehillahInspectorCommunityDescription' )]"
					default_format = "#weak;italic"
					using = Font_Size_Small
				}
				expand = {}
				text_single = {
					alwaystransparent = yes
					align = center
					max_width = 112
					text = "[Title.GetHolder.Custom( 'KehillahDangerBand' )]"
					using = Font_Size_Small
				}
			}
		}
	}

	### One news line: year, place, what happened. datacontext: the realm
	### title. Each instance names its slot through the blocks.
	type kehillah_rv_news_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 8
		margin = { 4 2 }

		block "news_visible" { visible = no }

		text_single = {
			min_width = 44
			max_width = 44
			align = left
			default_format = "#weak"
			block "news_year" { text = "" }
		}
		text_single = {
			min_width = 120
			max_width = 120
			align = left
			default_format = "#high"
			block "news_place" { text = "" }
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			max_width = 560
			align = left
			block "news_text" { text = "" }
		}
	}
}
