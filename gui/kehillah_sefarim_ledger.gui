		### Column heads, at the rows' own x positions.
		widget = {
			size = { @ledger_row_w 22 }
			text_single = { position = { 32 2 } text = "KEHILLAH_SEFARIM_COL_WORK" default_format = "#weak" }
			text_single = { position = { 298 2 } text = "KEHILLAH_SEFARIM_COL_WRITTEN" default_format = "#weak" }
			text_single = { position = { 388 2 } text = "KEHILLAH_SEFARIM_COL_LANGUAGE" default_format = "#weak" }
			text_single = { position = { 478 2 } text = "KEHILLAH_SEFARIM_COL_AUTHOR" default_format = "#weak" }
			text_single = { position = { 620 2 } text = "KEHILLAH_SEFARIM_COL_STANDING" default_format = "#weak" tooltip = "KEHILLAH_LIB_LADDER_TT" }
			# 2026-11-11 (Daniel: "include some score information about the books in the book ledger").
			text_single = { position = { 742 2 } text = "KEHILLAH_SEFARIM_COL_SCORE" default_format = "#weak" tooltip = "KEHILLAH_SEFARIM_SCORE_TT" }
			text_single = { position = { 790 2 } text = "KEHILLAH_SEFARIM_COL_COPY" default_format = "#weak" }
		}
		divider_light = { layoutpolicy_horizontal = expanding }

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			size = { @ledger_w 300 }
			blockoverride "scrollbox_margins" { margin = { 0 2 } margin_right = 14 }
			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 0
					ignoreinvisible = yes
					datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_lib_catalog_works' )]"
					item = {
						vbox = {
							visible = "[And( Not( GetVariableSystem.Exists( Concatenate( 'kehillah_ledger_hide_', IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_genre_', Scope.GetFlagName ) ) ) ) ) ) ), Or( Not( GetVariableSystem.Exists( 'kehillah_ledger_status' ) ), Or( EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'all' ), Or( And( EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'held' ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_held_', Scope.GetFlagName ) ), '(CFixedPoint)0' ) ), Or( And( EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'missing' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_held_', Scope.GetFlagName ) ), '(CFixedPoint)0' ) ), And( EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'sought' ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_sought_', Scope.GetFlagName ) ), '(CFixedPoint)0' ) ) ) ) ) ) ) ]"
							layoutpolicy_horizontal = expanding

							widget = {
								size = { @ledger_row_w 46 }

								### The binding it has in your rite.
								kehillah_lib_spine_icon = {
									parentanchor = left|vcenter
									position = { 6 0 }
								}

								### A work opens its catalogue card above the list.
								button_standard_list = {
									parentanchor = left|vcenter
									position = { 32 0 }
									size = { 236 32 }
									text = "[Localize( Concatenate( 'kehillah_lib_name_', Scope.GetFlagName ) )]"
									tooltipwidget = { kehillah_library_work_tooltip = { blockoverride "rank_value" { text = "[Localize( Concatenate( 'KEHILLAH_STANDING_FMT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_standing_', Scope.GetFlagName ) ) ) ) ) )]" } blockoverride "owner_line" {} } }
									onclick = "[GetVariableSystem.Set( 'kehillah_ledger_selected_work', Scope.GetFlagName )]"
								}
								icon = {
									visible = "[GetScriptedGui( Concatenate( 'kehillah_lib_studied_', Scope.GetFlagName ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									parentanchor = left|vcenter
									position = { 272 0 }
									size = { 18 18 }
									texture = "gfx/interface/icons/symbols/icon_check.dds"
									tooltip = "KEHILLAH_SEFARIM_MASTERED_TT"
								}

								text_single = {
									parentanchor = left|vcenter
									position = { 298 0 }
									text = "[Localize( Concatenate( 'kehillah_lib_year_text_', Scope.GetFlagName ) )]"
									max_width = 84
								}

								### The language, and on hover whether you read it.
								text_single = {
									parentanchor = left|vcenter
									position = { 388 0 }
									text = "[Localize( Concatenate( 'kehillah_lib_language_', Scope.GetFlagName ) )]"
									tooltip = "[Concatenate( Concatenate( '#T ', Localize( Concatenate( 'kehillah_lib_language_', Scope.GetFlagName ) ) ), Concatenate( Localize( 'KEHILLAH_LIB_TT_TITLE_END' ), Localize( Concatenate( 'KEHILLAH_LIB_LANG_TT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_fluency_', Scope.GetFlagName ) ) ) ) ) ) ) )]"
									max_width = 84
								}

								### The author, a character link where there is one.
								text_single = {
									parentanchor = left|vcenter
									position = { 478 0 }
									text = "[Select_CString( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_author_ready_', Scope.GetFlagName ) ), '(CFixedPoint)0' ), Localize( Concatenate( 'kehillah_lib_byline_', Scope.GetFlagName ) ), Localize( Concatenate( 'kehillah_lib_byline_plain_', Scope.GetFlagName ) ) )]"
									max_width = 136
								}

								### Its standing in the chosen rite; the tooltip says what that tier means.
								text_single = {
									parentanchor = left|vcenter
									position = { 620 0 }
									text = "[Localize( Concatenate( 'KEHILLAH_STANDING_FMT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', Scope.GetFlagName ) ) ) ) ) )]"
									tooltip = "[Localize( Concatenate( 'KEHILLAH_STANDING_TT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', Scope.GetFlagName ) ) ) ) ) )]"
									max_width = 118
								}
								### 2026-11-11: its score in the chosen rite (reception, 0-100); none for
								### a book fixed by doctrine (Foundational or higher).
								text_single = {
									parentanchor = left|vcenter
									position = { 742 0 }
									max_width = 40
									text = "[Select_CString( Or( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', Scope.GetFlagName ) ), '(CFixedPoint)8' ), Not( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.MakeScope.Var( Concatenate( 'kehillah_reception_', Scope.GetFlagName ) ).IsSet ) ), Localize( 'KEHILLAH_SEFARIM_SCORE_NONE' ), IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.MakeScope.Var( Concatenate( 'kehillah_reception_', Scope.GetFlagName ) ).GetValue ) ) )]"
									tooltip = "KEHILLAH_SEFARIM_SCORE_TT"
								}

								### Your copy.
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_held_', Scope.GetFlagName ) ), '(CFixedPoint)0' )]"
									parentanchor = left|vcenter
									position = { 794 0 }
									text = "KEHILLAH_SEFARIM_HELD"
									max_width = 90
								}
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_sought_', Scope.GetFlagName ) ), '(CFixedPoint)0' )]"
									parentanchor = left|vcenter
									position = { 794 0 }
									text = "KEHILLAH_SEFARIM_SOUGHT"
									max_width = 90
								}
								button_standard_list = {
									visible = "[And( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_held_', Scope.GetFlagName ) ), '(CFixedPoint)0' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_own_library' ).Title.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_sought_', Scope.GetFlagName ) ), '(CFixedPoint)0' ) )]"
									parentanchor = left|vcenter
									position = { 788 0 }
									size = { 96 30 }
									text = "KEHILLAH_SEFARIM_SEEK"
									# 2026-11-11 (Daniel: "Why is this seek a copy grayed out?"): when it is, say why.
									tooltip = "[Select_CString( GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', Scope.GetFlagName ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'KEHILLAH_SEFARIM_SEEK_TT' ), Concatenate( Localize( 'KEHILLAH_SEFARIM_SEEK_BLOCKED' ), GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', Scope.GetFlagName ) ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
									using = tooltip_se
									enabled = "[GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', Scope.GetFlagName ) ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_acquire_', Scope.GetFlagName ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
							}
							divider_light = { layoutpolicy_horizontal = expanding }
						}
					}
				}
			}
		}
	}

	### 2026-11-11: THE RITE MENU. It is the window's last child so it draws over
	### the rows. A click anywhere else in the window closes it, as a vanilla
	### dropdown does. Its top right sits under the rite button: the content's
	### right edge (40 in from the window's) and the row's foot (144 + 33).
	button = {
		visible = "[GetVariableSystem.Exists( 'kehillah_ledger_rite_menu' )]"
		size = { 100% 100% }
		onclick = "[GetVariableSystem.Clear( 'kehillah_ledger_rite_menu' )]"
	}
	widget = {
		visible = "[GetVariableSystem.Exists( 'kehillah_ledger_rite_menu' )]"
		parentanchor = top|right
		widgetanchor = top|right
		position = { -40 179 }
		size = { 340 10 }
		allow_outside = yes
		alwaystransparent = no
		scrollarea = {
			maximumsize = { 340 420 }
			autoresizescrollarea = yes
			scrollbarpolicy_horizontal = always_off
			using = Background_DropDown
			scrollwidget = {
				vbox = {
					margin = { 4 6 }
					spacing = 1
					datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_ledger_rites' )]"
					item = {
						button_normal = {
							gfxtype = framedbuttongfx
							effectname = "NoHighlight"
							shaderfile = "gfx/FX/pdxgui_pushbutton.shader"
							upframe = 1
							overframe = 2
							downframe = 3
							disableframe = 1
							texture = "gfx/interface/buttons/button_interaction_menu.dds"
							framesize = { 317 30 }
							size = { 312 32 }
							down = "[ObjectsEqual( Scope.Rite.Self, GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.Self )]"
							onclick = "[GetScriptedGui( 'kehillah_ledger_set_rite' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'rite', Scope.Rite.MakeScope ).End )]"
							onclick = "[GetVariableSystem.Clear( 'kehillah_ledger_rite_menu' )]"
							icon = {
								parentanchor = left|vcenter
								position = { 6 0 }
								size = { 26 26 }
								texture = "[Scope.Rite.GetIcon]"
								alwaystransparent = yes
							}
							text_single = {
								parentanchor = left|vcenter
								position = { 38 0 }
								text = "[Scope.Rite.GetNameNoTooltip]"
								default_format = "#high"
								max_width = 170
								alwaystransparent = yes
							}
							text_single = {
								parentanchor = right|vcenter
								position = { -8 0 }
								text = "[Scope.Rite.GetFaith.GetNameNoTooltip]"
								default_format = "#weak"
								max_width = 100
								alwaystransparent = yes
							}
						}
					}
				}
			}
			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}
		}
	}
}
