# =====================================================================
# THE SEFARIM LEDGER (2026-11-08, Daniel): every work the community knows of,
# in a window of its own, with genre toggles. It replaced the Library's All
# works page and its Acquire page. Opened from the Books page of the Beit
# Midrash (gui/kehillah_domicile_library.gui), which first runs the scripted
# gui kehillah_lib_ledger_open: that rebuilds the player's kehillah_lib_catalog_
# works (known works only, by date; see known_lines in scripts/kehillah_library_
# catalog.py), caches the author links and the works a copy can be sought of,
# and lists the Jewish rites for the rite selector.
# Registered in gui/scripted_widgets/kehillah_scripted_widgets.txt.
#
# 2026-11-10 (Daniel's review of the first live look):
#   - the window sits on the top layer, so it opens in front of the Beit
#     Midrash window instead of behind it;
#   - widths fit the frame: Window_Margins take 40 px a side, so a 980 window
#     has 900 for content (the old 884 scrollbox overflowed a 920 window);
#   - the header keys were misspelt (KEHILLAH_SEFARIM_SEFARIM_*);
#   - one row per work, one line each: binding, title (and a check when you
#     have mastered it), date, language, author, standing, your copy. The
#     standing's tooltip explains THAT tier, not the ladder as a whole; the
#     ladder is on the column head;
#   - a rite selector: the standings are those of the chosen rite (your own
#     by default), through kehillah_lib_rite_standing_<flag>. The binding icon
#     stays the one the book has in YOUR rite. Later the same day the list too
#     follows the rite: the works ITS followers know (kehillah_ledger_rebuild_
#     effect), and the standing names are coloured by band;
#   - the filters are two rows: what to show (genres, copies), then order and
#     rite. Each genre is one toggle button.
#
# Record: docs/implementation/2026-11-08-library-shelf-and-ledger.md and the
# 2026-11-10 addendum in docs/implementation/2026-11-08-library-visual-pass.md.
# =====================================================================

@ledger_w = 900
@ledger_row_w = 884

window = {
	name = "kehillah_sefarim_ledger_window"
	parentanchor = top|hcenter
	widgetanchor = top|hcenter
	position = { 0 70 }
	size = { 980 790 }
	movable = yes
	resizable = no
	layer = top
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( IsDefaultGUIMode, GetVariableSystem.Exists( 'kehillah_sefarim_ledger_open' ) ) )]"
	visible_at_creation = no

	using = Window_Background
	using = Window_Decoration_Spike

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 6
		ignoreinvisible = yes

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" { text = "KEHILLAH_SEFARIM_HEADER" }
			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Clear( 'kehillah_ledger_rite_menu' )]"
				onclick = "[GetVariableSystem.Clear( 'kehillah_sefarim_ledger_open' )]"
			}
		}

		# 2026-11-10: the count is of the works the shown rite knows.
		# 2026-11-11: in a fixed 24-high box, and the two filter rows below have
		# fixed heights (28, 33), so the rite menu (end of file) can sit exactly
		# under its button: 18 margin + 56 header + 6 + 24 + 6 + 28 + 6 = 144.
		widget = {
			layoutpolicy_horizontal = expanding
			size = { 0 24 }
			text_single = {
				parentanchor = left|vcenter
				text = "[Select_CString( GetScriptedGui( 'kehillah_ledger_viewing_own_rite' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'KEHILLAH_SEFARIM_SUBHEADER' ), Localize( 'KEHILLAH_SEFARIM_SUBHEADER_RITE' ) )]"
				tooltip = "[Select_CString( GetScriptedGui( 'kehillah_ledger_viewing_own_rite' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'KEHILLAH_SEFARIM_FOOTNOTE' ), Localize( 'KEHILLAH_SEFARIM_FOOTNOTE_RITE' ) )]"
				default_format = "#weak;italic"
				max_width = @ledger_w
			}
		}

		### What to show: the genres (each a toggle), then which copies.
		### 2026-11-11 (Daniel: "please fix the width"): the row is 852 wide, inside
		### the 900 the frame leaves. It was 918, and the rite row ~1270, which
		### pushed the whole layout past the window's background.
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			text_single = { text = "KEHILLAH_SEFARIM_SHOW" default_format = "#weak" minimumsize = { 64 0 } }
			button_standard_list = {
				size = { 104 28 }
				text = "KEHILLAH_LIB_TRACK_PARSHANUT"
				tooltip = "KEHILLAH_SEFARIM_TOGGLE_TT"
				down = "[Not( GetVariableSystem.Exists( 'kehillah_ledger_hide_1' ) )]"
				onclick = "[GetVariableSystem.Toggle( 'kehillah_ledger_hide_1' )]"
			}
			button_standard_list = {
				size = { 104 28 }
				text = "KEHILLAH_LIB_TRACK_TALMUDICS"
				tooltip = "KEHILLAH_SEFARIM_TOGGLE_TT"
				down = "[Not( GetVariableSystem.Exists( 'kehillah_ledger_hide_2' ) )]"
				onclick = "[GetVariableSystem.Toggle( 'kehillah_ledger_hide_2' )]"
			}
			button_standard_list = {
				size = { 104 28 }
				text = "KEHILLAH_LIB_TRACK_HASHKAFA"
				tooltip = "KEHILLAH_SEFARIM_TOGGLE_TT"
				down = "[Not( GetVariableSystem.Exists( 'kehillah_ledger_hide_3' ) )]"
				onclick = "[GetVariableSystem.Toggle( 'kehillah_ledger_hide_3' )]"
			}
			widget = { size = { 12 4 } }
			text_single = { text = "KEHILLAH_SEFARIM_COPIES_FILTER" default_format = "#weak" }
			button_standard_list = {
				size = { 88 28 }
				text = "KEHILLAH_SEFARIM_ALL"
				down = "[Or( Not( GetVariableSystem.Exists( 'kehillah_ledger_status' ) ), EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'all' ) )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_ledger_status', 'all' )]"
			}
			button_standard_list = {
				size = { 88 28 }
				text = "KEHILLAH_SEFARIM_HELD_FILTER"
				down = "[EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'held' )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_ledger_status', 'held' )]"
			}
			button_standard_list = {
				size = { 88 28 }
				text = "KEHILLAH_SEFARIM_MISSING_FILTER"
				down = "[EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'missing' )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_ledger_status', 'missing' )]"
			}
			button_standard_list = {
				size = { 104 28 }
				text = "KEHILLAH_SEFARIM_SOUGHT_FILTER"
				down = "[EqualTo_string( GetVariableSystem.Get( 'kehillah_ledger_status' ), 'sought' )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_ledger_status', 'sought' )]"
			}
			expand = {}
		}

		### In what order, and as which rite sees them.
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			text_single = { text = "KEHILLAH_SEFARIM_SORT" default_format = "#weak" minimumsize = { 64 0 } }
			button_standard_list = {
				size = { 112 28 }
				text = "KEHILLAH_SEFARIM_SORT_DATE"
				down = "[Not( GetVariableSystem.Exists( 'kehillah_ledger_sort_name' ) )]"
				onclick = "[GetVariableSystem.Clear( 'kehillah_ledger_sort_name' )]"
				onclick = "[GetScriptedGui( 'kehillah_lib_catalog_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_standard_list = {
				size = { 112 28 }
				text = "KEHILLAH_SEFARIM_SORT_NAME"
				down = "[GetVariableSystem.Exists( 'kehillah_ledger_sort_name' )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_ledger_sort_name', 'yes' )]"
				onclick = "[GetScriptedGui( 'kehillah_lib_ledger_sort_name' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			expand = {}
			text_single = {
				text = "KEHILLAH_SEFARIM_RITE"
				tooltip = "KEHILLAH_SEFARIM_RITE_TT"
				default_format = "#weak"
			}
			### 2026-11-11 (Daniel: "instead of having a button for each Jewish rite,
			### could we have a dynamically populated drop down"): one button showing
			### the shown rite, its icon and its faith. It opens the rite menu at the
			### end of this file. Vanilla's dropDown widget only reports a choice to
			### engine callbacks (onselectionchanged), never to a scripted gui, so the
			### menu is built from vanilla's dropdown parts (button_drop,
			### button_dropdown, Background_DropDown) and a GUI variable.
			# 2026-11-11 fix (Daniel: "I don't think the dropdown is working"): vanilla's
			# button_drop and button_dropdown set button_trigger = none -- inside a dropDown
			# the dropDown takes the click -- so on their own their onclick never fired.
			# Plain button_normal with the same textures and frames instead.
			button_normal = {
				gfxtype = framedbuttongfx
				effectname = "NoHighlight"
				upframe = 1
				overframe = 2
				downframe = 3
				disableframe = 4
				texture = "gfx/interface/buttons/button_drop_down.dds"
				framesize = { 225 33 }
				spriteType = Corneredtiled
				spriteborder = { 75 11 }
				size = { 340 33 }
				tooltip = "KEHILLAH_SEFARIM_RITE_TT"
				using = tooltip_se
				down = "[GetVariableSystem.Exists( 'kehillah_ledger_rite_menu' )]"
				onclick = "[GetVariableSystem.Toggle( 'kehillah_ledger_rite_menu' )]"
				icon = {
					parentanchor = left|vcenter
					position = { 8 0 }
					size = { 26 26 }
					texture = "[GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.GetIcon]"
					alwaystransparent = yes
				}
				text_single = {
					parentanchor = left|vcenter
					position = { 40 0 }
					text = "[GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.GetNameNoTooltip]"
					default_format = "#high"
					max_width = 170
					alwaystransparent = yes
				}
				text_single = {
					parentanchor = right|vcenter
					position = { -32 0 }
					text = "[GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.GetFaith.GetNameNoTooltip]"
					default_format = "#weak"
					max_width = 100
					alwaystransparent = yes
				}
			}
		}

		# The selected work has room for the information deliberately omitted
		# from the scan rows. It also leads to the full library work page.
		vbox = {
			visible = "[GetVariableSystem.Exists( 'kehillah_ledger_selected_work' )]"
			layoutpolicy_horizontal = expanding
			spacing = 3
			ignoreinvisible = yes
			divider_light = { layoutpolicy_horizontal = expanding }
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				text_single = {
					text = "[Localize( Concatenate( 'kehillah_lib_name_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) )]"
					default_format = "#T"
					max_width = 560
				}
				expand = {}
				button_standard_list = {
					size = { 150 28 }
					text = "KEHILLAH_SEFARIM_OPEN_WORK"
					onclick = "[GetVariableSystem.Clear( 'kehillah_lib_picked_work' )]"
					onclick = "[GetVariableSystem.Set( 'kehillah_lib_selected_work', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) )]"
					onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_holders_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( Concatenate( 'kehillah_lib_readers_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear( 'kehillah_sefarim_ledger_open' )]"
				}
				button_standard_list = {
					size = { 90 28 }
					text = "KEHILLAH_SEFARIM_CARD_CLOSE"
					onclick = "[GetVariableSystem.Clear( 'kehillah_ledger_selected_work' )]"
				}
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = @ledger_w
				text = "[Localize( Concatenate( 'kehillah_lib_desc_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) )]"
				tooltip = "[Localize( Concatenate( 'kehillah_lib_detail_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) )]"
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 14
				text_single = {
					text = "[Localize( Concatenate( 'kehillah_lib_place_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) )]"
					default_format = "#weak"
					max_width = 300
				}
				text_single = {
					# 2026-11-10: with whether the viewer reads it (Sefer languages).
					text = "[Concatenate( Localize( Concatenate( 'kehillah_lib_language_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), Localize( Concatenate( 'KEHILLAH_LIB_FLUENCY_', IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_fluency_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ) ) ) )]"
					tooltip = "[Concatenate( Concatenate( '#T ', Localize( Concatenate( 'kehillah_lib_language_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ), Concatenate( Localize( 'KEHILLAH_LIB_TT_TITLE_END' ), Localize( Concatenate( 'KEHILLAH_LIB_LANG_TT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_fluency_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ) ) ) ) )]"
					max_width = 320
				}
				# 2026-11-10 (Daniel): the mastery chance is not shown as text; it is on
				# the Study button's tooltip in the Beit Midrash.
				expand = {}
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = @ledger_w
				text = "[Localize( Concatenate( 'kehillah_lib_tenets_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) )]"
				tooltip = "KEHILLAH_SEFARIM_TENETS_TT"
			}
				### 2026-11-11: its record -- score and ceiling in the chosen rite, then the
				### counts the climb reads (copies, masters, approbations, teaching, citations).
				hbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						align = left|nobaseline
						max_width = @ledger_w
						text = "[Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_SCORE' ), Concatenate( Select_CString( Or( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ), Not( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.MakeScope.Var( Concatenate( 'kehillah_reception_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ).IsSet ) ), Localize( 'KEHILLAH_SEFARIM_SCORE_NONE' ), IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.MakeScope.Var( Concatenate( 'kehillah_reception_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ).GetValue ) ) ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_CEILING' ), Concatenate( Select_CString( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ), Localize( 'KEHILLAH_SEFARIM_SCORE_NONE' ), Localize( Concatenate( 'KEHILLAH_STANDING_FMT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_ceiling_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ) ) ) ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_COPIES' ), Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.ScriptValue( Concatenate( 'kehillah_lib_copies_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_MASTERS' ), Concatenate( Select_CString( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_masters' ) ) ).IsSet, IntToString( FixedPointToInt( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_masters' ) ) ).GetValue ) ), '0' ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_APPROBATIONS' ), Concatenate( Select_CString( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_approbations' ) ) ).IsSet, IntToString( FixedPointToInt( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_approbations' ) ) ).GetValue ) ), '0' ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_TAUGHT' ), Concatenate( Select_CString( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_taught' ) ) ).IsSet, IntToString( FixedPointToInt( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_taught' ) ) ).GetValue ) ), '0' ), Concatenate( Localize( 'KEHILLAH_SEFARIM_STAT_CITED' ), Select_CString( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_citations' ) ) ).IsSet, IntToString( FixedPointToInt( GetGlobalVariable( Concatenate( 'kehillah_wk_', Concatenate( GetVariableSystem.Get( 'kehillah_ledger_selected_work' ), '_citations' ) ) ).GetValue ) ), '0' ) ) ) ) ) ) ) ) ) ) ) ) ) )]"
						tooltip = "KEHILLAH_SEFARIM_STATS_TT"
					}
					expand = {}
				}
			### 2026-11-11 (Daniel: "Yes, build it" -- the score was hard to read): the next
			### tier in the chosen rite and what it waits on, each requirement green when met
			### (kehillah_standing_recalc_work_effect and kehillah_standing_next_gate_met_trigger:
			### one tier a year, the score in the next tier's band, under the ceiling, and the gate).
			### Then, when the score has fallen below its tier's band, how long it has been.
			hbox = {
				visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).Rite.MakeScope.Var( Concatenate( 'kehillah_reception_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ).IsSet, Not( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ) ) )]"
				layoutpolicy_horizontal = expanding
				spacing = 14
				ignoreinvisible = yes
				text_single = { text = "KEHILLAH_SEFARIM_NEXT_LABEL" tooltip = "KEHILLAH_SEFARIM_NEXT_TT" }
				text_single = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' )]"
					text = "KEHILLAH_SEFARIM_NEXT_TOP"
				}
				text_single = {
					visible = "[And( LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ), Not( LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_ceiling_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ) )]"
					text = "[Concatenate( Localize( 'KEHILLAH_SEFARIM_NEXT_CEILING' ), Localize( Concatenate( 'KEHILLAH_STANDING_FMT_', IntToString( FixedPointToInt( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_ceiling_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ) ) ) )]"
				}
				text_single = {
					visible = "[And( LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ), LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_ceiling_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) )]"
					text = "[Localize( Concatenate( 'KEHILLAH_STANDING_FMT_', IntToString( FixedPointToInt( Add_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)1' ) ) ) ) )]"
				}
				text_single = {
					visible = "[And( And( LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)8' ), LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_ceiling_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ) ) ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_ledger_rite' ).ScriptValue( Concatenate( 'kehillah_lib_rite_standing_', GetVariableSystem.Get( 'kehillah_ledger_selected_work' ) ) ), '(CFixedPoint)0' ) )]"
