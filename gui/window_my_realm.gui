			item = {
				vbox = {
					name = "realm_law_group" #tutorial uses this
					datacontext = "[GuiLawGroup.GetLawGroup]"
					visible = "[And3( GuiLawGroup.GetLawGroup.HasFlag( 'realm_law' ), GuiLawGroup.IsAvailable, Not( IsLandlessMerchant( Character ) ) )]"
					margin = { 0 10 }
					spacing = 10

					text_label_center = {
						visible = "[IsLandlessAdventurer( Character )]"
						text = "[camp_purpose|E]"
					}

					text_label_center = {
						visible = "[And( Not( IsLandlessAdventurerOrMerchant( Character ) ), And( Not( GuiLawGroup.GetLawGroup.HasFlag( 'republican_type_law' ) ), GuiLawGroup.GetLawGroup.HasFlag( 'realm_law_no_number' ) ) )]"
						datacontext = "[GuiLawGroup.GetCurrentLevel.GetLaw]"
