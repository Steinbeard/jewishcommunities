								blockoverride "tick_before" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_settled_pos_stability_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "tick_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_settled_rest_stability_value' ) ), '(float)1000', '(int32)1000' )]" }
