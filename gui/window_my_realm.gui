	type widget_my_realm_law_item = widget {
		datacontext = "[GuiLawGroup]"
		datacontext = "[GuiLawGroup.GetLawGroup]"
		size = { 246 62 }

		background = {
			using = Background_Area
		}

		button_standard_clean = {
			visible = "[And3( Not( LawGroup.HasFlag( 'treasury_budget_law' ) ), IsGameViewOpen( 'law_change' ), GetVariableSystem.HasValue( 'law_change_open_group', LawGroup.GetKey ) )]"
			size = { 100% 100% }

			onclick = "[ToggleGameViewData( 'law_change', GuiLawGroup.Self )]"
			onclick = "[GetVariableSystem.Clear( 'law_change_open_group' )]"
			block "law_enabled" {
				enabled = "[LawGroup.CanRulerChange(GetPlayer)]"
			}
			block "law_tooltip_disabled" {
				tooltip_when_disabled = "[GuiLawGroup.GetCanChangeTooltip]"
			}
		}

		button_standard_clean = {
			visible = "[And( Not( LawGroup.HasFlag( 'treasury_budget_law' ) ), Not( And( IsGameViewOpen( 'law_change' ), GetVariableSystem.HasValue( 'law_change_open_group', LawGroup.GetKey ) ) ) )]"
			size = { 100% 100% }

			onclick = "[OpenGameViewData( 'law_change', GuiLawGroup.Self )]"
			onclick = "[GetVariableSystem.Set( 'law_change_open_group', LawGroup.GetKey )]"
			block "law_enabled" {
				enabled = "[LawGroup.CanRulerChange(GetPlayer)]"
			}
			block "law_tooltip_disabled" {
				tooltip_when_disabled = "[GuiLawGroup.GetCanChangeTooltip]"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 10 0 }

			vbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					size = { 0 22 }

					text = "MY_REALM_WINDOW_LAW_GROUP_NAME"
					align = nobaseline
					alwaystransparent = yes
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					size = { 0 22 }

					block "law_name" {
						text = "[GuiLawGroup.GetCurrentLevel.GetLaw.GetName]"
					}
					align = nobaseline
					default_format = "#high"
					alwaystransparent = yes
				}
			}

			expand = {}

			vbox = {
				visible = "[Not( LawGroup.HasFlag( 'treasury_budget_law' ) )]"
				enabled = "[LawGroup.CanRulerChange(GetPlayer)]"
				tooltip_when_disabled = "[GuiLawGroup.GetCanChangeTooltip]"

				layoutpolicy_vertical = expanding
				widget = {
					size = { 24 24 }

					button_change = {
						size = { 24 24 }
						visible = "[And( IsGameViewOpen( 'law_change' ), GetVariableSystem.HasValue( 'law_change_open_group', LawGroup.GetKey ) )]"
						onclick = "[ToggleGameViewData( 'law_change', GuiLawGroup.Self )]"
						onclick = "[GetVariableSystem.Clear( 'law_change_open_group' )]"
					}

					button_change = {
						size = { 24 24 }
						visible = "[Not( And( IsGameViewOpen( 'law_change' ), GetVariableSystem.HasValue( 'law_change_open_group', LawGroup.GetKey ) ) )]"
						onclick = "[OpenGameViewData( 'law_change', GuiLawGroup.Self )]"
						onclick = "[GetVariableSystem.Set( 'law_change_open_group', LawGroup.GetKey )]"
					}
				}

				text_single = {
					block "law_number_visible" {
						visible = "[LawGroup.CanRulerChange(GetPlayer)]"
					}
					text = "[GuiLawGroup.GetNumberOfAvailableLaws( Character.Self )]"
					align = nobaseline
					alpha = "[Select_float( GreaterThan_int32( GuiLawGroup.GetNumberOfAvailableLaws( Character.Self ), '(int32)0' ), '(float)1.0', '(float)0.5' )]"
				}

			}

		}
	}

