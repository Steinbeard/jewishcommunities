	type vbox_my_realm_laws_body = vbox {
		using = Animation_Tab_Switch

		### LAWS TOP AND PROGRESS BAR
		vbox = {
			visible = "[And( And( GreaterThan_int32( MyRealmWindow.GetPowerfulVassalLawVoteCount, '(int32)0' ), Not( IsNomad( GetPlayer ) ) ), Not( GetPlayer.GetGovernment.HasRule( 'deny_powerful_vassal' )))]"
			margin_top = 15
			spacing = 5

			text_single = {
				text = "MY_REALM_WINDOW_LAWS_PROGRESS_BAR_TITLE"
				align = nobaseline
				max_width = 500
			}

			### POWERFUL VASSALS PROGRESS BAR
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 20 0 }

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

					text_single = {
						text = "MY_REALM_WINDOW_LAWS_PROGRESS_BAR_APPROVES"
						align = nobaseline
						max_width = 150
					}

					progressbar_standard = {
						layoutpolicy_horizontal = expanding
						size = { 140 20 }

						using = Animation_ShowHide_Standard

						max = "[IntToFloat( MyRealmWindow.GetPowerfulVassalLawVoteCount )]"
						value = "[IntToFloat( MyRealmWindow.GetPowerfulVassalLawApproves )]"
					}

					text_single = {
						text = "MY_REALM_WINDOW_LAWS_PROGRESS_BAR_OPPOSES"
						align = nobaseline
						max_width = 150
					}
				}
			}

			text_multi = {
				text = "MY_REALM_WINDOW_LAWS_PROGRESS_BAR_DESC"
				align = center|nobaseline
				autoresize = yes
				default_format = "#weak"
				max_width = 500
			}
		}

		### KURULTAI PROGRESS BAR
		vbox = {
			datacontext = "[MyRealmWindow.GetKurultaiSuccession]"
			visible = "[And( GreaterThan_int32( KurultaiSuccession.GetVoteCount, '(int32)0' ), IsNomad( GetPlayer ) )]"
			layoutpolicy_horizontal = expanding

			margin_top = 15

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					text = "MY_REALM_WINDOW_KURULTAI_APPROVES"
					align = nobaseline
					max_width = 150
				}

				progressbar_standard = {
					name = "kurultai_votes"
					layoutpolicy_horizontal = expanding
					size = { 200 20 }

					using = Animation_ShowHide_Standard

					max = "[IntToFloat( KurultaiSuccession.GetVoteCount )]"
					value = "[IntToFloat( KurultaiSuccession.GetObedientCount )]"
				}

				text_single = {
					text = "MY_REALM_WINDOW_KURULTAI_OPPOSES"
					align = nobaseline
					max_width = 150
				}
			}

			text_multi = {
				text = "MY_REALM_WINDOW_KURULTAI_OBEDIENT"
				autoresize = yes
				default_format = "#italic"
				align = center
				max_width = 500
				margin = { 0 5 }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			margin_top = 10
			spacing = 18

			### KEHILLAH LEADERSHIP STYLE (2026-11-17, Daniel): the tile picker
			### broke the Domain tab's alignment; it sits here, like the
			### adventurer Camp Purpose in vanilla's Laws tab.
			kehillah_leadership_style_panel = {}

			### KEHILLAH CHARTER (2026-10-29, Daniel): a Kehillah's charter with
			### its host is its law, so it lives here rather than in Domain.
			### 2026-11-25 dashboard (docs/implementation/2026-11-25-laws-dashboard.md;
			### types in gui/kehillah_laws_dashboard.gui): a header card with the
			### charter's overall favour and the petition button (vanilla's
			### tributary-contract interaction with the direct suzerain), then one
			### card per term in two columns, rated by favour. Each card's tooltip
			### is the level as the contract window describes it. The cache marks
			### the package: construction for the Christian and Muslim charters,
			### lending for the V15 fallback charter.
			vbox = {
				visible = "[GetPlayer.GetGovernment.IsType( 'kehillah_government' )]"
				datacontext = "[GetPlayer.GetPrimaryTitle]"
				layoutpolicy_horizontal = expanding
				spacing = 8

				widget = {
					size = { 540 34 }
					text_label_center = {
						parentanchor = center
						max_width = 240
						text = "KEHILLAH_LAWS_CHARTER_HEADER"
						default_format = "#low"
						using = Font_Size_Medium
					}
				}

				# The header card: seal, who grants it and how kindly, and the petition.
				# 12 + 56 + 10 + 280 + 10 + 160 + 12 = 540.
				hbox = {
					size = { 540 76 }
					margin = { 12 0 }
					spacing = 10
					background = {
						using = Background_Area_Dark
						color = { 0.16 0.14 0.12 0.8 }
						margin = { 2 2 }
					}
					icon = {
						size = { 56 56 }
						texture = "gfx/interface/icons/icon_contract_modification.dds"
						framesize = { 60 60 }
						frame = 1
					}
					vbox = {
						min_width = 280
						max_width = 280
						spacing = 2
						tooltip = "KEHILLAH_LAWS_CHARTER_FAVOUR_TT"
						using = tooltip_se
						text_single = {
							size = { 280 16 }
							autoresize = no
							align = left|nobaseline
							text = "KEHILLAH_LAWS_CHARTER_FAVOUR_LABEL"
							using = Font_Size_Small
						}
						text_single = {
							size = { 280 28 }
							autoresize = no
							align = left|nobaseline
							text = "[Title.GetHolder.Custom('KehillahCharterFavour')]"
							using = Font_Size_Big
						}
						text_single = {
							size = { 280 18 }
							autoresize = no
							align = left|nobaseline
							text = "KEHILLAH_LAWS_CHARTER_INTRO"
							default_format = "#weak;italic"
							using = Font_Size_Small
						}
					}
					button_standard = {
						datacontext = "[Title.GetHolder.GetSuzerain]"
						visible = "[Title.GetHolder.HasSuzerain]"
						size = { 160 33 }
						text = "KEHILLAH_LAWS_CHARTER_REVISE"
						enabled = "[Character.IsPlayerInteractionValid( 'subject_modify_tributary_contract_interaction' )]"
						onclick = "[Character.OpenPlayerInteraction( 'subject_modify_tributary_contract_interaction' )]"
						tooltip = "KEHILLAH_LAWS_CHARTER_REVISE_TOOLTIP"
						using = tooltip_se
					}
				}

				# The terms, two columns of 258 with 10 between, centred in 540.
				widget = {
					visible = "[Or( Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet, Title.MakeScope.Var( 'kehillah_charter_cache_lending' ).IsSet )]"
					size = { 540 162 }
					hbox = {
						parentanchor = top|hcenter
						spacing = 10
						vbox = {
							layoutpolicy_vertical = expanding
							min_width = 258
							max_width = 258
							spacing = 6
							ignoreinvisible = yes
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_CONSTRUCTION_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_construction_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_construction_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_construction_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/icon_holding_city.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_CONSTRUCTION" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_CONSTRUCTION" }
							}
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_JURISDICTION_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_jurisdiction_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_jurisdiction_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_jurisdiction_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/scale_of_power.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_JURISDICTION" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_JURISDICTION" }
							}
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_lending' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_LENDING_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_lending_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_lending_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_lending_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/subject_contracts/portrait_icons/tributary_merchant.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_LENDING" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_LENDING" }
							}
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Or( Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet, Title.MakeScope.Var( 'kehillah_charter_cache_lending' ).IsSet )]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_TRIBUTE_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_tribute_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_tribute_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_tribute_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/subject_contracts/portrait_icons/tributary_hegemonic.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_TRIBUTE" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_TRIBUTE" }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_vertical = expanding
							min_width = 258
							max_width = 258
							spacing = 6
							ignoreinvisible = yes
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_SECURITY_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_security_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_security_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_security_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/icon_garrison.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_SECURITY" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_SECURITY" }
							}
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_KNOWLEDGE_OR_TRADE_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_knowledge_or_trade_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_knowledge_or_trade_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_knowledge_or_trade_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/icon_skill_learning.dds" visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_text_study' ).IsSet]" }
								# Muslim charters: Market Access in this slot (2026-11-25: a
								# Select_CString texture drew nothing live).
								blockoverride "card_icon_alt" { texture = "gfx/interface/icons/icon_gold.dds" visible = "[Not( Title.MakeScope.Var( 'kehillah_charter_cache_text_study' ).IsSet )]" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_KNOWLEDGE_OR_TRADE" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_KNOWLEDGE_OR_TRADE" }
							}
							kehillah_laws_term_card = {
								blockoverride "card_visible" { visible = "[Title.MakeScope.Var( 'kehillah_charter_cache_lending' ).IsSet]" }
								blockoverride "card_tooltip" { tooltip = "KEHILLAH_LAWS_CHARTER_ROW_WALLED_TT" }
								blockoverride "strip_good" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_walled_value' ), '(CFixedPoint)3' )]" }
								blockoverride "strip_mid" { visible = "[EqualTo_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_walled_value' ), '(CFixedPoint)2' )]" }
								blockoverride "strip_bad" { visible = "[LessThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_charter_favour_walled_value' ), '(CFixedPoint)2' )]" }
								blockoverride "card_icon" { texture = "gfx/interface/icons/icon_holding_castle.dds" }
								blockoverride "card_label" { text = "KEHILLAH_LAWS_TERM_LABEL_WALLED" }
								blockoverride "card_value" { text = "KEHILLAH_LAWS_TERM_VALUE_WALLED" }
							}
							expand = {}
						}
					}
				}
				text_single = {
					visible = "[Not( Or( Title.MakeScope.Var( 'kehillah_charter_cache_construction' ).IsSet, Title.MakeScope.Var( 'kehillah_charter_cache_lending' ).IsSet ) )]"
					size = { 540 24 }
					autoresize = no
					align = center|nobaseline
					text = "KEHILLAH_DOMAIN_CHARTER_PENDING"
					default_format = "#weak"
				}
			}

			# Company Purpose
			vbox = {
				visible = "[IsLandlessMerchant( GetPlayer )]"
				datacontext = "[GetPlayer.GetActiveLawInGroupWithFlag('company_purpose')]"

				button_instant_law = {
					name = "merchant_company_purpose_tutorial_uses_this"
					onclick = "[GetVariableSystem.Toggle('change_company_purpose')]"
					down = "[GetVariableSystem.Exists('change_company_purpose')]"

					blockoverride "call_to_action" {
						text_single = {
							layoutpolicy_horizontal = expanding
							text = "CHANGE_COMPANY_PURPOSE_CALL_TO_ACTION"
							margin_bottom = 16
						}
					}
				}
			}

			### REALM LAWS (except the flag 'realm_law' as those are reserved for Crown Authority)
			vbox_law_item = {
				blockoverride "item_title"
				{
					visible = no
				}

				blockoverride "show_law"
				{
					visible = "[And( GuiLawGroup.IsAvailable, Or4( GuiLawGroup.GetLawGroup.HasFlag( 'succession_order_laws' ), GuiLawGroup.GetLawGroup.HasFlag( 'succession_gender_laws' ), GuiLawGroup.GetLawGroup.HasFlag( 'imperial_policy' ), GuiLawGroup.GetLawGroup.HasFlag( 'church_policy' ) ) )]"
				}
			}

			### PRIMARY TITLE ELECTION (if exists)
			flowcontainer = {
				name = "primary_title_election"
				datacontext = "[GetPlayer]"
				datamodel = "[MyRealmWindow.GetTitlesCanVote]"
				visible = "[MyRealmWindow.CanVote]"

				ignoreinvisible = yes

				item = {
					button_standard = {
						datacontext = "[TitleItem.GetTitle]"
						visible = "[ObjectsEqual( Title.Self, Character.GetPrimaryTitle.Self )]"
						text = "MY_REALM_WINDOW_VOTE"

						onclick = "[OpenGameViewData( 'title_election', Title.Self )]"
						tooltip = "MY_REALM_WINDOW_VOTE_TOOLTIP"
					}
				}
			}

			#### ELECTIONS BUTTON
			vbox = {
				visible = "[MyRealmWindow.CanVote]"
				layoutpolicy_horizontal = expanding

				text_label_left = {
					layoutpolicy_horizontal = expanding
					text = "MY_REALM_WINDOW_LAWS_SPECIFIC_SUCCESSION_LAWS"
				}

				vbox = {
					name = "elections"
					datacontext = "[GetPlayer]"
					datamodel = "[MyRealmWindow.GetTitlesCanVote]"
					layoutpolicy_horizontal = expanding
					ignoreinvisible = yes

					margin_top = 5

					item = {
						vbox_election_title_law_item = {
							visible = "[Not( ObjectsEqual( Title.Self, Character.GetPrimaryTitle.Self ) )]"
						}
					}
				}
			}

			### PROVINCIAL LAWS
			vbox_law_item = {
				datacontext = "[GetPlayer]"
				visible = "[ProvincialLawCharacter( Character )]"

				blockoverride "item_title"
				{
					text = "MY_REALM_WINDOW_LAWS_PROVINCIAL_LAWS"
				}

				blockoverride "item_desc"
				{
					text = "MY_REALM_WINDOW_LAWS_PROVINCIAL_LAWS_DESC"
				}

				blockoverride "show_law"
				{
					visible = "[And( GuiLawGroup.IsAvailable, GuiLawGroup.GetLawGroup.HasFlag( 'admin_law' ) )]"
				}
				blockoverride "law_enabled" {
					enabled = "[Not( Character.HasOverlord )]"
				}
				blockoverride "law_tooltip_disabled" {
					tooltip = "MY_REALM_WINDOW_LAWS_PROVINCIAL_LAWS_DESC_DISABLED"
					tooltip_visible = "[Character.HasOverlord]"
				}
			}

			### TREASURY BUDGET LAWS
			vbox_law_item = {
				datacontext = "[GetPlayer]"
				visible = "[And( Character.HasTreasury, MyRealmWindow.HasBudgetLaws )]"

				blockoverride "item_title"
				{
					text = "MY_REALM_WINDOW_LAWS_TREASURY_BUDGET_LAWS"
				}

				blockoverride "show_law"
				{
					visible = "[And( GuiLawGroup.IsAvailable, GuiLawGroup.GetLawGroup.HasFlag( 'treasury_budget_law' ) )]"
				}
			}

			button_standard = {
				visible = "[And3( Character.IsIndependentRuler, Character.HasTreasury, Not( Character.GetGovernment.HasGovernmentFlag( 'government_is_ecclesiastical' ) ) )]"
				size = { 320 44 }

				onclick = "[OpenGameViewData( 'treasury_budget_change', GetPlayer.Self )]"

				tooltip = "TREASURY_BUDGET_TT"
				using = tooltip_ws

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 12

					expand = {}

					icon = {
						size = { 32 32 }
						texture = "gfx/interface/icons/icon_imperial_treasury.dds"
					}

					text_single = {
						text = "MY_REALM_WINDOW_MANAGE_TREASURY_BUDGET"
						align = nobaseline
						default_format = "#clickable"
					}
					expand = {}
				}
			}
		}
	}

