								blockoverride "tick_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_settled_rest_greatness_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "limit_visible" { visible = "[GreaterThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_has_limit_greatness_value' ), '(CFixedPoint)0' )]" }
