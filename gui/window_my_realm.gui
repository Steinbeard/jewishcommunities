								blockoverride "limit_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_limit_rest_stability_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "limit_tooltip" { tooltip = "KEHILLAH_DOM_STABILITY_LIMIT_TT" }
