							}

							widget = {
								size = { 75 0 }
								layoutpolicy_vertical = expanding

								coa_title_small_crown = {
									position = { 0 -16 }
									parentanchor = center
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								spacing = 2

								text_label_left = {
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "TITLE_NAME_NO_TOOLTIP"
								}

								hbox = {
									layoutpolicy_horizontal = expanding

									icon_title_succession = {}

									text_single = {
										layoutpolicy_horizontal = expanding

										text = "[Title.GetTitleLawsTooltip]"
										align = nobaseline
										autoresize = no
									}
								}

								expand = {}
							}

							vbox = {
								portrait_head_small = {
									datacontext = "[Title.GetHeir]"
								}

								text_label_center = {
									text = "[heir|E]"
								}
							}


						}
					}

				}
			}
		}

		vbox = {
			name = "line_of_succession"
			visible = "[MyRealmWindow.HasSingleHeir]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = growing
			margin = { 5 0 }
			spacing = 10

			hbox = {
				layoutpolicy_horizontal = expanding

				text_label_left = {
					name = "line_of_succession_label"
					layoutpolicy_horizontal = expanding
					text = "MY_REALM_WINDOW_LINE_OF_SUCCESSION"
				}

				expand = {}
			}

			dynamicgridbox = {
				name = "line_of_succession_box"
				datamodel = "[MyRealmWindow.GetLineOfSuccession]"
				layoutpolicy_horizontal = expanding

				item = {
					hbox = {
						datacontext = "[LineOfSuccessionItem.GetCharacter]"
						maximumsize = { -1 100 }
						margin_left = 10
						margin_bottom = 5

						background = {
							using = Background_Area_With_Header
						}

						vbox = {
							layoutpolicy_vertical = growing
							margin_bottom = 5
							spacing = 2

							hbox_character_view_name_age_health = {
								blockoverride "name_text"
								{
									text = "MY_REALM_WINDOW_LINE_OF_SUCCESSION_ORDERED_NAME"
								}

								blockoverride "health_margin" {
									margin_left = 4
								}
							}

							spacer = {
								size = { 10 3 }
							}

							hbox = {
								layoutpolicy_horizontal = expanding

								text_single = {
									name = "character_relation_to_you"
									text = "[Character.GetRelationToString( GetPlayer )]"
									align = nobaseline
									fontsize_min = 13
									max_width = 300

									tooltip = "EXTENDED_RELATIONS_TOOLTIP"
								}

								expand = {}
							}

							hbox_traits_list_small = {
								name = "traits_list"
								datacontext = "[LineOfSuccessionItem.GetTraitArrays]"
							}

							text_single = {
								name = "vassal_stances_that_prefer"
								visible = "[And( And( Not( IsLandlessAdventurer( GetPlayer ) ), Not( StringIsEmpty( MyRealmWindow.GetCharacter.GetVassalStancesThatPrefer( Character.Self ) ) ) ), Not( IsLandlessMerchant( GetPlayer ) ) )]"
								layoutpolicy_horizontal = expanding

								text = "MRW_HEIR_PREFERRED"
								autoresize = no
								using = Font_Size_Medium
							}

							expand = {}
						}

						expand = {}

						vbox = {
							layoutpolicy_vertical = expanding

							portrait_shoulders = {
								name = "heir_portrait"

								blockoverride "portrait_button" {
									using = tooltip_ws
								}
							}

							expand = {}
						}
					}
				}
			}
		}

		expand = {}
	}

	type tooltip_my_realm_to_liege = container_my_realm_window_contribution_tooltip {
		datacontext = "[MyRealmWindow.GetCharacter]"

		blockoverride "contribution_tooltip_header"
		{
			text = "[SelectLocalization(Character.HasSuzerain, 'MRW_TT_TAXES_TO_MY_SUZERAIN', 'MRW_TT_TAXES_TO_MY_LIEGE')]"
		}

		blockoverride "contribution_tooltip_content_suffix" {}
	}

	type container_my_realm_window_contribution_tooltip = container {
		alwaystransparent = no

		using = GeneralTooltipSetup
		using = DefaultTooltipBackground

		widget_gold_breakdown_tooltip = {
			layoutpolicy_horizontal = expanding

			blockoverride "margins"
			{
				margin = { 15 10 }
				margin_bottom = 5
				spacing = 15
			}

			blockoverride "income"
			{
				visible = no
			}

			blockoverride "background" {}

			blockoverride "extra_info"
			{
				block "contribution_tooltip_content_suffix" {
					text_single = {
						visible = "[Character.IsTheocraticLessee]"

						text = "MY_REALM_WINDOW_CONTRIBUTION_TO_THEOCRATIC_LIEGE"
						default_format = "#weak"
						multiline = yes
						maximumsize = { 300 -1 }
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					margin_bottom = 10

					block "contribution_tooltip_header"
					{
						align = left
					}
				}
			}
		}
	}

	type vbox_my_realm_domain_body = vbox {
		layoutpolicy_horizontal = expanding
		margin_top = 5
		spacing = 20

		using = Animation_Tab_Switch

		vbox = {
			visible = "[Character.HasDomicile]"

			layoutpolicy_horizontal = expanding
			margin_top = 10
			spacing = 10

			text_label_center = {
				max_width = 500
				text = "[Character.GetDomicile.GetYourDomicileText]"
				default_format = "#low"
				using = Font_Size_Medium
			}

			vbox_domicile_button = {}
		}

		# Kehillah overview lives in the Domain tab, immediately below the
		# existing Jewish Quarter card. Kept to these gated blocks so the
		# vanilla body below remains unchanged for every other government.
		# 2026-10-29, fourth pass, modelled on the feudal Domain tab (Daniel):
		# that tab is the ruler's holdings, each a header row (name;
		# Development, Control) over a card, with the liege only in the
		# header and a "To Liege" footer. Here the pillars are the holdings:
		# each a header row (name; score, tier and trend), its bar, and one
		# line (since 2026-11-26: where it settles, under its limit). Fifth pass (Daniel: "way too
		# much going on"): the breakdown is the row's tooltip only. Standing and
		# danger head the section; the host is a one-line "To Host" footer
		# with the Charter button (its terms are in that button's tooltip and
		# in the pillar lines they move).
		# Height (2026-10-30, Daniel): the whole tab should fit without a
		# scrollbar, so margins are tight, the ledger button sits on the
		# banner row and the income tiles carry no label line. (Filling the
		# tab's width instead of 540 px was tried and made it worse.)
		# Width: the tab holds about 555 px; each box is 540 (512 inside,
		# 14 px margins). Wider pushed the whole tab, Jewish Quarter card
		# included, past the window edge (live, 2026-10-29). The types live
		# in kehillah_realm_view.gui.

		# The leadership-style picker moved to the Laws tab (2026-11-17).

		### YOUR KEHILLAH as a dashboard (2026-11-25, docs/implementation/
		### 2026-11-25-domain-dashboard.md; the card types are in
		### gui/kehillah_domain_dashboard.gui). A hero card for Standing, with
		### the world rank and a danger chip that opens Community Safety; then
		### the three pillars as cards side by side. Replaces the fifth-pass
		### rows (2026-10-29/30). Same 540 px box and fixed-width rules.
		vbox = {
			visible = "[Character.GetGovernment.IsType( 'kehillah_government' )]"
			datacontext = "[Character.GetPrimaryTitle]"
			layoutpolicy_horizontal = expanding
			spacing = 8

			# THE HERO: the Standing emblem (a hut to a stone hall), the band,
			# the community's description and history; at the right, the world
			# rank and the danger chip. Three fixed columns in a 540 px hbox
			# (12 + 80 + 10 + 266 + 10 + 150 + 12): vbox children centre by
			# default, so every line has its own fixed size and left align
			# (first pass, 2026-11-25 live: the text and chip drifted to the
			# middle and overlapped).
			hbox = {
				size = { 540 104 }
				margin = { 12 0 }
				spacing = 10
				background = {
					using = Background_Area_Dark
					color = { 0.16 0.14 0.12 0.8 }
					margin = { 2 2 }
				}

				icon = {
					size = { 80 80 }
					texture = "gfx/interface/icons/development_levels.dds"
					framesize = { 64 64 }
					frame = "[FixedPointToInt( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_standing_frame_value' ) )]"
					tooltip = "KEHILLAH_BD_STANDING_TOOLTIP"
					using = tooltip_se
				}
				vbox = {
					min_width = 266
					max_width = 266
					spacing = 1
					tooltip = "KEHILLAH_BD_STANDING_TOOLTIP"
					using = tooltip_se
					text_single = {
						size = { 266 16 }
						autoresize = no
						align = left|nobaseline
						text = "KEHILLAH_DOM_STANDING_LABEL"
						using = Font_Size_Small
					}
					text_single = {
						size = { 266 30 }
						autoresize = no
						align = left|nobaseline
						text = "KEHILLAH_DOM_STANDING_VALUE"
						using = Font_Size_Big
					}
					text_single = {
						size = { 266 20 }
						autoresize = no
						align = left|nobaseline
						text = "KEHILLAH_DOMAIN_DESCRIPTION"
						default_format = "#weak;italic"
					}
					text_single = {
						visible = "[Title.MakeScope.Var( 'kehillah_history_county' ).IsSet]"
						size = { 266 18 }
						autoresize = no
						align = left|nobaseline
						text = "KEHILLAH_DOM_HISTORY_SHORT"
						using = Font_Size_Small
					}
				}
				vbox = {
					min_width = 150
					max_width = 150
					spacing = 6

					# The community's world rank: a link to the ledger.
					button_normal = {
						size = { 150 22 }
						onclick = "[GetScriptedGui( 'kehillah_ledger_open' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'kehillah_ledger_open', 'yes' )]"
						tooltip = "KEHILLAH_DOMAIN_LEDGER_TOOLTIP"
						using = tooltip_se
						text_single = {
							size = { 100% 100% }
							autoresize = no
							text = "KEHILLAH_DOMAIN_LEDGER_BUTTON"
							align = right|nobaseline
							alwaystransparent = yes
						}
					}
					# The danger chip: the Community Safety lock and band; opens it.
					button_standard = {
						size = { 150 50 }
						onclick = "[ToggleGameViewData( 'military', GetPlayer.GetID )]"
						tooltipwidget = {
							kehillah_danger_breakdown_tooltip = {}
						}
						using = tooltip_se
						icon = {
							parentanchor = left|vcenter
							position = { 6 0 }
							size = { 38 38 }
							texture = "gfx/interface/icons/control_level_icons.dds"
							framesize = { 64 64 }
							frame = "[FixedPointToInt( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_safety_emblem_frame_value' ) )]"
							alwaystransparent = yes
						}
						text_single = {
							position = { 50 6 }
							size = { 94 18 }
							autoresize = no
							align = left|nobaseline
							text = "KEHILLAH_DOM_DANGER_LABEL"
							using = Font_Size_Small
							alwaystransparent = yes
						}
						text_single = {
							position = { 50 24 }
							size = { 94 20 }
							autoresize = no
							align = left|nobaseline
							text = "KEHILLAH_DOM_DANGER_VALUE"
							alwaystransparent = yes
						}
					}
				}
			}

			button_standard = {
				size = { 540 28 }
				text = "kehillah_economy_view"
				onclick = "[OpenGameViewData( 'domicile', GetPlayer.GetDomicile.Self )]"
				onclick = "[GetVariableSystem.Clear( 'kehillah_lib_panel_open' )]"
				onclick = "[GetVariableSystem.Clear( 'show_building_panel' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_overview' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_patrons' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_followers' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_disciples' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_debtors' )]"
				onclick = "[GetVariableSystem.Clear( 'bookmark_artifacts' )]"
				onclick = "[GetScriptedGui('kehillah_economy_refresh').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				onclick = "[GetVariableSystem.Set( 'kehillah_households_panel_open', 'yes' )]"
			}
			# THE PILLARS: three 170 x 236 cards, 15 px apart, centred in 540;
			# each has a row of four driver chips (kehillah_dom_driver_chip).
			widget = {
				size = { 540 236 }

				hbox = {
					parentanchor = center
					spacing = 15

					kehillah_dom_pillar_card = {
						blockoverride "card_tooltip" { tooltip = "KEHILLAH_BD_PROSPERITY_TOOLTIP" }
						blockoverride "card_color" { color = { 0.537 0.710 0.584 1 } }
						blockoverride "card_icon" {
							texture = "gfx/interface/icons/prosperity_level_icons.dds"
							framesize = { 64 64 }
							frame = "[FixedPointToInt( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_tier_prosperity_value' ) )]"
						}
						blockoverride "card_name" { text = "KEHILLAH_HUD_PROSPERITY_LABEL" fontcolor = { 0.537255 0.709804 0.584314 1 } }
						blockoverride "card_score" { text = "[Title.Custom('KehillahProsperityScore')]" }
						blockoverride "card_tier" { text = "KEHILLAH_DOMAIN_PROSPERITY_TIER" }
						blockoverride "card_bar" {
							kehillah_dom_bar = {
								blockoverride "bar_frame" { texture = "gfx/interface/progressbars/kehillah_prosperity.dds" }
								blockoverride "bar_value" { value = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue]" }
								blockoverride "bar_red" { visible = "[LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)150' )]" }
								blockoverride "bar_orange" { visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)150' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)400' ) )]" }
								blockoverride "bar_standard" { visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)400' ), LessThan_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)700' ) )]" }
								blockoverride "bar_green" { visible = "[GreaterThanOrEqualTo_CFixedPoint( Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue, '(CFixedPoint)700' )]" }
								blockoverride "tick_before" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_settled_pos_prosperity_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "tick_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_settled_rest_prosperity_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "limit_visible" { visible = "[GreaterThan_CFixedPoint( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_has_limit_prosperity_value' ), '(CFixedPoint)0' )]" }
								blockoverride "limit_before" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_limit_pos_prosperity_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "limit_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_limit_rest_prosperity_value' ) ), '(float)1000', '(int32)1000' )]" }
								blockoverride "limit_tooltip" { tooltip = "KEHILLAH_DOM_PROSPERITY_LIMIT_TT" }
							}
						}
						blockoverride "card_heading" { text = "KEHILLAH_DOM_PROSPERITY_HEADING" }
