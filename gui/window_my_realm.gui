						visible = "[And( Not( IsLandlessAdventurer( Character ) ), And( Or( Not( IsNomad( Character ) ), Not( GuiLawGroup.GetLawGroup.HasFlag( 'dominance_law' ) ) ), And( Not( GuiLawGroup.GetLawGroup.HasFlag( 'republican_type_law' ) ), Not( IsLandlessMerchant( Character ) ) ) ) )]"

