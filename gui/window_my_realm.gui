								blockoverride "limit_after" { layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_limit_rest_greatness_value' ) ), '(float)1000', '(int32)1000' )]" }
