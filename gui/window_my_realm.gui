								blockoverride "chip_arrow" { frame = "[FixedPointToInt( Title.GetHolder.MakeScope.ScriptValue( 'kehillah_dom_drv_stability_network_frame_value' ) )]" }
							}
							kehillah_dom_driver_chip = {
