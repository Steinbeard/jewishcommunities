						blockoverride "card_effect" { text = "KEHILLAH_DOM_STABILITY_EFFECT" }
						blockoverride "perk_tooltip" { tooltip = "KEHILLAH_DOM_STABILITY_PERK_TT" }
						blockoverride "perk_icon" { texture = "gfx/interface/icons/message_feed/bodyguard.dds" }
						blockoverride "perk_text" { text = "KEHILLAH_DOM_STABILITY_PERK" }
					}

					kehillah_dom_pillar_card = {
						blockoverride "card_tooltip" { tooltip = "KEHILLAH_BD_GREATNESS_TOOLTIP" }
						blockoverride "card_color" { color = { 0.843 0.741 0.525 1 } }
