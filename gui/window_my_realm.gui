		### MONTHLY INCOME (2026-10-29, Daniel): what the community gives its
		### leader each month, one tile per resource in the form of vanilla's
		### domicile overview: the month's total (hover: vanilla's breakdown),
		### what the Quarter's buildings give (hover: the domicile's own
		### breakdown), and the pillar band that scales it. Gold also shows
		### what the host takes (2026-10-30, the charter's Tribute term); the
		### box's margins were trimmed for that line, so the tab's height holds.
		vbox = {
			visible = "[Character.GetGovernment.IsType( 'kehillah_government' )]"
			layoutpolicy_horizontal = expanding
			spacing = 7

			# Fixed widgets, banner and box, with the tiles centred by anchor.
			# Vanilla's expand is a "growing" hbox, and in a 540 px vbox or
			# hbox it still pushed the box ~70 px right and off the tab (live,
			# 2026-10-30, three tries); a bare text_label_center did too.
			widget = {
				size = { 540 34 }

				text_label_center = {
					parentanchor = center
					max_width = 240
					text = "KEHILLAH_DOMAIN_INCOME_HEADER"
					default_format = "#low"
					using = Font_Size_Medium
				}
			}

			# 2026-11-25 (third request): three cards in the pillar cards'
			# form, 170 wide and 15 apart (540), anchored in a fixed widget.
			widget = {
				size = { 540 110 }

				hbox = {
					parentanchor = top|hcenter
					spacing = 15

					kehillah_income_card = {
						blockoverride "inc_color" { color = { 0.85 0.68 0.30 1 } }
						blockoverride "inc_tooltip" { tooltip = "[Character.GetGoldTooltipWithBalance]" }
						blockoverride "inc_icon" { texture = "gfx/interface/icons/icon_gold.dds" }
						blockoverride "inc_total" { text = "KEHILLAH_DOMAIN_INCOME_GOLD_TOTAL" }
						blockoverride "inc_rows" {
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "[Character.GetDomicile.GetGoldResourceTooltip]" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_QUARTER" }
								blockoverride "row_value" { text = "KEHILLAH_INC_GOLD_QUARTER" }
							}
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "KEHILLAH_INC_GOLD_PILLAR_TT" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_AFFLUENCE" }
								blockoverride "row_value" { text = "[Character.GetPrimaryTitle.Custom('KehillahIncomeProsperityMod')]" }
							}
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "KEHILLAH_DOMAIN_INCOME_GOLD_HOST_TOOLTIP" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_TRIBUTE" }
								blockoverride "row_value" { text = "KEHILLAH_INC_GOLD_TRIBUTE" }
							}
						}
					}
					kehillah_income_card = {
						blockoverride "inc_color" { color = { 0.62 0.56 0.78 1 } }
						blockoverride "inc_tooltip" { tooltip = "[Character.GetPrestigeTooltipWithBalance]" }
						blockoverride "inc_icon" { texture = "[Character.GetPrestigeLevelTexture]" }
						blockoverride "inc_total" { text = "KEHILLAH_DOMAIN_INCOME_PRESTIGE_TOTAL" }
						blockoverride "inc_rows" {
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "[Character.GetDomicile.GetPrestigeResourceTooltip]" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_QUARTER" }
								blockoverride "row_value" { text = "KEHILLAH_INC_PRESTIGE_QUARTER" }
							}
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "KEHILLAH_INC_PRESTIGE_PILLAR_TT" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_GREATNESS" }
								blockoverride "row_value" { text = "[Character.GetPrimaryTitle.Custom('KehillahIncomeGreatnessMod')]" }
							}
						}
					}
					kehillah_income_card = {
						blockoverride "inc_color" { color = { 0.55 0.72 0.55 1 } }
						blockoverride "inc_tooltip" { tooltip = "[Character.GetPietyTooltipWithBalance]" }
						blockoverride "inc_icon" { texture = "[Character.GetPietyLevelTexture]" }
						blockoverride "inc_total" { text = "KEHILLAH_DOMAIN_INCOME_PIETY_TOTAL" }
						blockoverride "inc_rows" {
							kehillah_income_row = {
								blockoverride "row_tooltip" { tooltip = "[Character.GetDomicile.GetPietyResourceTooltip]" }
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_QUARTER" }
								blockoverride "row_value" { text = "KEHILLAH_INC_PIETY_QUARTER" }
							}
							kehillah_income_row = {
								blockoverride "row_label" { text = "KEHILLAH_INC_ROW_PILLARS" }
								blockoverride "row_value" { text = "KEHILLAH_INC_PIETY_PILLAR" }
							}
						}
					}
				}
			}
		}

		### TO HOST: one line, as the feudal footer's "To Liege" -- who, and
		### his outlook and stance. kehillah_host_ref is the top liege of the
		### Quarter's county (kehillah_host_outlook_watch_effect). The charter
		### is in the Laws tab (vbox_my_realm_laws_body), as a realm's laws are.
		# A fixed 540 x 34 widget, the row anchored at its left: an expand
		# spacer in the row pushed the box off-centre (live, 2026-10-30).
		vbox = {
			visible = "[Character.GetGovernment.IsType( 'kehillah_government' )]"
			datacontext = "[Character.GetPrimaryTitle]"
			layoutpolicy_horizontal = expanding

			# 2026-11-25 (fourth pass): the cards' own Background_Area, not a
			# brown bar; "Living under" (the header's Suzerain is the
			# community's liege, often a different ruler); the outlook pinned
			# to the right edge so it lines up with the cards above.
			widget = {
				size = { 540 30 }
				background = { using = Background_Area }

				# Fixed positions: in an hbox the label stretched and pushed
				# the name over the outlook (live).
				text_single = {
					parentanchor = left|vcenter
					position = { 12 0 }
					size = { 92 24 }
					autoresize = no
					align = left|nobaseline
					text = "KEHILLAH_DOMAIN_TO_HOST"
					default_format = "#weak"
				}
				# The holding card's clickable-name form (window_county_view.gui).
				button_normal = {
					visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).Char.IsAlive )]"
					datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).Char]"
					parentanchor = left|vcenter
					position = { 104 0 }
					size = { 170 24 }
					onclick = "[DefaultOnCharacterClick( Character.GetID )]"
					tooltip = "KEHILLAH_DOMAIN_HOST_TILE_TOOLTIP"
					using = tooltip_se
					text_single = {
						size = { 100% 100% }
						autoresize = no
						text = "[Character.GetShortUINameNoTooltip]"
						align = left|nobaseline
						default_format = "#clickable"
						alwaystransparent = yes
					}
				}
				text_single = {
					visible = "[And( GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).IsSet, GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).Char.IsAlive )]"
					datacontext = "[GetPlayer.MakeScope.Var( 'kehillah_host_ref' ).Char]"
					parentanchor = right|vcenter
					position = { -12 0 }
					size = { 250 24 }
					autoresize = no
					align = right|nobaseline
					text = "KEHILLAH_DOMAIN_HOST_LINE"
					tooltip = "KEHILLAH_HUD_HOST_TOOLTIP"
					using = tooltip_se
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[MyRealmWindow.GetTradeMarketDomainItems]"

			item = {

				vbox = {
					name = "trade_market_group"
					layoutpolicy_horizontal = expanding

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 8 0 }

						button_trade_market_group_header = {
							name = "trade_market_heading_tutorial_uses_this"
							datacontext = "[TradeMarketGroup.GetTradeMarket]"
						}

						hbox = {
							margin = { 0 8 }
							layoutpolicy_horizontal = expanding
							button_group = {
								layoutpolicy_horizontal = expanding
								onclick = "[TradeMarketGroup.ToggleExpanded]"

								flowcontainer = {
									spacing = 5

									widget = {
										size = { 18 22 }

										button_expand = {
											parentanchor = center
											frame = "[Select_int32( TradeMarketGroup.IsExpanded, '(int32)2', '(int32)1' )]"
										}
									}

									text_single = {
										text = "MY_REALM_WINDOW_MARKET_COUNTIES"
										default_format = "#low"
										align = nobaseline
									}
								}
							}
						}
					}

					vbox = {
						name = "county_group"
						visible = "[TradeMarketGroup.IsExpanded]"
						datamodel = "[TradeMarketGroup.GetCounties]"
						layoutpolicy_horizontal = expanding

						margin_top = 10
						margin_left = 15
						margin_bottom = 10
						spacing = 20

						item = {

							vbox = {
								datacontext = "[CountyGroup.GetCounty]"
								datacontext = "[CountyGroup.GetCapitalProvince.GetCounty]"
								datacontext = "[CountyGroup.AccessBreakdowns]"
								datacontext = "[CountyGroup.AccessComplexBars]"

								layoutpolicy_horizontal = expanding

								background = {
									margin_top = 10
									margin_bottom = 5
									margin_left = 20
									margin_right = 40

									texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
									spriteType = Corneredtiled
									spriteborder = { 40 8 }
									texture_density = 1

									modify_texture = {
										name = "mask"
										texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
										spriteType = Corneredstretched
										spriteborder = { 0 0 }
										blend_mode = alphamultiply
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									spacing = 10
									margin_bottom = 10

									coa_title_tiny = {}

									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										margin_top = -10

										text_single = {
											layoutpolicy_horizontal = expanding
											text = "TITLE_NAME_NO_TOOLTIP"
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 10

											hbox = {
												text_single = {
													text = MY_REALM_WINDOW_PROSPERITY
													max_width = 130
													tooltipwidget = {
														county_prosperity_tooltip_container = {}
													}
												}
											}

											hbox = {
												layoutpolicy_horizontal = expanding
												text_single = {
													name = "tutorial_highlight_control"
													text = MY_REALM_WINDOW_CONTROL
													max_width = 130
													tooltipwidget = {
														county_control_cooltip = {
															blockoverride "county_context" {
																datacontext = "[CountyDataBreakdowns.AccessControl( County.Self )]"
																datacontext = "[CountyComplexBars.AccessCountyControlBar( County.Self )]"
															}
														}
													}
												}
											}

											hbox = {
												layoutpolicy_horizontal = expanding
												hbox = {
													spacing = 5

													icon = {
														texture = "gfx/interface/icons/popular_opinion_levels.dds"
														framesize = { 64 64 }
														frame = "[Add_int32( County.GetOpinionLevel, '(int32)1' )]"
														size = { 15 15 }
													}

													text_single = {
														text = MY_REALM_WINDOW_POPULAR_OPINION
														max_width = 130
													}

													tooltipwidget = {
