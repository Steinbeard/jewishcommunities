##########################################################################
# LIBRARY OPENER (2026-11-25). An effect cannot set GUI variables, so script
# that wants the library window open -- the Missing Foundational Works top-bar
# notice, common/important_actions/kehillah_library_foundation_actions.txt --
# sets var:kehillah_lib_open_request on the player instead. This empty widget
# shows while that variable exists; as it shows it opens the library window
# on the player's own library (the same steps as the Libraries map click in
# gui/window_county_view.gui) and clears the request, which hides it again so
# the next request fires again. Registered in gui/scripted_widgets/
# kehillah_scripted_widgets.txt.
##########################################################################

widget = {
	name = "kehillah_library_opener"
	size = { 0 0 }
	visible = "[And( And( IsInGame, GetPlayer.IsValid ), GetPlayer.MakeScope.Var( 'kehillah_lib_open_request' ).IsSet )]"
	visible_at_creation = no

	state = {
		name = _show
		on_start = "[GetScriptedGui( 'kehillah_lib_open_request_consume' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		on_start = "[GetVariableSystem.Clear( 'kehillah_lib_selected_work' )]"
		on_start = "[GetVariableSystem.Clear( 'kehillah_lib_picked_work' )]"
		on_start = "[GetVariableSystem.Clear( 'kehillah_lib_parent_corpus' )]"
		on_start = "[GetVariableSystem.Clear( 'kehillah_lib_acquire_mode' )]"
		on_start = "[GetVariableSystem.Clear( 'kehillah_lib_catalog_mode' )]"
		on_start = "[GetScriptedGui( 'kehillah_lib_shelf_layout' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'library', GetPlayer.GetPrimaryTitle.MakeScope ).End )]"
		on_start = "[GetVariableSystem.Set( 'kehillah_lib_window_open', 'yes' )]"
	}
}
