### 2026-11-24 (Daniel: "can we include a link that opens up the spark UI?").
### Shown under kehillah_study_torah.0001's text when the reading gave a spark
### (the event's widget is_shown). Opens the reader's Learning window
### (gui/kehillah_learning_window.gui) on its Sparks tab; the event stays open.
hbox = {
	name = "event_window_widget_kehillah_sparks"
	layoutpolicy_horizontal = expanding
	margin_bottom = 8

	expand = {}

	button_standard = {
		name = "kehillah_event_sparks_button"
		size = { 200 34 }
		tooltip = "KEHILLAH_EVENT_SPARKS_BUTTON_TT"
		using = tooltip_ne
		onclick = "[GetScriptedGui( 'kehillah_learning_open' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', GetPlayer.MakeScope ).End )]"
		onclick = "[GetVariableSystem.Set( 'kehillah_learning_tab', 'sparks' )]"
		onclick = "[GetVariableSystem.Set( 'kehillah_learning_open', 'yes' )]"

		hbox = {
			parentanchor = center
			set_parent_size_to_minimum = yes
			spacing = 6

			icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/inspirations/book_inspiration.dds"
				alwaystransparent = yes
			}
			text_single = {
				text = "KEHILLAH_EVENT_SPARKS_BUTTON"
				align = nobaseline
				alwaystransparent = yes
			}
		}
	}

	expand = {}
}
