hbox = {
	name = "kehillah_bet_din_progress"
	spacing = 5
	datacontext = "[ActivityWindow.GetActivity]"
	visible = "[EqualTo_string( ActivityType.GetKey(), 'activity_kehillah_bet_din_conference' )]"

	text_single = {
		text = "kehillah_din_progress_unscored"
		align = nobaseline
		max_width = 200
		visible = "[LessThanOrEqualTo_CFixedPoint( Activity.MakeScope.Var( 'kehillah_bet_din_cases_heard_count' ).GetValue, '(CFixedPoint)0' )]"
	}
	text_single = {
		text = "kehillah_din_progress_scored"
		align = nobaseline
		max_width = 200
		visible = "[GreaterThan_CFixedPoint( Activity.MakeScope.Var( 'kehillah_bet_din_cases_heard_count' ).GetValue, '(CFixedPoint)0' )]"
	}
	progressbar_standard = {
		layoutpolicy_horizontal = expanding
		size = { 200 30 }
		value = "[Activity.MakeScope.Var( 'kehillah_bet_din_session_score' ).GetValue]"
		max = 5
		min = 0
		using = Progressbar_Changed_Animation
		tooltip = kehillah_din_progress_tooltip
	}
}
