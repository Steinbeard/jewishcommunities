# My Realm > Laws for a Kehillah leader, as a dashboard (2026-11-25,
# docs/implementation/2026-11-25-laws-dashboard.md): the charter's terms as
# cards in two columns, each rated by three pips and a colour strip (green
# generous, amber middling, red harsh), under a header card with the
# charter's overall favour and the petition button. Used in
# gui/window_my_realm.gui (vbox_my_realm_laws_body). Fixed sizes, no expand
# in fixed rows (the Domain tab's lesson).
types KehillahLawsDashboard
{
	### Three pips over a 0-3 progressbar.
	type kehillah_laws_pips3 = widget {
		size = { 51 10 }
		block "pips_bar" {}
		icon = { size = { 2 10 } position = { 16 0 } texture = "gfx/interface/colors/white.dds" color = { 0.05 0.05 0.05 1 } alwaystransparent = yes }
		icon = { size = { 2 10 } position = { 33 0 } texture = "gfx/interface/colors/white.dds" color = { 0.05 0.05 0.05 1 } alwaystransparent = yes }
	}

	### One charter term, 258 x 56. datacontext: the community title.
	### Override: card_visible, card_tooltip, card_icon, card_label,
	### card_value, card_favour (the 1-3 script value's name goes in the
	### three strip visibilities and the pips).
	type kehillah_laws_term_card = widget {
		size = { 258 56 }
		block "card_visible" {}
		background = { using = Background_Area }
		using = tooltip_se
		block "card_tooltip" {}

		# The strip: one of three colours by favour.
		icon = {
			size = { 4 56 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.42 0.64 0.30 1 }
			alwaystransparent = yes
			block "strip_good" { visible = no }
		}
		icon = {
			size = { 4 56 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.82 0.60 0.22 1 }
			alwaystransparent = yes
			block "strip_mid" { visible = no }
		}
		icon = {
			size = { 4 56 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.75 0.25 0.20 1 }
			alwaystransparent = yes
			block "strip_bad" { visible = no }
		}

		icon = {
			parentanchor = left|vcenter
			position = { 12 0 }
			size = { 40 40 }
			alwaystransparent = yes
			block "card_icon" {}
		}
		text_single = {
			position = { 60 7 }
			size = { 130 18 }
			autoresize = no
			align = left|nobaseline
			using = Font_Size_Small
			default_format = "#weak"
			alwaystransparent = yes
			block "card_label" {}
		}
		text_single = {
			position = { 60 26 }
			size = { 190 22 }
			autoresize = no
			align = left|nobaseline
			alwaystransparent = yes
			block "card_value" {}
		}
		kehillah_laws_pips3 = {
			parentanchor = right|top
			position = { -10 11 }
			block "card_pips" {}
		}
	}
}
