# My Realm > Laws for a Kehillah leader, as a dashboard (2026-11-25,
# docs/implementation/2026-11-25-laws-dashboard.md): the charter's terms as
# cards in two columns, each rated by a colour strip (green
# generous, amber middling, red harsh), under a header card with the
# charter's overall favour and the petition button. Used in
# gui/window_my_realm.gui (vbox_my_realm_laws_body). Fixed sizes, no expand
# in fixed rows (the Domain tab's lesson).
types KehillahLawsDashboard
{
	### One charter term, 258 x 50. datacontext: the community title.
	### Override: card_visible, card_tooltip, card_icon (and card_icon_alt
	### for a second picture shown by visibility), card_label, card_value,
	### and the three strip visibilities by favour.
	### 2026-11-25 second pass: the three favour pips are gone (they drew as
	### dark notches live; the strip already says the favour), and the card
	### is 6 px lower so the tab fits once the vanilla law rows show.
	type kehillah_laws_term_card = widget {
		size = { 258 50 }
		block "card_visible" {}
		background = { using = Background_Area }
		using = tooltip_se
		block "card_tooltip" {}

		# The strip: one of three colours by favour.
		icon = {
			size = { 4 50 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.42 0.64 0.30 1 }
			alwaystransparent = yes
			block "strip_good" { visible = no }
		}
		icon = {
			size = { 4 50 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.82 0.60 0.22 1 }
			alwaystransparent = yes
			block "strip_mid" { visible = no }
		}
		icon = {
			size = { 4 50 }
			texture = "gfx/interface/colors/white.dds"
			color = { 0.75 0.25 0.20 1 }
			alwaystransparent = yes
			block "strip_bad" { visible = no }
		}

		icon = {
			parentanchor = left|vcenter
			position = { 12 0 }
			size = { 36 36 }
			alwaystransparent = yes
			block "card_icon" {}
		}
		icon = {
			parentanchor = left|vcenter
			position = { 12 0 }
			size = { 36 36 }
			alwaystransparent = yes
			block "card_icon_alt" { visible = no }
		}
		text_single = {
			position = { 56 5 }
			size = { 194 18 }
			autoresize = no
			align = left|nobaseline
			using = Font_Size_Small
			default_format = "#weak"
			alwaystransparent = yes
			block "card_label" {}
		}
		text_single = {
			position = { 56 23 }
			size = { 194 22 }
			autoresize = no
			align = left|nobaseline
			alwaystransparent = yes
			block "card_value" {}
		}
	}
}
