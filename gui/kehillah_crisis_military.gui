# Military community-safety dashboard. The content block belongs inside the native scrollbox.
types KehillahCrisis {
 type kehillah_crisis_military_panel = vbox {
  layoutpolicy_horizontal = expanding
  layoutpolicy_vertical = expanding
  visible = "[And(GetScriptedGui('kehillah_crisis_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.Exists('kehillah_crisis_armies')))]"
  scrollbox = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   blockoverride "scrollbox_content" {
    vbox = { layoutpolicy_horizontal = expanding spacing = 12 margin = { 8 12 }
     vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 }
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_phase_header" default_format = "#high;bold" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisPhase')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_organizer" visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_mob_threat').IsSet]" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_risk" tooltip = "kehillah_crisis_risk_tt" using = tooltip_ws }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_protection_active" visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_royal_protection').IsSet]" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_open_situation"
 visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').IsSet]"
 onclick = "[ToggleGameViewData( GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').Situation.GetWindowName, GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').Situation.GetID )]" }

 }
vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 } visible = "[GetScriptedGui('kehillah_crisis_warning_display').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_warning_header" default_format = "#high;bold" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_warning_numbers" tooltip = "kehillah_crisis_warning_tt" using = tooltip_ws }
progressbar_red = { layoutpolicy_horizontal = expanding size = { 0 16 } min = 0 max = 100 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_crisis_outbreak_chance_value')]" tooltip = "kehillah_crisis_warning_tt" using = tooltip_ws }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_show_military_actions"
 visible = "[And(GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').IsSet, Not(GetVariableSystem.Exists('kehillah_crisis_show_military_actions')))]"
 onclick = "[GetVariableSystem.Set('kehillah_crisis_show_military_actions', 'yes')]" }

 }

vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 } visible = "[And(GetScriptedGui('kehillah_crisis_warning_display').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Or(Not(GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').IsSet), GetVariableSystem.Exists('kehillah_crisis_show_military_actions')))]"
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_actions_header" default_format = "#high;bold" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 34 } text = "kehillah_crisis_hide_military_actions"
 visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').IsSet]"
 onclick = "[GetVariableSystem.Clear('kehillah_crisis_show_military_actions')]" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisPending')]"  }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_watch"
 enabled = "[GetScriptedGui('kehillah_crisis_watch').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('kehillah_crisis_watch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "kehillah_crisis_action_watch_tt" using = tooltip_ws  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_effect_watch" default_format = "#small;F" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_supplies"
 enabled = "[GetScriptedGui('kehillah_crisis_supplies').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('kehillah_crisis_supplies').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "kehillah_crisis_action_supplies_tt" using = tooltip_ws  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_effect_supplies" default_format = "#small;F" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_routes"
 enabled = "[GetScriptedGui('kehillah_crisis_routes').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('kehillah_crisis_routes').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "kehillah_crisis_action_routes_tt" using = tooltip_ws  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_effect_routes" default_format = "#small;F" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_advocacy"
 enabled = "[GetScriptedGui('kehillah_crisis_advocacy').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('kehillah_crisis_advocacy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "kehillah_crisis_action_advocacy_tt" using = tooltip_ws  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_effect_advocacy" default_format = "#small;F" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_actions_hint" default_format = "#small;F" }

 }
 vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 } visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_mob_threat').IsSet]"
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_readiness_header" default_format = "#high;bold" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisRefuge')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisMen')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisCondemn')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisWatch')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisSupplies')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisRoutes')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisAdvocacy')]"  }

 }
vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 } visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_mob_threat').IsSet]"
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_diplomacy_header" default_format = "#high;bold" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_diplomacy_pending" visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_mob_messenger').IsSet]" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_leader_away" visible = "[GetPlayer.MakeScope.Var('kehillah_mob_away').IsSet]" }
button_standard = { layoutpolicy_horizontal = expanding size = { 0 40 } text = "kehillah_crisis_action_council"
 enabled = "[GetScriptedGui('kehillah_crisis_council').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('kehillah_crisis_council').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "kehillah_crisis_action_council_tt" using = tooltip_ws  }

 }
vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 } visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_outcome').IsSet]"
 background = { using = Background_Area_Dark }
 text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_outcome_header" default_format = "#high;bold" }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisOutcome')]"  }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "[GetPlayer.Custom('KehillahCrisisResponse')]"  }

 }
text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_crisis_peace_hint" visible = "[Not(GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_mob_threat').IsSet)]" default_format = "#F" }

    }
   }
  }
 }
}
