# Military community-safety dashboard. The content block belongs inside the native scrollbox.
# Peacetime planning: background incident risk, its pressures and protection,
# then links to existing levers. An active crisis lives in its own situation.
types KehillahCrisis {
 # A crisis card: the situation's icon, name and phase; click to open its window.
 type kehillah_safety_situation_card = button_standard {
  layoutpolicy_horizontal = expanding
  size = { 0 62 }
  onclick = "[ToggleGameViewData( Situation.GetWindowName, Situation.GetID )]"
  tooltip = "kehillah_safety_open_situation_tt"
  using = tooltip_ws
  hbox = {
   size = { 100% 100% }
   margin = { 10 0 }
   spacing = 10
   icon = { size = { 46 46 } texture = "[Situation.GetIcon]" alwaystransparent = yes }
   vbox = {
    layoutpolicy_horizontal = expanding
    text_single = { layoutpolicy_horizontal = expanding text = "[Situation.GetNameNoTooltip]" default_format = "#high;bold" alwaystransparent = yes }
    text_single = { layoutpolicy_horizontal = expanding text = "kehillah_safety_situation_phase" alwaystransparent = yes }
   }
   text_single = { text = "kehillah_safety_open_situation" default_format = "#clickable" alwaystransparent = yes }
  }
 }

 type kehillah_crisis_military_panel = vbox {
  layoutpolicy_horizontal = expanding
  layoutpolicy_vertical = expanding
  visible = "[And(GetScriptedGui('kehillah_crisis_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.Exists('kehillah_crisis_armies')))]"
  scrollbox = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   blockoverride "scrollbox_content" {
    vbox = { layoutpolicy_horizontal = expanding spacing = 12 margin = { 8 12 }

     ### CRISES UNDER WAY: a card per open situation, each opening its window.
     vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 }
      visible = "[GetScriptedGui('kehillah_safety_any_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      background = { using = Background_Area_Dark }
      text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_safety_live_header" default_format = "#high;bold" }
      vbox = { layoutpolicy_horizontal = expanding
       visible = "[GetScriptedGui('kehillah_safety_attack_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       kehillah_safety_situation_card = { datacontext = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_situation').Situation]" }
      }
      vbox = { layoutpolicy_horizontal = expanding
       visible = "[GetScriptedGui('kehillah_safety_trial_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       kehillah_safety_situation_card = { datacontext = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_trial_situation').Situation]" }
      }
      vbox = { layoutpolicy_horizontal = expanding
       visible = "[GetScriptedGui('kehillah_safety_decree_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       kehillah_safety_situation_card = { datacontext = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_decree_situation').Situation]" }
      }
     }



     ### AMBIENT INCIDENT RISK: one status; exact factors live in its tooltip.
     vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 14 14 }
      background = { using = Background_Area_Dark }
      tooltip = "kehillah_safety_danger_planning_tt"
      using = tooltip_ws
      text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 490 text = "kehillah_safety_danger_header" default_format = "#high;bold" }
      hbox = { layoutpolicy_horizontal = expanding spacing = 12
       text_single = { text = "[GetPlayer.Custom('KehillahDangerBand')]" using = Font_Size_Big }
       text_single = { text = "kehillah_safety_danger_chance" }
       expand = {}
      }
      hbox = { layoutpolicy_horizontal = expanding spacing = 4
       visible = "[Not(GetScriptedGui('kehillah_safety_any_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
       vbox = { spacing = 3
        progressbar_green = { size = { 92 14 } min = 0 max = 1 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_safety_fill_calm_value')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_calm" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)0')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_calm_off" visible = "[NotEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)0')]" }
       }
       vbox = { spacing = 3
        progressbar_standard = { size = { 92 14 } min = 0 max = 1 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_safety_fill_uneasy_value')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_uneasy" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)1')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_uneasy_off" visible = "[NotEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)1')]" }
       }
       vbox = { spacing = 3
        progressbar_red = { size = { 92 14 } min = 0 max = 1 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_safety_fill_tense_value')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_tense" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)2')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_tense_off" visible = "[NotEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)2')]" }
       }
       vbox = { spacing = 3
        progressbar_red = { size = { 92 14 } min = 0 max = 1 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_safety_fill_dangerous_value')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_dangerous" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)3')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_dangerous_off" visible = "[NotEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)3')]" }
       }
       vbox = { spacing = 3
        progressbar_red = { size = { 92 14 } min = 0 max = 1 value = "[GetPlayer.MakeScope.ScriptValue('kehillah_safety_fill_perilous_value')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_perilous" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)4')]" }
        text_single = { size = { 92 20 } autoresize = no align = center|nobaseline text = "kehillah_safety_band_perilous_off" visible = "[NotEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('kehillah_safety_band_index_value'), '(CFixedPoint)4')]" }
       }
       expand = {}
      }
     }

     ### THE CAUSES: two pressures and separate visibility. Each row holds its breakdown on hover.
     vbox = { layoutpolicy_horizontal = expanding spacing = 9 margin = { 14 14 }
      background = { using = Background_Area_Dark }
      text_single = { text = "kehillah_safety_pressures_header" default_format = "#high;bold" }
      hbox = { layoutpolicy_horizontal = expanding spacing = 8 tooltip = "kehillah_safety_court_tt" using = tooltip_ws
       text_single = { text = "kehillah_safety_court_label" }
       expand = {}
       text_single = { text = "[GetPlayer.Custom('KehillahCourtPressureBand')]" }
      }
      hbox = { layoutpolicy_horizontal = expanding spacing = 8 tooltip = "kehillah_safety_popular_tt" using = tooltip_ws
       text_single = { text = "kehillah_safety_popular_label" }
       expand = {}
       text_single = { text = "[GetPlayer.Custom('KehillahPopularPressureBand')]" }
      }
      text_single = { text = "kehillah_safety_visibility_summary" tooltip = "kehillah_safety_visibility_tt" using = tooltip_ws }
     }

     ### PROTECTION AND LEVERS. These navigate to actual existing systems.
     vbox = { layoutpolicy_horizontal = expanding spacing = 9 margin = { 14 14 }
      background = { using = Background_Area_Dark }
      text_single = { text = "kehillah_safety_protection_header" default_format = "#high;bold" }
      text_single = { text = "kehillah_safety_stability_summary" tooltip = "kehillah_safety_stability_tt" using = tooltip_ws }
      text_single = { text = "kehillah_safety_ruler_summary" tooltip = "kehillah_safety_ruler_tt" using = tooltip_ws }
      text_single = { text = "kehillah_safety_shields_summary" tooltip = "kehillah_safety_shields_tt" using = tooltip_ws }
      text_single = { text = "kehillah_safety_shield_protection_on" visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_royal_protection').IsSet]" tooltip = "kehillah_safety_shields_tt" using = tooltip_ws }
      text_single = { text = "kehillah_safety_shield_protection_off" visible = "[Not(GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_crisis_royal_protection').IsSet)]" tooltip = "kehillah_safety_shields_tt" using = tooltip_ws }
      hbox = { layoutpolicy_horizontal = expanding spacing = 8
       visible = "[Not(GetScriptedGui('kehillah_safety_any_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
       button_standard = { layoutpolicy_horizontal = expanding size = { 0 38 } text = "kehillah_safety_bet_din_action"
        onclick = "[ToggleGameView('activity_list_window')]" tooltip = "kehillah_safety_bet_din_action_tt" using = tooltip_ws }
       button_standard = { layoutpolicy_horizontal = expanding size = { 0 38 } text = "kehillah_safety_petition_action"
        onclick = "[ToggleGameViewData('council_window', GetPlayer.GetID)]" tooltip = "kehillah_safety_petition_action_tt" using = tooltip_ws }
      }
      text_single = { text = "kehillah_safety_religious_support_on" visible = "[GetPlayer.GetPrimaryTitle.MakeScope.Var('kehillah_safety_religious_support').IsSet]" tooltip = "kehillah_safety_religious_support_tt" using = tooltip_ws }
      button_standard = { layoutpolicy_horizontal = expanding size = { 0 36 } text = "kehillah_safety_religious_support_action"
       visible = "[And(GetScriptedGui('kehillah_safety_religious_route').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('kehillah_safety_any_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
       onclick = "[ToggleGameViewData('council_window', GetPlayer.GetID)]" tooltip = "kehillah_safety_religious_support_tt" using = tooltip_ws }
      text_single = { text = "kehillah_safety_crisis_hint" visible = "[GetScriptedGui('kehillah_safety_any_card').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
     }

    }
   }
  }
 }
}
