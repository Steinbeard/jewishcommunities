types KehillahLeadershipStyle {
 type kehillah_leadership_style_panel = vbox {
  size = { 540 0 }
  spacing = 6
  margin = { 12 8 }
  visible = "[GetPlayer.GetGovernment.IsType('kehillah_government')]"
  background = { using = Background_Area_Dark }
  text_single = { layoutpolicy_horizontal = expanding text = "kehillah_leadership_header" default_format = "#high;bold" }
  text_single = { layoutpolicy_horizontal = expanding text = "[GetPlayer.GetPrimaryTitle.Custom('KehillahLeadershipStyleStatus')]" using = Font_Size_Small }
  text_single = {
   layoutpolicy_horizontal = expanding
   text = "kehillah_leadership_reminder"
   default_format = "#high"
   visible = "[GetScriptedGui('kehillah_leadership_unselected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
  hbox = {
   spacing = 6
   button_standard = {
    size = { 168 40 }
    text = "kehillah_leadership_scholarly_button"
    down = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    # Selected buttons stay fully enabled visually. Repeated clicks are guarded no-ops.
    enabled = "[Or(GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_scholarly').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    onclick = "[GetScriptedGui('kehillah_leadership_choose_scholarly').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    tooltip = "kehillah_leadership_scholarly_tt"
    using = tooltip_se
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     background = { using = Background_Area_Solid color = { 0.776 0.627 0.322 0.08 } }
    }
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.776 0.627 0.322 0.42 } }
    }
    widget = {
     parentanchor = top|left
     size = { 100% 3 }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.776 0.627 0.322 1 } }
    }
   }
   button_standard = {
    size = { 168 40 }
    text = "kehillah_leadership_political_button"
    down = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    # Selected buttons stay fully enabled visually. Repeated clicks are guarded no-ops.
    enabled = "[Or(GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_political').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    onclick = "[GetScriptedGui('kehillah_leadership_choose_political').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    tooltip = "kehillah_leadership_political_tt"
    using = tooltip_se
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     background = { using = Background_Area_Solid color = { 0.392 0.522 0.651 0.08 } }
    }
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.392 0.522 0.651 0.42 } }
    }
    widget = {
     parentanchor = top|left
     size = { 100% 3 }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.392 0.522 0.651 1 } }
    }
   }
   button_standard = {
    size = { 168 40 }
    text = "kehillah_leadership_commercial_button"
    down = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    # Selected buttons stay fully enabled visually. Repeated clicks are guarded no-ops.
    enabled = "[Or(GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_commercial').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    onclick = "[GetScriptedGui('kehillah_leadership_choose_commercial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    tooltip = "kehillah_leadership_commercial_tt"
    using = tooltip_se
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     background = { using = Background_Area_Solid color = { 0.341 0.584 0.408 0.08 } }
    }
    widget = {
     size = { 100% 100% }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.341 0.584 0.408 0.42 } }
    }
    widget = {
     parentanchor = top|left
     size = { 100% 3 }
     alwaystransparent = yes
     visible = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     background = { using = Background_Area_Solid color = { 0.341 0.584 0.408 1 } }
    }
   }
  }
  text_multi = {
   layoutpolicy_horizontal = expanding
   autoresize = yes
   max_width = 516
   text = "[GetPlayer.GetPrimaryTitle.Custom('KehillahLeadershipStyleEffects')]"
   using = Font_Size_Small
  }
 }
}
