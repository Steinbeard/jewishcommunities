types KehillahLeadershipStyle {
 # 2026-11-16: restyled in the adventurer Camp Purpose design language
 # (vanilla window_my_realm.gui, widget_realm_law_camp_purpose): a centred
 # label, then illustrated 160px tiles with a dark caption band, the chosen
 # tile pressed, glowing and captioned "We Are ...!". The choice logic is
 # unchanged: the same scripted GUIs decide shown/valid/execute.
 type kehillah_leadership_style_panel = vbox {
  size = { 540 0 }
  spacing = 8
  margin = { 12 10 }
  visible = "[GetPlayer.GetGovernment.IsType('kehillah_government')]"

  text_label_center = { text = "kehillah_leadership_header" }

  text_single = {
   text = "kehillah_leadership_reminder"
   default_format = "#high"
   visible = "[GetScriptedGui('kehillah_leadership_unselected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }

  hbox = {
   spacing = 10
   kehillah_leadership_style_tile = {
    blockoverride "tile_tooltip" { tooltip = "kehillah_leadership_scholarly_tt" }
    blockoverride "tile_texture" { texture = "gfx/interface/icons/laws/camp_purpose_scholars.dds" }
    blockoverride "tile_active" { visible = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    blockoverride "tile_inactive" { visible = "[Not(GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
    blockoverride "tile_button" {
     down = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     # Selected tiles stay enabled visually. Repeated clicks are guarded no-ops.
     enabled = "[Or(GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_scholarly').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
     onclick = "[GetScriptedGui('kehillah_leadership_choose_scholarly').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "tile_label" { text = "kehillah_leadership_scholarly_button" }
    blockoverride "tile_label_selected" { text = "kehillah_leadership_scholarly_selected" }
   }
   kehillah_leadership_style_tile = {
    blockoverride "tile_tooltip" { tooltip = "kehillah_leadership_political_tt" }
    blockoverride "tile_texture" { texture = "gfx/interface/icons/powerful_family_bonus/service.dds" }
    blockoverride "tile_active" { visible = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    blockoverride "tile_inactive" { visible = "[Not(GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
    blockoverride "tile_button" {
     down = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     enabled = "[Or(GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_political').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
     onclick = "[GetScriptedGui('kehillah_leadership_choose_political').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "tile_label" { text = "kehillah_leadership_political_button" }
    blockoverride "tile_label_selected" { text = "kehillah_leadership_political_selected" }
   }
   kehillah_leadership_style_tile = {
    blockoverride "tile_tooltip" { tooltip = "kehillah_leadership_commercial_tt" }
    blockoverride "tile_texture" { texture = "gfx/interface/icons/theme_administration_types/icon_civilian_administration.dds" }
    blockoverride "tile_active" { visible = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    blockoverride "tile_inactive" { visible = "[Not(GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
    blockoverride "tile_button" {
     down = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     enabled = "[Or(GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('kehillah_leadership_choose_commercial').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
     onclick = "[GetScriptedGui('kehillah_leadership_choose_commercial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "tile_label" { text = "kehillah_leadership_commercial_button" }
    blockoverride "tile_label_selected" { text = "kehillah_leadership_commercial_selected" }
   }
  }

  # 2026-11-25 dashboard (docs/implementation/2026-11-25-laws-dashboard.md):
  # the style in force as a card -- its tile picture small at the left, the
  # name and mandate, then what it does -- instead of loose lines of text.
  # 12 + 64 + 12 + 416 + 12 = 516, the panel's inner width.
  hbox = {
   min_width = 516
   max_width = 516
   margin = { 12 10 }
   spacing = 12
   background = {
    using = Background_Area_Dark
    color = { 0.16 0.14 0.12 0.8 }
    margin = { 2 2 }
   }

   widget = {
    size = { 64 64 }
    icon = { size = { 64 64 } texture = "gfx/interface/icons/laws/camp_purpose_scholars.dds" visible = "[GetScriptedGui('kehillah_leadership_active_scholarly').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    icon = { size = { 64 64 } texture = "gfx/interface/icons/powerful_family_bonus/service.dds" visible = "[GetScriptedGui('kehillah_leadership_active_political').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    icon = { size = { 64 64 } texture = "gfx/interface/icons/theme_administration_types/icon_civilian_administration.dds" visible = "[GetScriptedGui('kehillah_leadership_active_commercial').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    # None chosen: the scholars' picture, dimmed, as scholarly rules apply.
    icon = { size = { 64 64 } texture = "gfx/interface/icons/laws/camp_purpose_scholars.dds" alpha = 0.35 visible = "[GetScriptedGui('kehillah_leadership_unselected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
   }
   vbox = {
    min_width = 416
    max_width = 416
    spacing = 2
    text_single = {
     size = { 416 24 }
     autoresize = no
     align = left|nobaseline
     text = "kehillah_leadership_card_title"
     using = Font_Size_Medium
     visible = "[Not(GetScriptedGui('kehillah_leadership_unselected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    }
    text_single = {
     size = { 416 24 }
     autoresize = no
     align = left|nobaseline
     text = "kehillah_leadership_card_title_none"
     using = Font_Size_Medium
     visible = "[GetScriptedGui('kehillah_leadership_unselected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    text_single = {
     size = { 416 18 }
     autoresize = no
     align = left|nobaseline
     text = "[GetPlayer.GetPrimaryTitle.Custom('KehillahLeadershipStyleStatus')]"
     default_format = "#weak"
     using = Font_Size_Small
    }
    text_multi = {
     min_width = 416
     max_width = 416
     autoresize = yes
     margin_top = 4
     text = "[GetPlayer.GetPrimaryTitle.Custom('KehillahLeadershipStyleEffects')]"
     using = Font_Size_Small
    }
   }
  }
 }

 # One illustrated choice, after vanilla's widget_realm_law_camp_purpose.
 type kehillah_leadership_style_tile = widget {
  size = { 160 160 }
  block "tile_tooltip" {}
  using = tooltip_ws
  tooltip_offset = { 0 40 }

  button_standard_clean = {
   size = { 160 160 }
   block "tile_button" {}

   background = {
    texture = "gfx/interface/component_tiles/tile_vignette_3px.dds"
    spriteType = Corneredtiled
    spriteborder = { 5 5 }
    margin = { -2 -2 }
   }

   icon = {
    size = { 160 160 }
    alwaystransparent = yes
    block "tile_texture" {}
   }

   widget = {
    parentanchor = bottom
    size = { 100% 30 }
    alwaystransparent = yes
    background = { using = Background_Area_Dark }

    text_single = {
     block "tile_inactive" {}
     parentanchor = center
     position = { 3 -2 }
     block "tile_label" {}
     default_format = "#weak"
     max_width = 150
     margin = { 5 0 }
    }

    text_single = {
     block "tile_active" {}
     parentanchor = center
     position = { 3 -2 }
     block "tile_label_selected" {}
     default_format = "#high;EMP"
     max_width = 150
     margin = { 5 0 }
    }
   }

   selection_glow = {
    block "tile_active" {}
   }
  }
 }
}
