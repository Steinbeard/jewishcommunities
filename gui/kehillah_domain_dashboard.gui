# My Realm > Domain for a Kehillah leader, as a dashboard (2026-11-25,
# docs/implementation/2026-11-25-domain-dashboard.md): a hero card for the
# community's Standing with a danger chip, then the three pillars as cards
# side by side. Used in gui/window_my_realm.gui (vbox_my_realm_domain_body).
# Fixed widths throughout: the tab holds about 555 px and every box is 540;
# vanilla's expand in a fixed row pushed boxes off the tab before (live,
# 2026-10-29/30), so rows here are anchored, not expanded.
types KehillahDomainDashboard
{
	### A pillar's bar, 154 px: coloured by band like kehillah_pillar_bar,
	### with a pale tick where the pillar settles (its baseline under the
	### ceiling) and, 2026-11-26, a red marker at its limit (the ceiling its
	### gate building sets) with its own tooltip. The bar is transparent so
	### the card's breakdown shows over it; the marker's tooltip still works
	### (a child of a transparent container keeps its own tooltip, as in
	### vanilla's window_decisions_detail.gui vassal approval).
	type kehillah_dom_bar = widget {
		size = { 154 14 }
		alwaystransparent = yes

		background = {
			block "bar_frame" { texture = "gfx/interface/progressbars/kehillah_prosperity.dds" }
			spriteType = Corneredstretched
			spriteborder = { 2 2 }
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_red" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_red.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_orange" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_orange.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_standard" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_standard.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_green" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_green.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		# The settled tick: two stretch factors either side of a 2 px mark.
		hbox = {
			parentanchor = center
			size = { 150 14 }
			alwaystransparent = yes
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				block "tick_before" {}
			}
			icon = { size = { 2 14 } texture = "gfx/interface/colors/white.dds" color = { 0.98 0.93 0.78 1 } alwaystransparent = yes }
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				block "tick_after" {}
			}
		}
		# The limit: a 2 px red mark in an 8 px hover area, so the tooltip is
		# easy to reach. Hidden when the gate track is complete (no limit).
		hbox = {
			parentanchor = center
			size = { 150 14 }
			alwaystransparent = yes
			block "limit_visible" { visible = no }
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				alwaystransparent = yes
				block "limit_before" {}
			}
			widget = {
				size = { 8 16 }
				using = tooltip_se
				block "limit_tooltip" {}
				icon = {
					parentanchor = center
					size = { 2 16 }
					texture = "gfx/interface/colors/white.dds"
					color = { 0.86 0.32 0.26 1 }
					alwaystransparent = yes
				}
			}
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				alwaystransparent = yes
				block "limit_after" {}
			}
		}
	}

	### One driver chip, 36 x 34: a group of the pillar's baseline terms as
	### an icon with vanilla's coloured change arrow in its corner (red
	### double-down to green double-up, kehillah_dom_drv_*_frame_value). The
	### tooltip names the group, says how hard it pushes in words, and lists
	### its terms with the same lines as the pillar's full breakdown.
	type kehillah_dom_driver_chip = widget {
		size = { 36 34 }
		background = { using = Background_Area_Dark }
		using = tooltip_se
		block "chip_tooltip" {}
		icon = {
			position = { 2 3 }
			size = { 26 26 }
			alwaystransparent = yes
			block "chip_icon" {}
		}
		icon = {
			parentanchor = right|bottom
			position = { -1 -1 }
			size = { 15 15 }
			texture = "gfx/interface/icons/change_indicator_icons_colored_up_good.dds"
			framesize = { 26 26 }
			alwaystransparent = yes
			block "chip_arrow" { frame = 3 }
		}
	}

	### One pillar card, 170 px wide: a colour strip, the tier icon beside
	### the name and score, the tier and trend, the bar, where it is heading,
	### and what its band does. The pillar's breakdown is the card's tooltip.
	### datacontext: the community title.
	### Fixed 170 x 176 so the three cards line up (first pass, 2026-11-25
	### live: cards of different heights sat at different heights and the
	### tallest rode up into the hero). Content is centred and top-aligned
	### (the expand at the foot takes the slack).
	### 2026-11-25 (second request): a row of four driver chips under
	### "Heading for", 38 px more.
	### 2026-11-25 (third request): one "what it opens" line at the foot,
	### the pillar's standing for the wider system (tzedakah, danger,
	### she'elot), with the whole ladder as its tooltip. 22 px more.
	type kehillah_dom_pillar_card = vbox {
		minimumsize = { 170 236 }
		maximumsize = { 170 236 }
		margin = { 8 0 }
		margin_bottom = 8
		spacing = 4
		background = { using = Background_Area }
		using = tooltip_se
		block "card_tooltip" {}

		icon = {
			size = { 154 3 }
			texture = "gfx/interface/colors/white.dds"
			alwaystransparent = yes
			block "card_color" { color = { 0.5 0.5 0.5 1 } }
		}
		hbox = {
			spacing = 6
			icon = {
				size = { 42 42 }
				alwaystransparent = yes
				block "card_icon" {}
			}
			vbox = {
				text_single = {
					align = left|nobaseline
					max_width = 104
					using = Font_Size_Medium
					alwaystransparent = yes
					block "card_name" {}
				}
				text_single = {
					align = left|nobaseline
					max_width = 104
					using = Font_Size_Big
					alwaystransparent = yes
					block "card_score" {}
				}
			}
		}
		text_single = {
			size = { 154 20 }
			autoresize = no
			align = center|nobaseline
			alwaystransparent = yes
			block "card_tier" {}
		}
		block "card_bar" {}
		text_single = {
			size = { 154 18 }
			autoresize = no
			align = center|nobaseline
			using = Font_Size_Small
			alwaystransparent = yes
			block "card_heading" {}
		}
		hbox = {
			spacing = 3
			block "card_drivers" {}
		}
		text_multi = {
			size = { 154 36 }
			autoresize = no
			align = center|nobaseline
			using = Font_Size_Small
			alwaystransparent = yes
			block "card_effect" {}
		}
		hbox = {
			size = { 154 20 }
			spacing = 4
			background = { using = Background_Area_Dark }
			using = tooltip_se
			block "perk_tooltip" {}
			icon = {
				size = { 18 18 }
				alwaystransparent = yes
				block "perk_icon" {}
			}
			text_single = {
				size = { 128 18 }
				autoresize = no
				align = left|nobaseline
				using = Font_Size_Small
				alwaystransparent = yes
				block "perk_text" {}
			}
		}
		expand = {}
	}

	### Monthly Income (2026-11-25, third request): one card per resource in
	### the pillar cards' form, 170 x 104: a colour strip, the icon and the
	### month's total (hover: vanilla's balance breakdown), then a short
	### ledger of label-and-value rows -- what the Quarter gives, how the
	### pillar band scales it, and (gold) what the host takes.
	### datacontext: the leader.
	# 2026-11-25 (fourth pass): every part at a fixed position. As a sized
	# vbox (and then a vbox inside a widget), the three-row gold card and
	# the two-row cards laid out to different heights, and their strips
	# and headers sat a few pixels apart (live, twice).
	type kehillah_income_card = widget {
		size = { 170 110 }
		background = { using = Background_Area }

		icon = {
			position = { 8 0 }
			size = { 154 3 }
			texture = "gfx/interface/colors/white.dds"
			alwaystransparent = yes
			block "inc_color" { color = { 0.5 0.5 0.5 1 } }
		}
		widget = {
			position = { 8 5 }
			size = { 154 34 }
			using = tooltip_se
			block "inc_tooltip" {}
			icon = {
				parentanchor = left|vcenter
				size = { 30 30 }
				alwaystransparent = yes
				block "inc_icon" {}
			}
			text_single = {
				parentanchor = left|vcenter
				position = { 36 0 }
				size = { 72 30 }
				autoresize = no
				align = left|nobaseline
				using = Font_Size_Big
				alwaystransparent = yes
				block "inc_total" {}
			}
			text_single = {
				parentanchor = right|vcenter
				size = { 46 18 }
				autoresize = no
				align = right|nobaseline
				using = Font_Size_Small
				default_format = "#weak"
				text = "KEHILLAH_INC_PER_MONTH"
				alwaystransparent = yes
			}
		}
		divider_light = {
			position = { 8 41 }
			size = { 154 2 }
		}
		# Pinned to three rows' height (3 x 18 + 2 x 2), rows at the top: an
		# unsized vbox here filled the card and spread the rows down past
		# it into the host strip (live).
		vbox = {
			position = { 8 47 }
			size = { 154 58 }
			minimumsize = { 154 58 }
			maximumsize = { 154 58 }
			spacing = 2
			block "inc_rows" {}
			expand = {}
		}
	}

	### One ledger row, 154 x 18: label at the left, value at the right.
	type kehillah_income_row = widget {
		size = { 154 18 }
		using = tooltip_se
		block "row_tooltip" {}
		text_single = {
			size = { 96 18 }
			autoresize = no
			align = left|nobaseline
			using = Font_Size_Small
			default_format = "#weak"
			alwaystransparent = yes
			block "row_label" {}
		}
		text_single = {
			parentanchor = right
			size = { 58 18 }
			autoresize = no
			align = right|nobaseline
			using = Font_Size_Small
			alwaystransparent = yes
			block "row_value" {}
		}
	}
}
