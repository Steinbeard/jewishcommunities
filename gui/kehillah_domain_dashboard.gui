# My Realm > Domain for a Kehillah leader, as a dashboard (2026-11-25,
# docs/implementation/2026-11-25-domain-dashboard.md): a hero card for the
# community's Standing with a danger chip, then the three pillars as cards
# side by side. Used in gui/window_my_realm.gui (vbox_my_realm_domain_body).
# Fixed widths throughout: the tab holds about 555 px and every box is 540;
# vanilla's expand in a fixed row pushed boxes off the tab before (live,
# 2026-10-29/30), so rows here are anchored, not expanded.
types KehillahDomainDashboard
{
	### A pillar's bar, 154 px: coloured by band like kehillah_pillar_bar,
	### with a pale tick where the pillar is heading (its baseline).
	type kehillah_dom_bar = widget {
		size = { 154 14 }
		alwaystransparent = yes

		background = {
			block "bar_frame" { texture = "gfx/interface/progressbars/kehillah_prosperity.dds" }
			spriteType = Corneredstretched
			spriteborder = { 2 2 }
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_red" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_red.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_orange" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_orange.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_standard" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_standard.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		progressbar_standard = {
			parentanchor = center
			size = { 150 10 }
			min = 0
			max = 1000
			block "bar_value" { value = 0 }
			block "bar_green" { visible = no }
			blockoverride "progress_textures" {
				progresstexture = "gfx/interface/progressbars/progress_green.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			alwaystransparent = yes
		}
		# The baseline tick: two stretch factors either side of a 2 px mark.
		hbox = {
			parentanchor = center
			size = { 150 14 }
			alwaystransparent = yes
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				block "tick_before" {}
			}
			icon = { size = { 2 14 } texture = "gfx/interface/colors/white.dds" color = { 0.98 0.93 0.78 1 } alwaystransparent = yes }
			widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
				block "tick_after" {}
			}
		}
	}

	### One pillar card, 170 px wide: a colour strip, the tier icon beside
	### the name and score, the tier and trend, the bar, where it is heading,
	### and what its band does. The pillar's breakdown is the card's tooltip.
	### datacontext: the community title.
	### Fixed 170 x 176 so the three cards line up (first pass, 2026-11-25
	### live: cards of different heights sat at different heights and the
	### tallest rode up into the hero). Content is centred and top-aligned
	### (the expand at the foot takes the slack).
	type kehillah_dom_pillar_card = vbox {
		minimumsize = { 170 176 }
		maximumsize = { 170 176 }
		margin = { 8 0 }
		margin_bottom = 8
		spacing = 4
		background = { using = Background_Area }
		using = tooltip_se
		block "card_tooltip" {}

		icon = {
			size = { 154 3 }
			texture = "gfx/interface/colors/white.dds"
			alwaystransparent = yes
			block "card_color" { color = { 0.5 0.5 0.5 1 } }
		}
		hbox = {
			spacing = 6
			icon = {
				size = { 42 42 }
				alwaystransparent = yes
				block "card_icon" {}
			}
			vbox = {
				text_single = {
					align = left|nobaseline
					max_width = 104
					using = Font_Size_Medium
					alwaystransparent = yes
					block "card_name" {}
				}
				text_single = {
					align = left|nobaseline
					max_width = 104
					using = Font_Size_Big
					alwaystransparent = yes
					block "card_score" {}
				}
			}
		}
		text_single = {
			size = { 154 20 }
			autoresize = no
			align = center|nobaseline
			alwaystransparent = yes
			block "card_tier" {}
		}
		block "card_bar" {}
		text_single = {
			size = { 154 18 }
			autoresize = no
			align = center|nobaseline
			using = Font_Size_Small
			alwaystransparent = yes
			block "card_heading" {}
		}
		text_multi = {
			size = { 154 36 }
			autoresize = no
			align = center|nobaseline
			using = Font_Size_Small
			alwaystransparent = yes
			block "card_effect" {}
		}
		expand = {}
	}
}
