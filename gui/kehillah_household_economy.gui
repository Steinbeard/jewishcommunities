types KehillahHouseholdEconomy {
	type kehillah_household_economy_body = vbox {
		spacing = 6
		layoutpolicy_horizontal = expanding
		text_multi = { size = { 546 44 } autoresize = no text = "kehillah_economy_intro" using = Font_Size_Small }
		text_single = { text = "kehillah_economy_summary" using = Font_Size_Medium }
		text_single = { text = "kehillah_economy_assessment_current" }
		hbox = { spacing = 8
			button_standard = {
				size = { 170 30 }
				text = "kehillah_economy_assess_light"
				enabled = "[GetScriptedGui('kehillah_economy_assess_light').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				tooltip = "kehillah_economy_assess_light_tt"
				onclick = "[GetScriptedGui('kehillah_economy_assess_light').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			}
			button_standard = {
				size = { 170 30 }
				text = "kehillah_economy_assess_ordinary"
				enabled = "[GetScriptedGui('kehillah_economy_assess_ordinary').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				tooltip = "kehillah_economy_assess_ordinary_tt"
				onclick = "[GetScriptedGui('kehillah_economy_assess_ordinary').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			}
			button_standard = {
				size = { 170 30 }
				text = "kehillah_economy_assess_heavy"
				enabled = "[GetScriptedGui('kehillah_economy_assess_heavy').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				tooltip = "kehillah_economy_assess_heavy_tt"
				onclick = "[GetScriptedGui('kehillah_economy_assess_heavy').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			}
		}
		text_multi = { size = { 546 34 } autoresize = no text = "kehillah_businesses_summary" using = Font_Size_Small tooltip = "kehillah_business_economy_tt" }
		scrollbox = {
			size = { 548 360 }
			blockoverride "scrollbox_content" {
				vbox = {
					spacing = 8
					layoutpolicy_horizontal = expanding
					datamodel = "[Title.MakeScope.GetList('kehillah_households')]"
					item = {
						vbox = {
							datacontext = "[Scope.Var('kehillah_household_head').Char]"
							size = { 520 180 }
							minimumsize = { 520 180 }
							spacing = 3
							background = { using = Background_Area_Dark }
							hbox = {
								spacing = 8
								portrait_head_small = { size = { 64 64 } datacontext = "[Character.Self]" }
								vbox = {
									size = { 440 100 }
									text_single = { text = "[Character.GetHouse.GetNameNoTooltip]" using = Font_Size_Medium }
									text_multi = { size = { 434 36 } autoresize = no text = "kehillah_economy_family_line" using = Font_Size_Small }
									text_multi = { size = { 434 36 } autoresize = no text = "kehillah_economy_money_line" using = Font_Size_Small tooltip = "kehillah_economy_breakdown_tt" }
								}
							}
							text_single = {
								visible = "[Not(GetScriptedGui('kehillah_economy_ruling_house').IsShown(GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'family', Character.GetHouse.MakeScope ).End))]"
								text = "kehillah_economy_outlook_line"
								using = Font_Size_Small
								tooltip = "kehillah_economy_breakdown_tt"
							}
							text_single = {
								visible = "[GetScriptedGui('kehillah_economy_ruling_house').IsShown(GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'family', Character.GetHouse.MakeScope ).End)]"
								text = "kehillah_economy_ruling"
								using = Font_Size_Small
							}
							button_standard = {
								size = { 210 28 }
								text = "kehillah_businesses_manage"
								onclick = "[GetVariableSystem.Set('kehillah_businesses_tab','yes')]"
							}

						}
					}
				}
			}
		}
	}
}
