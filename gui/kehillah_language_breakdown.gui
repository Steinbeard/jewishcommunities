# The chance a reading masters a book (2026-11-10, docs/spec/2026-11-10-
# sefer-languages.md): the script-value breakdown of the generated
# kehillah_lib_mastery_chance_<work>. The terms and their labels live in the
# value, so the tooltip cannot drift from the roll in
# kehillah_study_specific_work_effect.
# Use inside a tooltipwidget, with the work's flag name at hand:
#   kehillah_mastery_chance_breakdown_tooltip = {
#       datacontext = "[GuiScope.SetRoot( GetPlayer.MakeScope ).GetScriptValueBreakdown( Concatenate( 'kehillah_lib_mastery_chance_', <flag name> ) )]"
#   }
#
# 2026-11-10, second pass (Daniel: "the tooltips ... could be improved"): its
# own rows instead of vanilla's widget_value_breakdown_list. Vanilla's row cut
# names at 275 px and added a one-decimal value column ("+28.0") beside a label
# that already said "+28%". Each row is now the label and one signed percentage,
# and the title carries the total. The same approach as
# gui/kehillah_danger_breakdown.gui.
types KehillahMasteryChanceBreakdown
{
	type kehillah_mastery_chance_breakdown_tooltip = widget
	{
		size = { 50 50 }
		alwaystransparent = no
		using = DefaultTooltipBackground

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 20 10 }
			margin_bottom = 17
			spacing = 4

			# Optional lead-in: the Study button puts where you may study here.
			block "intro" {}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "KEHILLAH_LIB_CHANCE_BD_HEADER"
				default_format = "#T"
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				max_width = 400
				autoresize = yes
				text = "KEHILLAH_LIB_CHANCE_BD_NOTE"
				default_format = "#weak"
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 4
				spacing = 2
				datamodel = "[ValueBreakdown.GetSubValues]"
				item = {
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 12
						text_single = {
							text = "[ValueBreakdown.GetName]"
							max_width = 330
						}
						expand = {}
						text_single = {
							text = "KEHILLAH_LIB_CHANCE_BD_TERM"
							align = right
						}
					}
				}
			}
		}
	}
}
