##########################################################################
# Jewish Communities -- map view.
#
# Design doc: docs/spec/v12-community-map-view.md. Read that before
# changing anything here.
#
# WHAT THIS IS. Three top-level widgets, registered in gui/scripted_
# widgets/kehillah_scripted_widgets.txt -- CK3's one additive GUI hook,
# confirmed working live 2026-09-14 (this repo's first use of it):
#
#   kehillah_realm_jewish_policy_map_legend -- the policy map's legend
#   kehillah_community_map_view_panel  -- the roster window
#   kehillah_community_map_view_minimized -- its collapsed header
#
# The map-mode buttons and the "Showing:" names are NOT here (2026-10-29):
# they live in the mod's copy of gui/shared/mapmodes.gui, inside vanilla's
# Faith strip and banner. See docs/implementation/2026-10-29-map-mode-
# strip.md. The Jewish Communities button there does three things in one
# click: paints the map (a scripted_gui, common/scripted_guis/
# kehillah_map_view_gui.txt), switches to the kehillah_communities_map map
# mode (gfx/map/map_modes/kehillah_map_modes.txt), and opens the roster.
# The roster can be hidden or minimized without changing map mode. The
# button and roster are linked by the VariableSystem flags
# "kehillah_map_view_open" and "kehillah_map_view_minimized".
#
# The roster is grouped by minhag region -- three super-regions, each
# with sub-regions, plus an "elsewhere" bucket -- and the map mode
# colours each community's host county by Standing band. Data comes
# from character-scope variable lists mirrored onto the player by
# common/scripted_effects/kehillah_map_view_effects.txt (one list per
# sub-region; a .gui datamodel can neither sort nor group, so both are
# done script-side), because .gui cannot read a global variable list.
#
# EVERYTHING BELOW IS THE RESIDUE OF FIVE LIVE PASSES, each of which
# found one thing a clean read of the vanilla files had not. The spec's
# sections 6a-6e record them in order; the short list:
#   - alwaystransparent propagates to the whole subtree (6a)
#   - a top-level widget needs a layer or it sits under the HUD (6b)
#   - a (flow)container cannot have an hbox/vbox as a direct child, and
#     a bare button_close cannot sit in an hbox -- both crash on open (6c)
#   - text_single autoresizes to its text unless max_width caps it (6d)
#   - a movable window cannot live inside a layout container (6d)
# Each is cited at the line it governs. Do not "tidy" them away.
##########################################################################


# The policy map's legend (2026-10-28): what each colour means, above the
# Faith strip of map-mode buttons (at -85, 40 px tall) so it is clear of
# both them and the "Showing:" banner. Swatch colours are the
# d_kehillah_mapcolor_policy_* title colours (common/landed_titles/
# kehillah_map_color_titles.txt) / 255. Flowcontainers only: a
# (flow)container may not hold an hbox/vbox directly (live pass 3 crash,
# header of this file).
flowcontainer = {
	name = "kehillah_realm_jewish_policy_map_legend"
	parentanchor = bottom|hcenter
	widgetanchor = bottom|hcenter
	position = { 0 -132 }
	direction = horizontal
	spacing = 14
	margin = { 10 3 }
	layer = windows_layer
	alwaystransparent = yes
	ignoreinvisible = yes
	visible = "[And( IsInGame, IsMapMode( 'kehillah_realm_jewish_policy_map' ) )]"

	background = {
		using = Background_Area_Dark
		color = { 0.10 0.09 0.08 0.85 }
	}

	kehillah_policy_legend_item = {
		blockoverride "swatch" { color = { 0.27 0.50 0.80 1 } }
		blockoverride "label" { text = "kehillah_settlement_policy_legend_encouraged" }
	}
	kehillah_policy_legend_item = {
		blockoverride "swatch" { color = { 0.30 0.57 0.41 1 } }
		blockoverride "label" { text = "kehillah_settlement_policy_legend_allowed" }
	}
	kehillah_policy_legend_item = {
		blockoverride "swatch" { color = { 0.81 0.46 0.19 1 } }
		blockoverride "label" { text = "kehillah_settlement_policy_legend_discouraged" }
	}
	kehillah_policy_legend_item = {
		blockoverride "swatch" { color = { 0.60 0.18 0.18 1 } }
		blockoverride "label" { text = "kehillah_settlement_policy_legend_banned" }
	}
	kehillah_policy_legend_item = {
		blockoverride "swatch" { color = { 0.36 0.34 0.29 1 } }
		blockoverride "label" { text = "kehillah_settlement_policy_legend_none" }
	}
}

types KehillahPolicyMapLegend
{
	type kehillah_policy_legend_item = flowcontainer {
		direction = horizontal
		spacing = 4
		alwaystransparent = yes

		widget = {
			size = { 12 12 }
			alwaystransparent = yes
			background = {
				using = Background_Area_Solid
				block "swatch" { color = { 1 1 1 1 } }
			}
		}
		text_single = {
			alwaystransparent = yes
			default_format = "#high"
			using = Font_Size_Small
			block "label" { text = "" }
		}
	}
}


### =====================================================================
### THE ROSTER WINDOW
### =====================================================================

# Column widths, shared by the header row and every roster row so they
# line up. Rows are: portrait | name block | standing | P | S | G |
# locate. The name block takes whatever is left. Widened in live pass 5
# -- the numbers fit 48/42 but the column labels did not.
@col_portrait = 64
@col_name = 190
@col_standing = 74
@col_pillar = 58
@col_locate = 30
@col_quarter = 30
@roster_width = 630

window = {
	name = "kehillah_community_map_view_panel"
	parentanchor = bottom|right
	widgetanchor = bottom|right

	# Default resting place: bottom-right, clear of the Faith-family toggle
	# in the bottom centre and vanilla's zoom-level caption
	# ("Paper Map / Selecting: Realms"), which live pass 4 showed bleeding
	# through the panel's bottom edge at -196. Draggable from here.
	position = { -22 -240 }
	size = { 670 720 }

	# A movable window cannot live inside the flowcontainer that lays out
	# the toggle -- dragging would fight the layout -- which is why the
	# panel is its own top-level widget (window_message_settings.gui:
	# 755-762 is the vanilla shape).
	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( GetVariableSystem.Exists( 'kehillah_map_view_open' ), IsMapMode( 'kehillah_communities_map' ) ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	background = {
		using = Background_Area_Dark
		color = { 0.11 0.10 0.09 0.94 }
		margin = { 6 6 }
	}

	# The layout vbox lives INSIDE the window, never directly in a
	# (flow)container -- live pass 3 crashed the game with a stack
	# overflow on exactly that, and error.log said so in as many words
	# ("A (flow)container can't have an hbox/vbox as a direct child").
	vbox = {
		margin = { 14 12 }
		spacing = 6
		min_width = @roster_width

		### Header. Vanilla's own window header, used the way
		### gui/window_situation_list.gui:40-52 uses it -- it carries
		### the close button internally, positioned absolutely inside a
		### plain widget. A bare button_close dropped into an hbox is
		### rejected ("Widget cannot have a position in a layout", live
		### pass 3). Both window controls leave the map mode selected.
		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_MAP_VIEW_HEADER"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_open' )]"
				onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_minimized' )]"
			}

			blockoverride "button_minimize"
			{
				visible = yes
				onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_open' )]"
				onclick = "[GetVariableSystem.Set( 'kehillah_map_view_minimized', 'yes' )]"
			}
		}

		text_multi = {
			autoresize = yes
			max_width = @roster_width
			text = "KEHILLAH_MAP_VIEW_SUBHEADER"
			default_format = "#weak;italic"
		}

		### Column labels, so the four bare numbers on each row are
		### readable without hovering every one of them. Same widths as
		### the rows, from the constants above.
		hbox = {
			layoutpolicy_horizontal = expanding
			margin_right = 18
			margin_top = 4

			text_single = {
				text = "KEHILLAH_MAP_VIEW_COL_COMMUNITY"
				default_format = "#weak"
				margin_left = @col_portrait
			}

			expand = {}

			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_STANDING"
				default_format = "#weak"
				min_width = @col_standing
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_P"
				default_format = "#weak"
				min_width = @col_pillar
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_S"
				default_format = "#weak"
				min_width = @col_pillar
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_G"
				default_format = "#weak"
				min_width = @col_pillar
			}

			# Spacer matching the two action buttons' columns.
			widget = { size = { @col_locate 1 } }
			widget = { size = { @col_quarter 1 } }
		}

		### The roster. The outliner's own scrollarea shape, property for
		### property (gui/hud_outliner.gui:80-97): sizes itself to its
		### content up to a ceiling and needs nothing from its parent's
		### height. A "growing" layoutpolicy here, inside a vbox with no
		### fixed height, was the other layout cycle live pass 3 removed.
		scrollarea = {
			autoresizescrollarea = yes
			scrollbarpolicy_horizontal = always_off
			size = { @roster_width 0 }
			maximumsize = { -1 560 }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					set_parent_size_to_minimum = yes
					min_width = @roster_width
					margin_right = 12
					spacing = 2

					### The region hierarchy (v12 section 7). Static, since
					### the region table is static: three super-regions,
					### each holding its sub-regions, plus "elsewhere" for
					### a community outside every region. Every level
					### hides itself when empty. Each sub-region's rows come
					### from its own mirrored list, already standing-
					### ordered by kehillah_refresh_map_view_effect.
					kehillah_map_view_superregion = {
						blockoverride "super_visible" { visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count_ashkenaz' ).GetValue, '(CFixedPoint)0' )]" }
						blockoverride "super_name" { text = "KEHILLAH_SUPERREGION_ASHKENAZ" }
						blockoverride "super_color" { color = { 0.322 0.431 0.678 1 } }
						blockoverride "super_regions" {
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_anglia' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_ANGLIA" }
								blockoverride "region_color" { color = { 0.267 0.443 0.671 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_anglia' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_western_ashkenaz' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_WESTERN_ASHKENAZ" }
								blockoverride "region_color" { color = { 0.322 0.431 0.678 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_western_ashkenaz' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_eastern_ashkenaz' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_EASTERN_ASHKENAZ" }
								blockoverride "region_color" { color = { 0.518 0.380 0.655 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_eastern_ashkenaz' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_provence' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_PROVENCE" }
								blockoverride "region_color" { color = { 0.267 0.565 0.627 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_provence' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_italki' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_ITALKI" }
								blockoverride "region_color" { color = { 0.596 0.357 0.584 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_italki' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_romaniote' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_ROMANIOTE" }
								blockoverride "region_color" { color = { 0.408 0.494 0.725 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_romaniote' )]" }
							}
						}
					}

					kehillah_map_view_superregion = {
						blockoverride "super_visible" { visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count_sepharad' ).GetValue, '(CFixedPoint)0' )]" }
						blockoverride "super_name" { text = "KEHILLAH_SUPERREGION_SEPHARAD" }
						blockoverride "super_color" { color = { 0.741 0.510 0.255 1 } }
						blockoverride "super_regions" {
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_northern_sepharad' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_NORTHERN_SEPHARAD" }
								blockoverride "region_color" { color = { 0.741 0.510 0.255 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_northern_sepharad' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_southern_sepharad' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_SOUTHERN_SEPHARAD" }
								blockoverride "region_color" { color = { 0.827 0.620 0.259 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_southern_sepharad' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_maghreb' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_MAGHREB" }
								blockoverride "region_color" { color = { 0.647 0.392 0.298 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_maghreb' )]" }
							}
						}
					}

					kehillah_map_view_superregion = {
						blockoverride "super_visible" { visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count_mizrach' ).GetValue, '(CFixedPoint)0' )]" }
						blockoverride "super_name" { text = "KEHILLAH_SUPERREGION_MIZRACH" }
						blockoverride "super_color" { color = { 0.325 0.588 0.388 1 } }
						blockoverride "super_regions" {
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_eretz_yisrael' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_ERETZ_YISRAEL" }
								blockoverride "region_color" { color = { 0.325 0.588 0.388 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_eretz_yisrael' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_misraim' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_MISRAIM" }
								blockoverride "region_color" { color = { 0.573 0.604 0.282 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_misraim' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_bavel' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_BAVEL" }
								blockoverride "region_color" { color = { 0.267 0.565 0.514 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_bavel' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_paras' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_PARAS" }
								blockoverride "region_color" { color = { 0.451 0.624 0.416 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_paras' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_radhanite' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_RADHANITE" }
								blockoverride "region_color" { color = { 0.286 0.510 0.600 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_radhanite' )]" }
							}
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_caucasus' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_CAUCASUS" }
								blockoverride "region_color" { color = { 0.443 0.541 0.651 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_caucasus' )]" }
							}
						}
					}

					kehillah_map_view_superregion = {
						blockoverride "super_visible" { visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count_elsewhere' ).GetValue, '(CFixedPoint)0' )]" }
						blockoverride "super_name" { text = "KEHILLAH_SUPERREGION_ELSEWHERE" }
						blockoverride "super_color" { color = { 0.361 0.337 0.290 1 } }
						blockoverride "super_regions" {
							kehillah_map_view_region = {
								blockoverride "region_visible" { visible = "[DataModelHasItems( GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_unplaced' ) )]" }
								blockoverride "region_name" { text = "KEHILLAH_REGION_UNPLACED" }
								blockoverride "region_color" { color = { 0.361 0.337 0.290 1 } }
								blockoverride "region_list" { datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_unplaced' )]" }
							}
						}
					}
				}
			}
		}
	}
}



# The minimized ledger keeps a small, actionable header on the map. It is a
# separate top-level window because shrinking the roster window in place
# would leave its layout and mouse area covering the map.
window = {
	name = "kehillah_community_map_view_minimized"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	position = { -22 -240 }
	size = { 360 56 }
	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( GetVariableSystem.Exists( 'kehillah_map_view_minimized' ), IsMapMode( 'kehillah_communities_map' ) ) )]"
	visible_at_creation = no

	header_pattern = {
		blockoverride "size" { size = { 360 56 } }
		blockoverride "header_text" { text = "KEHILLAH_MAP_VIEW_MINIMIZED_HEADER" }

		blockoverride "button_minimize"
		{
			visible = yes
			mirror = vertical
			tooltip = "KEHILLAH_MAP_VIEW_RESTORE_TOOLTIP"
			onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_minimized' )]"
			onclick = "[GetVariableSystem.Set( 'kehillah_map_view_open', 'yes' )]"
		}

		blockoverride "button_close"
		{
			onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_minimized' )]"
			onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_open' )]"
		}
	}
}


types KehillahMapView
{
	### A super-region: a bold header and, inserted by blockoverride, its
	### sub-region blocks. Hidden when its mirrored count is 0.
	type kehillah_map_view_superregion = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 2

		block "super_visible" {
			visible = no
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			margin_top = 8
			margin_left = 4
			spacing = 6

			widget = {
				size = { 13 13 }
				background = {
					using = Background_Area_Solid
					block "super_color" { color = { 0.36 0.34 0.29 1 } }
				}
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				default_format = "#high;bold"
				block "super_name" { text = "KEHILLAH_SUPERREGION_ELSEWHERE" }
			}
		}

		block "super_regions" {}
	}

	### A sub-region: an italic label and its rows. Hidden when its list
	### is empty, so an unpopulated region costs no space.
	type kehillah_map_view_region = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 3

		block "region_visible" {
			visible = no
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			margin_top = 4
			margin_left = 10
			spacing = 5

			widget = {
				size = { 10 10 }
				background = {
					using = Background_Area_Solid
					block "region_color" { color = { 0.36 0.34 0.29 1 } }
				}
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				default_format = "#weak;italic"
				block "region_name" { text = "KEHILLAH_REGION_UNPLACED" }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3

			block "region_list" {
				datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list_unplaced' )]"
			}

			item = {
				kehillah_map_view_row = {}
			}
		}
	}

	### One community.
	#
	# datacontext comes from the region's datamodel: Scope.Title is the
	# d_kehillah_* community title. Every number on the row is read off
	# that title's own variables, which is where this mod keeps pillar
	# state (see kehillah_quarterly_pillars_effect's "WHY THE TITLE, NOT
	# THE CHARACTER" note).
	type kehillah_map_view_row = hbox {
		datacontext = "[Scope.Title]"
		layoutpolicy_horizontal = expanding
		min_height = 56
		spacing = 6

		tooltip = "KEHILLAH_MAP_VIEW_ROW_TOOLTIP"
		using = tooltip_ws

		background = {
			using = Background_Area_Dark
			color = { 0.18 0.17 0.15 0.55 }
			margin = { 4 2 }
		}

		# The player's own community, marked so the roster reads as
		# "where do I stand" and not just "who exists".
		background = {
			visible = "[Title.GetHolder.IsLocalPlayer]"
			using = Background_Area_Dark
			color = { 0.45 0.38 0.15 0.35 }
			margin = { 4 2 }
		}

		### The leader. portrait_head_tiny's own portrait_button carries
		### vanilla's character-click behaviour, so this doubles as the
		### route to their character panel -- and from there, via their
		### realm flag, to their actual domicile window (the chain
		### docs/spec/spike-domicile-map-visibility.md section 3
		### confirmed live on 2026-09-10).
		widget = {
			size = { @col_portrait 56 }
			parentanchor = vcenter
			visible = "[Title.HasHolder]"
			datacontext = "[Title.GetHolder]"

			portrait_head_tiny = {
				parentanchor = center
			}
		}

		### Name, and where in the world it is.
		#
		# max_width on both lines is load-bearing (live pass 4): the
		# text_single template is autoresize = yes / elide = right
		# (gui/preload/labels.gui:6-15), so without a cap each line sizes
		# to its own text, the longest county name in the roster sets the
		# row width, and the whole panel ran off the right edge of the
		# screen. With the cap the line elides instead; the full text is
		# in the row tooltip anyway.
		vbox = {
			layoutpolicy_horizontal = expanding
			parentanchor = vcenter
			spacing = 1

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				max_width = @col_name
				text = "[Title.GetNameNoTooltip]"
				default_format = "#high"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				max_width = @col_name
				text = "KEHILLAH_MAP_VIEW_ROW_LOCATION"
				default_format = "#weak"
			}
		}

		### Standing -- the community's overall figure, and what the
		### roster is ordered on within each region. Emphasised over the
		### three it is made of: this is the column you scan, they are
		### the breakdown. It is the MEAN of the three, not their sum,
		### which is why it sits on the same scale as its neighbours and
		### why the band name in the row tooltip can reuse the pillars'
		### own thresholds -- see kehillah_standing_value.
		#
		# COLOURED BY BAND (live pass 6, user request). The text is a
		# customizable-loc call, Kehillah<Pillar>Score (common/
		# customizable_localization/kehillah_pillar_band_custom_loc.txt),
		# which returns the value already wrapped in vanilla's aptitude
		# colour ramp -- red for Crisis through green for Legendary. The
		# thresholds stay script-side; the GUI never sees a number.
		# The hbox owns label placement. Vertical expansion keeps the
		# inherited centered text aligned without parentanchor, which
		# logged "Widget cannot have a position in a layout" per row.
		text_label_center = {
			layoutpolicy_vertical = expanding
			min_width = @col_standing
			text = "[Title.Custom( 'KehillahStandingScore' )]"
			tooltip = "KEHILLAH_BD_STANDING_TOOLTIP"
			using = tooltip_ws
		}

		### The three pillars, in the fixed Prosperity / Stability /
		### Greatness order this mod uses everywhere else.
		text_label_center = {
			layoutpolicy_vertical = expanding
			min_width = @col_pillar
			text = "[Title.Custom( 'KehillahProsperityScore' )]"
			tooltip = "KEHILLAH_BD_PROSPERITY_TOOLTIP"
			using = tooltip_ws
		}
		text_label_center = {
			layoutpolicy_vertical = expanding
			min_width = @col_pillar
			text = "[Title.Custom( 'KehillahStabilityScore' )]"
			tooltip = "KEHILLAH_BD_STABILITY_TOOLTIP"
			using = tooltip_ws
		}
		text_label_center = {
			layoutpolicy_vertical = expanding
			min_width = @col_pillar
			text = "[Title.Custom( 'KehillahGreatnessScore' )]"
			tooltip = "KEHILLAH_BD_GREATNESS_TOOLTIP"
			using = tooltip_ws
		}

		### The map half of the map view: put this community on screen.
		#
		# ZoomCameraTo, not SelectTitle (live pass 6). SelectTitle on the
		# host county SELECTS it, and selecting a county opens its
		# holder -- the user landed on the local count instead of the
		# community. ZoomCameraTo is camera-only: vanilla's own "go to"
		# buttons use it (gui/hud.gui:2489 and five more, on characters;
		# gui/window_epidemics.gui:436 on a province). Title.GetProvince
		# is the county's capital province. The county itself is cached
		# onto the title by kehillah_cache_map_view_facts_effect, because
		# .gui cannot walk holder -> domicile -> location -> county.
		button_round = {
			parentanchor = vcenter
			size = { @col_locate @col_locate }

			enabled = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.IsValid]"
			onclick = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.GetProvince.ZoomCameraTo]"
			tooltip = "KEHILLAH_MAP_VIEW_LOCATE_TOOLTIP"
			using = tooltip_ws

			icon = {
				parentanchor = center
				size = { 18 18 }
				texture = "gfx/interface/icons/flat_icons/go_to_my_location.dds"
				alwaystransparent = yes
			}
		}

		### The community's own quarter (live pass 6, user request).
		#
		# ToggleGameViewData( 'domicile', <Domicile> ) opens the full
		# domicile window for ANY domicile, not just the player's --
		# docs/spec/spike-domicile-map-visibility.md section 3 found the
		# generic form (Domicile.Self, four vanilla call sites) and the
		# user confirmed it live on 2026-09-10 via the title-view route.
		# This is that same window, one click instead of three.
		button_round = {
			parentanchor = vcenter
			size = { @col_quarter @col_quarter }
			margin_right = 4

			enabled = "[Title.HasDomicile]"
			onclick = "[GetVariableSystem.Clear( 'kehillah_lib_selected_work' )]"
			onclick = "[ToggleGameViewData( 'domicile', Title.GetHolder.GetDomicile )]"
			tooltip = "KEHILLAH_MAP_VIEW_QUARTER_TOOLTIP"
			using = tooltip_ws

			icon = {
				parentanchor = center
				size = { 18 18 }
				texture = "gfx/interface/icons/flat_icons/estate.dds"
				alwaystransparent = yes
			}
		}

	}
}
