##########################################################################
# Jewish Communities -- map view.
#
# Design doc: docs/spec/v12-community-map-view.md. Read that before
# changing anything here, especially its section 1: this is NOT a real
# CK3 map mode, and it is not one for a researched engine reason, not
# for want of trying.
#
# THE SHORT VERSION. A CK3 map mode is a block in gfx/map/map_modes/
# map_modes.txt whose colouring comes from "color_mode = <name>", where
# <name> must be one of ~60 hardcoded engine colouring algorithms. No
# script-drivable one exists -- there is no "colour counties by a
# variable/modifier" hook, and a Kehillah owns no county to colour in
# the first place (it is layered over a host county it does not hold).
# Adding a button to vanilla's own map-mode bar would additionally mean
# forking gui/shared/mapmodes.gui, whose bar is a hand-written list of
# buttons, not a datamodel over the map modes that exist.
#
# So this delivers the USE of a map mode -- see every Jewish community
# in the world, compare them, and put any of them on screen -- through
# the one additive surface that exists (gui/scripted_widgets/, see
# gui/scripted_widgets/kehillah_scripted_widgets.txt), forking nothing.
# The map half is real: each row's locate button calls Title.SelectTitle
# on the community's live host county, which moves the camera there and
# selects it, exactly as vanilla's own holy-site icons do
# (gui/map_icon_layer.gui:751).
#
# DATA. The roster is a character-scope variable list mirrored onto each
# player by common/scripted_effects/kehillah_map_view_effects.txt --
# .gui cannot read a global variable list, which is why the mirror
# exists. That file's header has the full account.
#
# ---------------------------------------------------------------------
# TWO TOP-LEVEL WIDGETS, both registered in gui/scripted_widgets/
# kehillah_scripted_widgets.txt:
#
#   kehillah_community_map_view        -- the toggle button
#   kehillah_community_map_view_panel  -- the roster window
#
# They were one widget until live pass 4 (2026-09-14) asked for the
# panel to be draggable. A draggable panel is a "window" with
# "movable = yes" (vanilla: gui/window_message_settings.gui:755-762),
# and a movable window cannot sit inside the flowcontainer that lays
# out the toggle -- dragging would fight the layout every frame. So the
# panel is its own free-floating window and the toggle keeps the
# content-sized container. The two are linked only by the VariableSystem
# flag "kehillah_map_view_open", which the toggle flips and the panel
# reads.
#
# EVERYTHING BELOW IS THE RESIDUE OF FOUR LIVE PASSES, each of which
# found one thing that a clean read of the vanilla files had not.
# The spec's sections 6a-6d record them in order; the short list:
#   - alwaystransparent propagates to the whole subtree (6a)
#   - a top-level widget needs a layer or it sits under the HUD (6b)
#   - a (flow)container cannot have an hbox/vbox as a direct child, and
#     a bare button_close cannot sit in an hbox -- both crash on open (6c)
#   - text_single autoresizes to its text unless max_width caps it (6d)
# Each is cited at the line it governs. Do not "tidy" them away.
##########################################################################


### =====================================================================
### THE TOGGLE
### =====================================================================

flowcontainer = {
	name = "kehillah_community_map_view"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	position = { -22 -150 }

	# LAYER (live pass 2). Every top-level HUD widget in vanilla declares
	# one; without it this sat beneath the HUD's full-screen bottom-layer
	# roots (hud.gui "meta_info"/"bottom_bar") and rendered without ever
	# receiving a click. The nearest vanilla analog -- persistent,
	# right-anchored, content-sized, interactive -- is the outliner
	# (gui/hud_outliner.gui:1-7), whose root is exactly these three
	# lines. alwaystransparent stays explicitly "no" (live pass 1): it
	# propagates to the whole subtree, which is why vanilla's map_modes
	# instantiation overrides its own type's "yes" (gui/hud.gui:2793).
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all

	direction = vertical
	ignoreinvisible = yes
	allow_outside = yes

	flowcontainer = {
		name = "kehillah_map_view_toggle"
		direction = vertical
		ignoreinvisible = yes

		# Hidden entirely when there is nothing to show: no communities
		# mirrored (a non-Kehillah game, or before the game-start refresh
		# has run) means no button. The CFixedPoint comparison against a
		# possibly-absent variable is vanilla's own idiom for exactly
		# this -- gui/shared/mapmodes.gui:105 reads hide_ui_map_zoom the
		# same way, and a variable that does not exist reads as 0.
		#
		# The IsInGame/GetPlayer.IsValid half is not belt-and-braces: a
		# scripted widget is created at STARTUP, which includes contexts
		# with no player (the frontend, the loading screen). Reading
		# GetPlayer.MakeScope there would log an error every frame. PDX
		# gui And() is a function call, not a short-circuiting operator,
		# so the guard has to wrap the read rather than merely precede
		# it -- vanilla guards its own always-created debug widgets the
		# same way (gui/debug/debug_menus.gui:784).
		visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( IsDefaultGUIMode, GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count' ).GetValue, '(CFixedPoint)0' ) ) )]"

		background = {
			using = Background_Area_Dark
			color = { 0.15 0.15 0.15 0.75 }
			margin = { 8 6 }
		}

		# Lit while the roster is open -- driven by the same flag the
		# panel reads, so the two can never disagree.
		background = {
			visible = "[GetVariableSystem.Exists( 'kehillah_map_view_open' )]"
			using = Background_Area_Dark
			color = { 0.55 0.45 0.18 0.85 }
			margin = { 8 6 }
		}

		button_round = {
			name = "kehillah_map_view_button"
			size = { 34 34 }
			parentanchor = hcenter
			onclick = "[GetVariableSystem.Toggle( 'kehillah_map_view_open' )]"
			tooltip = "KEHILLAH_MAP_VIEW_BUTTON_TOOLTIP"
			using = tooltip_ws

			# alwaystransparent on a LEAF is its correct use: let the
			# click fall through to the button beneath.
			icon = {
				parentanchor = center
				size = { 22 22 }
				texture = "gfx/interface/icons/faith/judaism.dds"
				alwaystransparent = yes
			}
		}
	}
}


### =====================================================================
### THE ROSTER WINDOW
### =====================================================================

# Column widths, shared by the header row and every roster row so they
# line up. Rows are: portrait | name block | standing | P | S | G |
# locate. The name block takes whatever is left.
@col_portrait = 64
@col_standing = 48
@col_pillar = 42
@col_locate = 30

window = {
	name = "kehillah_community_map_view_panel"
	parentanchor = bottom|right
	widgetanchor = bottom|right

	# Default resting place: bottom-right, clear of both the toggle (which
	# sits at -150 and is 46 tall) and vanilla's zoom-level caption
	# ("Paper Map / Selecting: Realms"), which live pass 4 showed bleeding
	# through the panel's bottom edge at -196. Draggable from here.
	position = { -22 -240 }
	size = { 520 640 }

	movable = yes
	resizable = no
	layer = windows_layer
	alwaystransparent = no
	filter_mouse = all
	allow_outside = yes

	visible = "[And( And( IsInGame, GetPlayer.IsValid ), GetVariableSystem.Exists( 'kehillah_map_view_open' ) )]"
	visible_at_creation = no

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	background = {
		using = Background_Area_Dark
		color = { 0.11 0.10 0.09 0.94 }
		margin = { 6 6 }
	}

	# The layout vbox lives INSIDE the window, never directly in a
	# (flow)container -- live pass 3 crashed the game with a stack
	# overflow on exactly that, and error.log said so in as many words
	# ("A (flow)container can't have an hbox/vbox as a direct child").
	vbox = {
		margin = { 14 12 }
		spacing = 6
		min_width = 490

		### Header. Vanilla's own window header, used the way
		### gui/window_situation_list.gui:40-52 uses it -- it carries
		### the close button internally, positioned absolutely inside a
		### plain widget. A bare button_close dropped into an hbox is
		### rejected ("Widget cannot have a position in a layout", live
		### pass 3).
		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "KEHILLAH_MAP_VIEW_HEADER"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_open' )]"
			}
		}

		text_multi = {
			autoresize = yes
			max_width = 480
			text = "KEHILLAH_MAP_VIEW_SUBHEADER"
			default_format = "#weak;italic"
		}

		### Column labels, so the four bare numbers on each row are
		### readable without hovering every one of them. Same widths as
		### the rows, from the constants above.
		hbox = {
			layoutpolicy_horizontal = expanding
			margin_right = 18
			margin_top = 4

			text_single = {
				text = "KEHILLAH_MAP_VIEW_COL_COMMUNITY"
				default_format = "#weak"
				margin_left = @col_portrait
			}

			expand = {}

			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_STANDING"
				default_format = "#weak"
				min_width = @col_standing
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_P"
				default_format = "#weak"
				min_width = @col_pillar
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_S"
				default_format = "#weak"
				min_width = @col_pillar
			}
			text_label_center = {
				text = "KEHILLAH_MAP_VIEW_COL_G"
				default_format = "#weak"
				min_width = @col_pillar
			}

			# Spacer matching the locate button's column.
			widget = { size = { @col_locate 1 } }
		}

		### The roster. The outliner's own scrollarea shape, property for
		### property (gui/hud_outliner.gui:80-97): sizes itself to its
		### content up to a ceiling and needs nothing from its parent's
		### height. A "growing" layoutpolicy here, inside a vbox with no
		### fixed height, was the other layout cycle live pass 3 removed.
		scrollarea = {
			autoresizescrollarea = yes
			scrollbarpolicy_horizontal = always_off
			size = { 490 0 }
			maximumsize = { -1 480 }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					set_parent_size_to_minimum = yes
					min_width = 490
					margin_right = 12
					spacing = 3

					# The mirrored roster, already ordered
					# strongest-standing-first by
					# kehillah_refresh_map_view_effect -- a .gui datamodel
					# cannot sort, so the ordering is done script-side
					# with ordered_in_global_list.
					datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list' )]"

					item = {
						kehillah_map_view_row = {}
					}
				}
			}
		}
	}
}


types KehillahMapView
{
	### One community.
	#
	# datacontext comes from the roster datamodel above: Scope.Title is
	# the c_kehillah_* community title. Every number on the row is read
	# off that title's own variables, which is where this mod keeps
	# pillar state (see kehillah_quarterly_pillars_effect's "WHY THE
	# TITLE, NOT THE CHARACTER" note).
	type kehillah_map_view_row = hbox {
		datacontext = "[Scope.Title]"
		layoutpolicy_horizontal = expanding
		min_height = 56
		spacing = 6

		tooltip = "KEHILLAH_MAP_VIEW_ROW_TOOLTIP"
		using = tooltip_ws

		background = {
			using = Background_Area_Dark
			color = { 0.18 0.17 0.15 0.55 }
			margin = { 4 2 }
		}

		# The player's own community, marked so the roster reads as
		# "where do I stand" and not just "who exists".
		background = {
			visible = "[Title.GetHolder.IsLocalPlayer]"
			using = Background_Area_Dark
			color = { 0.45 0.38 0.15 0.35 }
			margin = { 4 2 }
		}

		### The leader. portrait_head_tiny's own portrait_button carries
		### vanilla's character-click behaviour, so this doubles as the
		### route to their character panel -- and from there, via their
		### realm flag, to their actual domicile window (the chain
		### docs/spec/spike-domicile-map-visibility.md section 3
		### confirmed live on 2026-09-10).
		widget = {
			size = { @col_portrait 56 }
			parentanchor = vcenter
			visible = "[Title.HasHolder]"
			datacontext = "[Title.GetHolder]"

			portrait_head_tiny = {
				parentanchor = center
			}
		}

		### Name, and where in the world it is.
		#
		# max_width on both lines is load-bearing (live pass 4): the
		# text_single template is autoresize = yes / elide = right
		# (gui/preload/labels.gui:6-15), so without a cap each line sizes
		# to its own text, the longest county name in the roster sets the
		# row width, and the whole panel ran off the right edge of the
		# screen. With the cap the line elides instead; the full text is
		# in the row tooltip anyway.
		vbox = {
			layoutpolicy_horizontal = expanding
			parentanchor = vcenter
			spacing = 1

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				max_width = 200
				text = "[Title.GetNameNoTooltip]"
				default_format = "#high"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				max_width = 200
				text = "KEHILLAH_MAP_VIEW_ROW_LOCATION"
				default_format = "#weak"
			}
		}

		### Standing -- the community's overall figure, and what the
		### roster is ordered on. Emphasised over the three it is made
		### of: this is the column you scan, they are the breakdown. It
		### is the MEAN of the three, not their sum, which is why it sits
		### on the same scale as its neighbours and why the band name in
		### the row tooltip can reuse the pillars' own thresholds -- see
		### kehillah_standing_value.
		text_label_center = {
			parentanchor = vcenter
			min_width = @col_standing
			text = "[Title.MakeScope.Var( 'kehillah_var_standing' ).GetValue|V0]"
			default_format = "#high;bold"
		}

		### The three pillars, in the fixed Prosperity / Stability /
		### Greatness order this mod uses everywhere else.
		text_label_center = {
			parentanchor = vcenter
			min_width = @col_pillar
			text = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue|V0]"
		}
		text_label_center = {
			parentanchor = vcenter
			min_width = @col_pillar
			text = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue|V0]"
		}
		text_label_center = {
			parentanchor = vcenter
			min_width = @col_pillar
			text = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue|V0]"
		}

		### The map half of the map view: put this community on screen.
		#
		# SelectTitle is the engine's own "move the camera to this title
		# and select it" call -- vanilla uses it identically for holy
		# sites at gui/map_icon_layer.gui:751. The county it targets is
		# cached onto the title by kehillah_cache_map_view_facts_effect,
		# because .gui cannot walk holder -> domicile -> location ->
		# county for itself.
		button_round = {
			parentanchor = vcenter
			size = { @col_locate @col_locate }
			margin_right = 4

			enabled = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.IsValid]"
			onclick = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.SelectTitle]"
			tooltip = "KEHILLAH_MAP_VIEW_LOCATE_TOOLTIP"
			using = tooltip_ws

			icon = {
				parentanchor = center
				size = { 18 18 }
				texture = "gfx/interface/icons/flat_icons/go_to_my_location.dds"
				alwaystransparent = yes
			}
		}
	}
}
