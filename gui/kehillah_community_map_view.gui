##########################################################################
# Jewish Communities -- map view.
#
# Design doc: docs/spec/v12-community-map-view.md. Read that before
# changing anything here, especially its section 1: this is NOT a real
# CK3 map mode, and it is not one for a researched engine reason, not
# for want of trying.
#
# THE SHORT VERSION. A CK3 map mode is a block in gfx/map/map_modes/
# map_modes.txt whose colouring comes from "color_mode = <name>", where
# <name> must be one of ~60 hardcoded engine colouring algorithms. No
# script-drivable one exists -- there is no "colour counties by a
# variable/modifier" hook, and a Kehillah owns no county to colour in
# the first place (it is layered over a host county it does not hold).
# Adding a button to vanilla's own map-mode bar would additionally mean
# forking gui/shared/mapmodes.gui, whose bar is a hand-written list of
# buttons, not a datamodel over the map modes that exist.
#
# So this delivers the USE of a map mode -- see every Jewish community
# in the world, compare them, and put any of them on screen -- through
# the one additive surface that exists (gui/scripted_widgets/, see
# gui/scripted_widgets/kehillah_scripted_widgets.txt), forking nothing.
# The map half is real: each row's locate button calls Title.SelectTitle
# on the community's live host county, which moves the camera there and
# selects it, exactly as vanilla's own holy-site icons do
# (gui/map_icon_layer.gui:751).
#
# DATA. The roster is a character-scope variable list mirrored onto each
# player by common/scripted_effects/kehillah_map_view_effects.txt --
# .gui cannot read a global variable list, which is why the mirror
# exists. That file's header has the full account.
#
# ---------------------------------------------------------------------
# SHAPE OF THIS WIDGET, AND THE BUG THAT DICTATED IT (2026-09-14, found
# in the first live pass: the button rendered but would not click).
#
# The first build made the root a full-screen widget with
# "alwaystransparent = yes" so it would not swallow clicks meant for the
# map, and relied on the two children opting back in with filter_mouse.
# That does not work: **alwaystransparent propagates to the whole
# subtree**, so nothing inside it can ever be hit-tested.
#
# Vanilla says so itself, and this is the citation to keep: the
# map_modes TYPE sets "alwaystransparent = yes"
# (gui/shared/mapmodes.gui:88-90), and the ONE place it is instantiated
# overrides it back to "alwaystransparent = no" (gui/hud.gui:2793) --
# vanilla's own map-mode buttons would be unclickable otherwise. A child
# cannot re-enable what an ancestor turned off.
#
# THE FIX IS STRUCTURAL, not a flag: there is no full-screen surface any
# more. The root is a content-sized flowcontainer pinned to the
# bottom-right, so it only ever covers the pixels it actually draws and
# therefore never needs to be transparent to the mouse in the first
# place. ignoreinvisible collapses it to just the toggle button when the
# panel is closed.
#
# alwaystransparent survives ONLY on the decorative icons inside the two
# buttons, which is the correct vanilla use of it: a leaf that must let
# the click fall through to the button beneath it.
#
# POSITIONING. A scripted widget is free-floating -- there is no parent
# pane to anchor inside, so the offset below is hand-placed to sit above
# vanilla's map-mode bar. It is the one number most likely to need a
# nudge at a different resolution, which is why it now lives on the root
# rather than being repeated on two independently placed children.
##########################################################################

flowcontainer = {
	name = "kehillah_community_map_view"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	position = { -22 -150 }

	direction = vertical
	spacing = 6
	ignoreinvisible = yes
	allow_outside = yes
	filter_mouse = all


	### The roster panel. Sits directly above the toggle and shares its
	### right edge, because both are laid out by the same container
	### rather than being positioned independently.
	vbox = {
		name = "kehillah_map_view_panel"
		size = { 430 560 }

		# The IsInGame/GetPlayer.IsValid half is not belt-and-braces: a
		# scripted widget is created at STARTUP, which includes contexts
		# with no player (the frontend, the loading screen). Reading
		# GetPlayer.MakeScope there would log an error every frame. PDX
		# gui And() is a function call, not a short-circuiting operator,
		# so the guard has to wrap the read rather than merely precede
		# it -- vanilla guards its own always-created debug widgets the
		# same way (gui/debug/debug_menus.gui:784).
		visible = "[And( And( IsInGame, GetPlayer.IsValid ), GetVariableSystem.Exists( 'kehillah_map_view_open' ) )]"
		visible_at_creation = no

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		background = {
			using = Background_Area_Dark
			color = { 0.11 0.10 0.09 0.94 }
			margin = { 6 6 }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 14 12 }
			spacing = 6

			### Header
			hbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					text = "KEHILLAH_MAP_VIEW_HEADER"
					default_format = "#high;bold"
					parentanchor = vcenter
				}

				expand = {}

				button_close = {
					parentanchor = vcenter
					onclick = "[GetVariableSystem.Clear( 'kehillah_map_view_open' )]"
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 390
				text = "KEHILLAH_MAP_VIEW_SUBHEADER"
				default_format = "#weak;italic"
			}

			### Column labels, so the four bare numbers on each row are
			### readable without hovering every one of them.
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_right = 18
				margin_top = 4

				text_single = {
					text = "KEHILLAH_MAP_VIEW_COL_COMMUNITY"
					default_format = "#weak"
					margin_left = 70
				}

				expand = {}

				text_label_center = {
					text = "KEHILLAH_MAP_VIEW_COL_STANDING"
					default_format = "#weak"
					min_width = 48
				}
				text_label_center = {
					text = "KEHILLAH_MAP_VIEW_COL_P"
					default_format = "#weak"
					min_width = 42
				}
				text_label_center = {
					text = "KEHILLAH_MAP_VIEW_COL_S"
					default_format = "#weak"
					min_width = 42
				}
				text_label_center = {
					text = "KEHILLAH_MAP_VIEW_COL_G"
					default_format = "#weak"
					min_width = 42
				}

				# Spacer matching the locate button's column width.
				widget = { size = { 34 1 } }
			}

			### The roster itself.
			scrollarea = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = growing
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_horizontal = expanding
						set_parent_size_to_minimum = yes
						margin_right = 12
						spacing = 3

						# The mirrored roster, already ordered
						# strongest-standing-first by
						# kehillah_refresh_map_view_effect -- a .gui
						# datamodel cannot sort, so the ordering is done
						# script-side with ordered_in_global_list.
						datamodel = "[GetPlayer.MakeScope.GetList( 'kehillah_map_view_list' )]"

						item = {
							kehillah_map_view_row = {}
						}
					}
				}
			}
		}
	}


	### The toggle -- a map-mode-style round button, parked above
	### vanilla's own map-mode bar in the bottom-right corner.
	flowcontainer = {
		name = "kehillah_map_view_toggle"
		parentanchor = right
		direction = vertical
		ignoreinvisible = yes

		# Hidden entirely when there is nothing to show: no communities
		# mirrored (a non-Kehillah game, or before the game-start refresh
		# has run) means no button. The CFixedPoint comparison against a
		# possibly-absent variable is vanilla's own idiom for exactly
		# this -- gui/shared/mapmodes.gui:105 reads hide_ui_map_zoom the
		# same way, and a variable that does not exist reads as 0.
		visible = "[And( And( IsInGame, GetPlayer.IsValid ), And( IsDefaultGUIMode, GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var( 'kehillah_map_view_count' ).GetValue, '(CFixedPoint)0' ) ) )]"

		background = {
			using = Background_Area_Dark
			color = { 0.15 0.15 0.15 0.75 }
			margin = { 8 6 }
		}

		button_round = {
			name = "kehillah_map_view_button"
			size = { 34 34 }
			parentanchor = hcenter
			onclick = "[GetVariableSystem.Toggle( 'kehillah_map_view_open' )]"
			tooltip = "KEHILLAH_MAP_VIEW_BUTTON_TOOLTIP"
			using = tooltip_ws

			icon = {
				parentanchor = center
				size = { 22 22 }
				texture = "gfx/interface/icons/faith/judaism.dds"
				alwaystransparent = yes
			}
		}
	}
}


types KehillahMapView
{
	### One community.
	#
	# datacontext comes from the roster datamodel above: Scope.Title is
	# the c_kehillah_* community title. Every number on the row is read
	# off that title's own variables, which is where this mod keeps
	# pillar state (see kehillah_quarterly_pillars_effect's "WHY THE
	# TITLE, NOT THE CHARACTER" note).
	type kehillah_map_view_row = hbox {
		datacontext = "[Scope.Title]"
		layoutpolicy_horizontal = expanding
		min_height = 56
		spacing = 6

		tooltip = "KEHILLAH_MAP_VIEW_ROW_TOOLTIP"
		using = tooltip_ws

		background = {
			using = Background_Area_Dark
			color = { 0.18 0.17 0.15 0.55 }
			margin = { 4 2 }
		}

		# The player's own community, marked so the roster reads as
		# "where do I stand" and not just "who exists".
		background = {
			visible = "[Title.GetHolder.IsLocalPlayer]"
			using = Background_Area_Dark
			color = { 0.45 0.38 0.15 0.35 }
			margin = { 4 2 }
		}

		### The leader. portrait_head_tiny's own portrait_button carries
		### vanilla's character-click behaviour, so this doubles as the
		### route to their character panel -- and from there, via their
		### realm flag, to their actual domicile window (the chain
		### docs/spec/spike-domicile-map-visibility.md section 3
		### confirmed live on 2026-09-10).
		widget = {
			size = { 64 56 }
			parentanchor = vcenter
			visible = "[Title.HasHolder]"
			datacontext = "[Title.GetHolder]"

			portrait_head_tiny = {
				parentanchor = center
			}
		}

		### Name, and where in the world it is.
		vbox = {
			layoutpolicy_horizontal = expanding
			parentanchor = vcenter
			spacing = 1

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				text = "[Title.GetNameNoTooltip]"
				default_format = "#high"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left
				text = "KEHILLAH_MAP_VIEW_ROW_LOCATION"
				default_format = "#weak"
			}
		}

		### Standing -- the community's overall figure, and what the
		### roster is ordered on. Emphasised over the three it is made
		### of: this is the column you scan, they are the breakdown. It
		### is the MEAN of the three, not their sum, which is why it sits
		### on the same scale as its neighbours and why the band name in
		### the row tooltip can reuse the pillars' own thresholds -- see
		### kehillah_standing_value.
		text_label_center = {
			parentanchor = vcenter
			min_width = 48
			text = "[Title.MakeScope.Var( 'kehillah_var_standing' ).GetValue|V0]"
			default_format = "#high;bold"
		}

		### The three pillars, in the fixed Prosperity / Stability /
		### Greatness order this mod uses everywhere else.
		text_label_center = {
			parentanchor = vcenter
			min_width = 42
			text = "[Title.MakeScope.Var( 'kehillah_var_prosperity' ).GetValue|V0]"
		}
		text_label_center = {
			parentanchor = vcenter
			min_width = 42
			text = "[Title.MakeScope.Var( 'kehillah_var_stability' ).GetValue|V0]"
		}
		text_label_center = {
			parentanchor = vcenter
			min_width = 42
			text = "[Title.MakeScope.Var( 'kehillah_var_greatness' ).GetValue|V0]"
		}

		### The map half of the map view: put this community on screen.
		#
		# SelectTitle is the engine's own "move the camera to this title
		# and select it" call -- vanilla uses it identically for holy
		# sites at gui/map_icon_layer.gui:751. The county it targets is
		# cached onto the title by kehillah_cache_map_view_facts_effect,
		# because .gui cannot walk holder -> domicile -> location ->
		# county for itself.
		button_round = {
			parentanchor = vcenter
			size = { 30 30 }
			margin_right = 4

			enabled = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.IsValid]"
			onclick = "[Title.MakeScope.Var( 'kehillah_ui_host_county' ).Title.SelectTitle]"
			tooltip = "KEHILLAH_MAP_VIEW_LOCATE_TOOLTIP"
			using = tooltip_ws

			icon = {
				parentanchor = center
				size = { 18 18 }
				texture = "gfx/interface/icons/flat_icons/go_to_my_location.dds"
				alwaystransparent = yes
			}
		}
	}
}
